@@ -0,0 +1,61 @@
+// Host-only present policy. No guest clock, state or audio data lives here.
+#pragma once
+#include <algorithm>
+#include <cstdint>
+
+struct Presentation {
+    enum class Mode { Off, Hidden, Waiting, Recovery, Adaptive, Sync, Unsupported };
+    Mode mode = Mode::Off;
+    int interval = 0;
+    bool supported = true;
+    bool requested = false;
+    unsigned slow = 0, normal = 0;
+    uint64_t retry_at = 0, backoff = 2000000000ULL;
+    uint64_t sync_wait = 0;
+    static constexpr uint64_t slow_ns = 40000000;
+
+    // set_interval returns whether the backend accepts the requested interval.
+    template<class Set> void prepare(bool enabled, bool hidden, bool allow_sync, uint64_t now, Set set_interval) {
+        if (enabled != requested) {
+            supported = true; slow = normal = 0; retry_at = 0; backoff = 2000000000ULL;
+            requested = enabled;
+        }
+        if (enabled && hidden && mode != Mode::Hidden) {
+            retry_at = std::max<uint64_t>(retry_at, now + 500000000ULL);
+            normal = 0;
+        }
+        Mode next = !enabled ? Mode::Off : hidden ? Mode::Hidden : !allow_sync ? Mode::Waiting :
+                    !supported ? Mode::Unsupported : retry_at && (now < retry_at || normal < 30) ? Mode::Recovery : Mode::Sync;
+        if (next == Mode::Sync) {
+            if (!interval) {
+                if (set_interval(-1)) interval = -1;
+                else if (set_interval(1)) interval = 1;
+                else supported = false;
+            }
+            next = !supported ? Mode::Unsupported : interval == -1 ? Mode::Adaptive : Mode::Sync;
+        } else if (interval) { set_interval(0); interval = 0; }
+        mode = next;
+        if (!interval) sync_wait = 0;
+        if (hidden) { normal = slow = 0; }
+    }
+
+    void completed(uint64_t elapsed, uint64_t now) {
+        sync_wait = interval ? elapsed : 0;
+        if (interval) {
+            slow = elapsed > slow_ns ? slow + 1 : 0;
+            if (slow >= 3) {
+                retry_at = now + backoff;
+                backoff = std::min<uint64_t>(backoff * 2, 30000000000ULL);
+                normal = slow = 0;
+            }
+        } else if (mode == Mode::Recovery) {
+            normal = elapsed <= slow_ns ? normal + 1 : 0;
+        }
+    }
+};
+
+// A normal display wait must not trigger frameskip. Credit only the measured
+// last synchronized wait, bounded by one guest field; off retains its old test.
+inline uint64_t presentation_skip_credit(const Presentation& p, uint64_t field_ns) {
+    return std::min(p.sync_wait, field_ns);
+}
