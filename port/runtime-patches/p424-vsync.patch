+            "suspended (network wait / unpaced presentation)", "off (recovering; retry after normal visible presents)",
+            "adaptive", "on", "unavailable (renderer rejected VSync)"};
+        sat_note("display: VSync %s", names[int(g_presentation.mode)]);
+    }
+}
+void host_display_event(const SDL_Event& e) {
+    switch (e.type) {
+    case SDL_EVENT_WINDOW_HIDDEN: case SDL_EVENT_WINDOW_SHOWN:
+    case SDL_EVENT_WINDOW_MINIMIZED: case SDL_EVENT_WINDOW_RESTORED:
+    case SDL_EVENT_WINDOW_OCCLUDED: case SDL_EVENT_WINDOW_EXPOSED:
+        if (g_win && e.window.windowID == SDL_GetWindowID(g_win)) host_display_update(g_present_allow_sync);
+        break;
+    default: break;
+    }
+}
+void host_sdl_present(bool allow_sync) {
+    HostCall in("SDL_RenderPresent");
+    g_present_allow_sync = allow_sync;
+    host_display_update(allow_sync);
+    if (g_presentation.mode == Presentation::Mode::Hidden) return;
+    auto start = present_now();
+    SDL_RenderPresent(g_ren);
+    g_presentation.completed(present_now() - start, present_now());
+    // Switch immediately after the third slow return, before any next draw.
+    host_display_update(allow_sync);
+}
 
