+// All game, menu, launcher and network-wait presents pass through this gate.
+// SDL renderer operations remain on the owning thread. A synchronous driver
+// call cannot be cancelled; slow-return fallback bounds subsequent exposure.
+static uint64_t present_now() {
+    return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now().time_since_epoch()).count());
+}
+void host_display_update(bool allow_sync) {
+    if (!g_ren) return;
+    bool hidden = SDL_GetWindowFlags(g_win) & (SDL_WINDOW_HIDDEN | SDL_WINDOW_MINIMIZED | SDL_WINDOW_OCCLUDED);
+    auto previous = g_presentation.mode;
+    g_presentation.prepare(g_settings.flag("display", "vsync"), hidden, allow_sync, present_now(),
