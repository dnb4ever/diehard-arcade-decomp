+#include "presentation.h"
+#include "pace.h"
+#include "test.h"
+#include <vector>
+
+TEST(present_prefers_adaptive_then_regular_and_does_not_retry_unsupported) {
+    for (int supported : {-1, 1, 0}) {
+        Presentation p; std::vector<int> calls;
+        auto set = [&](int n) { calls.push_back(n); return n == supported; };
+        p.prepare(true, false, true, 0, set);
+        CHECK_EQ(p.interval, supported);
+        CHECK_EQ(calls.size(), supported == -1 ? 1 : 2);
+        p.prepare(true, false, true, 1, set);
+        CHECK_EQ(calls.size(), supported == -1 ? 1 : 2);
+    }
+}
+
+TEST(present_hidden_wait_and_option_off_disable_sync) {
+    Presentation p;
+    auto set = [](int) { return true; };
+    p.prepare(true, false, true, 0, set); CHECK_EQ(p.interval, -1);
+    p.prepare(true, true, true, 1, set); CHECK_EQ(p.interval, 0);
+    CHECK_EQ(p.mode == Presentation::Mode::Hidden, true);
+    p.prepare(true, false, true, 2, set); CHECK_EQ(p.interval, 0);
+    for (int i=0; i<30; ++i) p.completed(1000000, 10000000+i*16666667ULL);
+    p.prepare(true, false, true, 600000000, set); CHECK_EQ(p.interval, -1);
+    p.prepare(true, false, false, 3, set); CHECK_EQ(p.interval, 0);
+    CHECK_EQ(p.mode == Presentation::Mode::Waiting, true);
+    p.prepare(false, false, true, 4, set); CHECK_EQ(p.interval, 0);
+    CHECK_EQ(p.mode == Presentation::Mode::Off, true);
+}
+
+TEST(fake_present_three_consecutive_slow_returns_fall_back_and_retry_after_normal_visible_frames) {
+    Presentation p; uint64_t now = 0;
+    auto set = [](int) { return true; };
+    auto frame = [&](uint64_t elapsed, bool hidden = false) {
+        p.prepare(true, hidden, true, now, set);
+        if (!hidden) p.completed(elapsed, now += elapsed);
+        p.prepare(true, hidden, true, now, set);
+    };
+    frame(41000000); frame(41000000); frame(16000000);
+    CHECK_EQ(p.interval, -1); // A normal return breaks the consecutive run.
+    frame(41000000); frame(41000000); frame(41000000);
+    CHECK_EQ(p.interval, 0);
+    CHECK_EQ(p.mode == Presentation::Mode::Recovery, true);
+    for (int i=0; i<200; ++i) frame(16666667, true);
+    CHECK_EQ(p.interval, 0); CHECK_EQ(p.normal, 0);
+    for (int i=0; i<29; ++i) frame(16666667);
+    CHECK_EQ(p.interval, 0);
+    now = p.retry_at;
+    frame(16666667); CHECK_EQ(p.interval, -1);
+    // Persistent slow VSync retries back off rather than probing every frame.
+    frame(50000000); frame(50000000); frame(50000000);
+    CHECK_EQ(p.interval, 0);
+    CHECK_EQ(p.retry_at - now, 4000000000ULL);
+}
+
+TEST(blocking_present_60hz_has_no_guest_pace_drift_or_frameskip_for_ten_minutes) {
+    using namespace std::chrono;
+    PaceClock::time_point base{}, origin{}, t{};
+    constexpr uint64_t field = 16715000, refresh = 16666667; // ~59.8277 vs 60 Hz
+    Presentation p;
+    auto set = [](int) { return true; };
+    for (uint64_t i=1; i<=36000; ++i) {
+        // Production order: guest work, wants-frame, present, absolute host_pace.
+        t += milliseconds(4);
+        uint64_t guest = i * field;
+        CHECK_EQ(t > base + nanoseconds(guest + field + presentation_skip_credit(p, field)), false);
+        p.prepare(true, false, true, uint64_t(duration_cast<nanoseconds>(t-origin).count()), set);
+        auto before = t;
+        auto ticks = duration_cast<nanoseconds>(t-origin).count() / refresh + 1;
+        t = origin + nanoseconds(ticks * refresh);
+        p.completed(uint64_t(duration_cast<nanoseconds>(t-before).count()), uint64_t(ticks*refresh));
+        t += pace_wait(base, guest, t);
+        CHECK_EQ(base == origin, true);
+        CHECK_EQ(t >= origin + nanoseconds(guest), true);
+        CHECK_EQ(t < origin + nanoseconds(guest + refresh), true);
+    }
+    CHECK_EQ(p.interval, -1);
+    CHECK_EQ(presentation_skip_credit(p, field) <= field, true);
+    p.prepare(false, false, true, 0, set);
+    CHECK_EQ(presentation_skip_credit(p, field), 0);
+}
