+// MAME 0.285 fixtures: full-range RGB555 and compact horizontal/vertical/zoom records.
+TEST(rgb555_back_screen_expands_all_32_levels) {
+    red_screen();
+    reg(0xAC, 0x8002);
+    for (unsigned y = 0; y < 32; ++y) vram16(0x40000 + y * 2, y | y << 5 | y << 10);
+    Frame f;
+    vdp2_compose(f);
+    for (unsigned y = 0; y < 32; ++y) {
+        unsigned c = (y << 3) | (y >> 2);
+        CHECK_EQ(at(f, 0, y), c * 0x010101);
+    }
+}
+
+TEST(rgb555_palette_and_direct_bitmap_use_the_same_full_range) {
+    red_screen();
+    green_bitmap_nbg0();
+    reg(0x20, 0x0101);
+    for (unsigned x = 0; x < 32; ++x) {
+        g_vdp2_vram[x] = x;
+        cram16(x, x | x << 5 | x << 10);
+    }
+    Frame f;
+    vdp2_compose(f);
+    for (unsigned x = 0; x < 32; ++x) {
+        unsigned c = (x << 3) | (x >> 2);
+        CHECK_EQ(at(f, x, 0), c * 0x010101);
+    }
+    reg(0x28, 0x0032);
+    for (unsigned x = 0; x < 32; ++x) vram16(x * 2, 0x8000 | x | x << 5 | x << 10);
+    vdp2_compose(f);
+    for (unsigned x = 0; x < 32; ++x) {
+        unsigned c = (x << 3) | (x >> 2);
+        CHECK_EQ(at(f, x, 0), c * 0x010101);
+    }
+}
+
+namespace {
+void line_bitmap(int n) {
+    red_screen();
+    reg(0x20, (1 << n) | (0x100 << n));
+    reg(0x28, 0x12 << (n * 8));
+    reg(0xF8, 1 << (n * 8));
+    reg(0x78 + n * 0x10, 1);
+    reg(0x7C + n * 0x10, 1);
+    for (unsigned y = 0; y < 256; ++y) for (unsigned x = 0; x < 512; ++x)
+        g_vdp2_vram[y * 512 + x] = ((x / 8 + y / 8) % 31) + 1;
+    for (unsigned i = 0; i < 32; ++i) cram16(i, i | i << 5 | i << 10);
+    reg(0xA0 + n * 4, 2);                       // LSTA0/1, not the vertical-cell address at 0x9C
+}
+void longword(uint32_t a, uint32_t v) { vram16(a, v >> 16); vram16(a + 2, v); }
+}
+
+TEST(nbg0_and_nbg1_read_compact_line_scroll_and_zoom_records) {
+    for (int n = 0; n < 2; ++n) {
+        line_bitmap(n);
+        reg(0x9A, 0x0E << (n * 8));
+        reg(0x70 + n * 0x10, 5);
+        reg(0x74 + n * 0x10, 3);
+        for (unsigned y = 0; y < 240; ++y) {
+            longword(0x40000 + y * 12, (y % 3) * 8 << 16);
+            longword(0x40004 + y * 12, ((y * 8) % 248) << 16);
+            longword(0x40008 + y * 12, y % 2 ? 0x8000 : 0x10000);
+        }
+        Frame f;
+        vdp2_compose(f);
+        CHECK_EQ(at(f, 0, 0), 0x080808);
+        CHECK_EQ(at(f, 8, 1), 0x212121);
+        CHECK_EQ(at(f, 0, 2), 0x292929);
+    }
+}
+
+TEST(line_scroll_interval_advances_within_the_vertical_interval) {
+    line_bitmap(0);
+    reg(0x9A, 0x16);                            // horizontal + vertical, one record per two lines
+    for (unsigned i = 0; i < 120; ++i) {
+        longword(0x40000 + i * 8, 0);
+        longword(0x40004 + i * 8, (i ? 0 : 7) << 16);
+    }
+    Frame f;
+    vdp2_compose(f);
+    CHECK_EQ(at(f, 0, 0), 0x080808);             // source row 7
+    CHECK_EQ(at(f, 0, 1), 0x101010);             // source row 8, not row 7 again
+    CHECK_EQ(at(f, 0, 2), 0x080808);             // next record replaces the source row with 0
+}
