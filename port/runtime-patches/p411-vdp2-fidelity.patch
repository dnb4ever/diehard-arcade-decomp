+// Line records contain only enabled functions, in horizontal/vertical/zoom order.
+// Vertical records replace the first source line of the interval; remaining lines
+// advance normally. Scroll fields are signed 11.8, zoom signed 3.8.
+static Nbg nbg_line(Nbg s, int y) {
+    if (!s.line_flags) return s;
+    unsigned count = !!(s.line_flags & 2) + !!(s.line_flags & 4) + !!(s.line_flags & 8);
+    int line0 = y - y % s.line_interval;
+    uint32_t addr = s.line_table + (uint32_t)(y / s.line_interval) * count * 4;
+    auto read = [&](int bits) {
+        uint32_t value = (uint32_t)vw(addr) << 16 | vw(addr + 2);
+        addr += 4;
+        return signed_bits(value >> 8, bits);
+    };
+    if (s.line_flags & 2) s.sx += read(19);
+    if (s.line_flags & 4) s.sy += read(19) - line0 * s.dy;
+    if (s.line_flags & 8) s.dx = read(11);
+    return s;
+}
