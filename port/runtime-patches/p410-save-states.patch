+    g_quick_request = load ? 2 : 1;
+}
+// Wire values are fixed little endian; device blobs are native to the exact
+// build/ABI fingerprint, checked before any state is applied.
+static void quick_u64(std::vector<uint8_t>& b, uint64_t v) {
+    for (unsigned i = 0; i < 8; ++i) b.push_back((uint8_t)(v >> (8*i)));
+}
+static bool quick_read() {
+    FILE* f = std::fopen(g_quick_path.c_str(), "rb");
+    if (!f) { quick_message("No readable quick save"); return false; }
+    std::fseek(f, 0, SEEK_END); long length = std::ftell(f); std::rewind(f);
+    if (length < 48 || length > 64*1024*1024) { std::fclose(f); quick_message("Rejected truncated/oversized state"); return false; }
+    std::vector<uint8_t> bytes((size_t)length);
+    bool ok = std::fread(bytes.data(), 1, bytes.size(), f) == bytes.size(); std::fclose(f);
+    auto u64 = [&](size_t at) { uint64_t v = 0; for (int i = 7; i >= 0; --i) v = v << 8 | bytes[at+i]; return v; };
+    if (!ok || std::memcmp(bytes.data(), "STVQUICK", 8) || u64(8) != 1 || u64(16) != g_quick_identity ||
+        u64(24) != bytes.size()-48 || u64(32) != quick_hash(bytes.data()+48, bytes.size()-48) ||
+        u64(40) != sizeof(SH2Context)) {
+        quick_message("Rejected stale, incompatible or corrupt state"); return false;
+    }
+    size_t at = 48; g_quick_pending.clear();
+    for (auto& part : kQuickParts) {
+        size_t n = std::strlen(part.name);
+        if (bytes.size()-at < n+8 || std::memcmp(bytes.data()+at, part.name, n)) { ok = false; break; }
+        at += n; uint64_t size = u64(at); at += 8;
+        if (size > bytes.size()-at) { ok = false; break; }
+        g_quick_pending.emplace_back(bytes.begin()+at, bytes.begin()+at+(size_t)size); at += (size_t)size;
+    }
+    if (!ok || at != bytes.size()) { g_quick_pending.clear(); quick_message("Rejected incomplete state parts"); return false; }
+    return true;
+}
+void quick_poll() {
+    if (!quick_available()) return;
+    if (!g_save_triggered && g_cfg.quick_save_at && sat_vblanks() >= g_cfg.quick_save_at) {
+        g_save_triggered = true; quick_request(false);
+    }
+    if (!g_load_triggered && g_cfg.quick_load_at && sat_vblanks() >= g_cfg.quick_load_at) {
+        g_load_triggered = true; quick_request(true);
+    }
+    if (!g_quick_request) return;
+    extern bool arcade_continuation_ready();
+    if (!arcade_continuation_ready()) return;
+    int request = g_quick_request; g_quick_request = 0;
+    if (request == 2) {
+        if (quick_read()) throw QuickLoad{};
+        return;
+    }
+    std::vector<uint8_t> payload;
+    for (auto& part : kQuickParts) {
+        State s; part.fn(s);
+        put(payload, part.name, std::strlen(part.name)); quick_u64(payload, s.data.size());
+        put(payload, s.data.data(), s.data.size());
+    }
+    std::vector<uint8_t> bytes;
+    put(bytes, "STVQUICK", 8); quick_u64(bytes, 1); quick_u64(bytes, g_quick_identity);
+    quick_u64(bytes, payload.size()); quick_u64(bytes, quick_hash(payload.data(), payload.size()));
+    quick_u64(bytes, sizeof(SH2Context)); put(bytes, payload.data(), payload.size());
+    std::error_code e;
+    auto parent = std::filesystem::path(g_quick_path).parent_path();
+    if (!parent.empty()) std::filesystem::create_directories(parent, e);
+    std::string tmp = g_quick_path + ".part";
+    FILE* f = e ? nullptr : std::fopen(tmp.c_str(), "wb");
+    bool ok = f && std::fwrite(bytes.data(), 1, bytes.size(), f) == bytes.size();
+    if (f) ok = std::fclose(f) == 0 && ok;
+    if (ok) std::filesystem::rename(tmp, g_quick_path, e);
+    if (!ok || e) quick_message("Could not write quick save");
+    else {
+        sat_note("quick state: saved VB %llu, %zu bytes", (unsigned long long)sat_vblanks(), bytes.size());
+        quick_message("Quick save complete");
+    }
+}
+bool quick_restore() {
+    if (g_quick_pending.empty() && !quick_read()) return false;
+    // The slave's old frames must unwind before its context and devices change.
+    slave_off();
+    extern void machine_prepare_restore();
+    machine_prepare_restore();
+    for (size_t i = 0; i < g_quick_pending.size(); ++i) {
+        State s; s.loading = true; s.data = std::move(g_quick_pending[i]);
+        kQuickParts[i].fn(s);
+        if (s.pos != s.data.size()) state_fail("quick part layout mismatch");
+    }
+    g_quick_pending.clear();
+    host_quick_reset();
+    sat_note("quick state: loaded VB %llu", (unsigned long long)sat_vblanks());
+    quick_message("Quick save loaded");
+    return true;
+}
+void quick_run_master() {
+    if (!g_quick_resume(g_master, g_master.cont)) sat_fatal("state: master continuation returned");
+}
