+static uint64_t quick_hash(const uint8_t* p, size_t n) {
+    uint64_t h = 14695981039346656037ull;
+    for (size_t i = 0; i < n; ++i) h = (h ^ p[i]) * 1099511628211ull;
+    return h;
+}
+static void quick_message(const std::string& text) {
+    g_quick_message = text;
+    sat_note("quick state: %s", text.c_str());
+}
+const std::string& quick_status() { return g_quick_message; }
+bool quick_available() { return g_cfg.arcade && g_quick_resume; }
+void quick_init(const std::string& path, uint64_t identity, bool (*resume)(SH2Context&, uint32_t)) {
+    g_quick_path = path; g_quick_identity = identity; g_quick_resume = resume;
+    extern void machine_continue_with(bool (*)(SH2Context&, uint32_t));
