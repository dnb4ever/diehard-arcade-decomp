+// ---- ST-V quick slot: complete devices + portable static continuations -----------------------
+// No stack addresses are persisted. Loading throws out the master's C++ frames,
+// resets/unwinds the slave, then dispatches saved generated continuation labels.
+// Normal execution still uses the original calls, branches and poll schedule.
+static std::string g_quick_path, g_quick_message;
+static uint64_t g_quick_identity;
+static int g_quick_request;
+static bool g_save_triggered, g_load_triggered;
+static bool (*g_quick_resume)(SH2Context&, uint32_t);
+static std::vector<std::vector<uint8_t>> g_quick_pending;
+void arcade_scu_state(State&);
+void arcade_sound_state(State&);
+static const struct { const char* name; void (*fn)(State&); } kQuickParts[] = {
+    {"machine", arcade_machine_state}, {"video", video_state}, {"core", core_state},
+    {"mmio", mmio_state}, {"bios", bios_state}, {"stv", arcade_bios_state},
+    {"scu", arcade_scu_state}, {"scudsp", scudsp_state}, {"onchip", onchip_state},
+    {"clock", clock_state}, {"smpc", smpc_state}, {"stv-smpc", arcade_smpc_state},
+    {"cdblock", cdblock_state}, {"cddrive", cddrive_state}, {"cdfs", cdfs_state}, {"cdpos", cdpos_state},
+    {"vdp1", vdp1_state}, {"vdp2", vdp2_state}, {"sound", arcade_sound_state},
+    {"scsp", scsp_state}, {"scspdsp", scspdsp_state},
