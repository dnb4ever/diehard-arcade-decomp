+    std::string path = dir + "/slot";
+    quick_init(path, 42, nullptr);
+    CHECK_EQ(quick_restore(), false); // missing slot
+    for (size_t size : {10u, 64u}) {
+        std::vector<uint8_t> bytes(size);
+        std::memcpy(bytes.data(), "STVQUICK", 8);
+        bytes[8] = 99; // a future version, with no accepted payload
+        std::ofstream f(path, std::ios::binary);
