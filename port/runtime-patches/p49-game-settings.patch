+
+TEST(stv_free_play_matches_mame_panel_without_inventing_credits) {
+    SH2Context c{};
+    c.pr = 0x06005000;
+    st16(0x06000794, 0x1901);  // MAME Coin Assignments FREE PLAY, preset 25.
+    c.r[4] = 0x060F2000;
+    st32(0x060F2014, 0x12345678);
+    CHECK_EQ(bios_call(c, 0x4060), true);
+    const uint8_t mame[] = {0,0,1,2,0,0,0,2,0,0,0,0,0,0,0,0,9,0x11,0,0};
+    for (unsigned i = 0; i < sizeof mame; ++i) CHECK_EQ(ld8(0x060F2000+i), mame[i]);
+    CHECK_EQ(ld32(0x060F2014), 0x12345678);
+    for (int i = 0; i < 100; ++i) {
+        c.r[4] = i & 1;
+        bios_call(c, 0x4064);
+        CHECK_EQ(c.r[0], 1);
+    }
+    st16(0x06000794, 0);
+    c.r[4] = 0;
+    bios_call(c, 0x4064);
+    CHECK_EQ(c.r[0], 0);
+}
