+TEST(stv_soft_dips_reject_out_of_range_values_and_restore_factory_settings) {
+    Settings s;
+    std::vector<std::string> problems;
+    s.read("[stv]\ndifficulty = 9\nvitality = 8\nlives = 0\nfree_play = yes\n", problems);
+    CHECK_EQ(problems.size(), 4);
+    CHECK_EQ(s.number("stv", "difficulty"), 4);
+    CHECK_EQ(s.number("stv", "vitality"), 3);
+    CHECK_EQ(s.number("stv", "lives"), 1);
+    CHECK_EQ(s.flag("stv", "free_play"), false);
+}
