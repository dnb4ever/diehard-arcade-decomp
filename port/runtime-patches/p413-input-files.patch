+// ---- P4.13 input files: final physical panel pins at every VBlank -----------------------------
+// Header and panel records are little endian. Embedded state parts retain the
+// exact-build identity required by P4.10. No native pointers are written.
+static std::vector<uint8_t> movie_meta, movie_state, movie_panels;
+static uint64_t movie_first;
+static bool movie_recording, movie_playing, movie_failed;
+static std::string movie_message;
+const std::string& player_movie_status() { return movie_message; }
+bool player_movie_playing() { return movie_playing; }
+bool player_movie_active() { return movie_playing || movie_recording; }
+static uint64_t movie_u64(const std::vector<uint8_t>& b, size_t at) {
+    uint64_t v = 0; for (int i = 7; i >= 0; --i) v = v << 8 | b[at+i]; return v;
+}
+static bool movie_write() {
+    std::vector<uint8_t> body = movie_meta;
+    put(body, movie_state.data(), movie_state.size()); put(body, movie_panels.data(), movie_panels.size());
+    std::vector<uint8_t> b;
+    put(b, "STVINP13", 8); quick_u64(b, 1); quick_u64(b, g_quick_identity);
+    quick_u64(b, movie_first); quick_u64(b, movie_state.size()); quick_u64(b, movie_panels.size()/6);
+    quick_u64(b, quick_hash(body.data(), body.size())); quick_u64(b, movie_meta.size());
+    put(b, body.data(), body.size());
+    std::error_code error;
+    auto parent = std::filesystem::path(g_cfg.movie_record).parent_path();
+    if (!parent.empty()) std::filesystem::create_directories(parent, error);
+    std::string tmp = g_cfg.movie_record + ".part";
+    FILE* f = error ? nullptr : std::fopen(tmp.c_str(), "wb");
+    bool ok = f && std::fwrite(b.data(), 1, b.size(), f) == b.size();
+    if (f) ok = std::fclose(f) == 0 && ok;
+    if (ok) std::filesystem::rename(tmp, g_cfg.movie_record, error);
+    if (!ok || error) { movie_message = "Input recording: could not write file"; sat_note("%s", movie_message.c_str()); return false; }
+    return true;
+}
+static void movie_pending(const std::vector<uint8_t>& b) {
+    // The file header/checksum and every named part are validated before restore.
+    size_t at = 0; g_quick_pending.clear();
+    for (auto& part : kQuickParts) {
+        size_t n = std::strlen(part.name);
+        if (at > b.size() || b.size()-at < n+8 || std::memcmp(b.data()+at, part.name, n)) throw std::runtime_error("state part name");
+        at += n; uint64_t size = movie_u64(b, at); at += 8;
+        if (size > b.size()-at) throw std::runtime_error("state part size");
+        g_quick_pending.emplace_back(b.begin()+at, b.begin()+at+size); at += size;
+    }
+    if (at != b.size()) throw std::runtime_error("state trailing bytes");
+}
+bool player_movie_open(bool& resumed) {
+    if (g_cfg.movie_record.empty() && g_cfg.movie_play.empty()) return true;
+    if (!g_cfg.movie_record.empty() && !g_cfg.movie_play.empty()) { sat_note("input file: choose recording or replay"); return false; }
+    if (!g_cfg.movie_play.empty()) {
+        FILE* f = std::fopen(g_cfg.movie_play.c_str(), "rb");
+        if (!f) { sat_note("input replay: no readable file %s", g_cfg.movie_play.c_str()); return false; }
+        std::fseek(f, 0, SEEK_END); long size = std::ftell(f); std::rewind(f);
+        if (size < 64 || size > 256*1024*1024) { std::fclose(f); sat_note("input replay: invalid length"); return false; }
+        std::vector<uint8_t> b((size_t)size);
+        bool ok = std::fread(b.data(), 1, b.size(), f) == b.size(); std::fclose(f);
+        uint64_t state_bytes = movie_u64(b, 32), frames = movie_u64(b, 40), meta_bytes = movie_u64(b, 56);
+        if (!ok || std::memcmp(b.data(), "STVINP13", 8) || movie_u64(b, 8) != 1 || movie_u64(b, 16) != g_quick_identity ||
+            meta_bytes != 0x4000+32 || state_bytes > 64*1024*1024 || frames > 32*1024*1024 || !frames ||
+            meta_bytes+state_bytes+frames*6 != b.size()-64 ||
+            movie_u64(b, 48) != quick_hash(b.data()+64, b.size()-64)) {
+            sat_note("input replay: rejected stale, incompatible or corrupt file"); return false;
+        }
+        movie_first = movie_u64(b, 24);
+        if (movie_first > UINT64_MAX-frames || (!state_bytes && movie_first != 0)) { sat_note("input replay: invalid origin"); return false; }
+        movie_meta.assign(b.begin()+64, b.begin()+64+meta_bytes);
+        movie_state.assign(b.begin()+64+meta_bytes, b.begin()+64+meta_bytes+state_bytes);
+        movie_panels.assign(b.begin()+64+meta_bytes+state_bytes, b.end());
+        if (state_bytes) {
+            try { movie_pending(movie_state); }
+            catch (const std::exception& e) { g_quick_pending.clear(); sat_note("input replay: rejected embedded %s", e.what()); return false; }
+            resumed = quick_restore();
+            if (!resumed || sat_vblanks() != movie_first) { sat_note("input replay: embedded origin mismatch"); return false; }
+        } else if (resumed) { sat_note("input replay: power-on recording cannot start from a quick state"); return false; }
+        unsigned flags = unsigned(movie_u64(movie_meta, 0));
+        g_cfg.cheat_health = flags&1; g_cfg.cheat_lives = flags&2; g_cfg.cheat_credits = flags&4;
+        g_cfg.start_scene = int(movie_u64(movie_meta, 8));
+        g_cfg.clock = int64_t(movie_u64(movie_meta, 24));
+        if (!state_bytes) {
+            for (unsigned i = 0; i < 0x4000; ++i) st8(0x06000000+i, movie_meta[32+i]);
+            st32(0x060987CC, uint32_t(movie_u64(movie_meta, 16)));
+        }
+        movie_playing = true; movie_message = "REPLAY INPUTS";
+        uint64_t end = movie_first + frames;
+        if (!g_cfg.stop_vblanks || g_cfg.stop_vblanks > end) g_cfg.stop_vblanks = end;
+        sat_note("input replay: %llu fields from VB %llu, %s", (unsigned long long)frames, (unsigned long long)movie_first, state_bytes ? "embedded state" : "power-on");
+        return true;
+    }
+    movie_first = sat_vblanks();
+    // Freeze the host RTC origin only for an opted-in recording. Replay then
+    // advances it from virtual time, independent of the day or host time zone.
+    if (g_cfg.clock < 0) g_cfg.clock = int64_t(std::time(nullptr)) - int64_t(sat_now()/1000000000);
+    quick_u64(movie_meta, (g_cfg.cheat_health ? 1 : 0) | (g_cfg.cheat_lives ? 2 : 0) | (g_cfg.cheat_credits ? 4 : 0));
+    quick_u64(movie_meta, uint64_t(g_cfg.start_scene)); quick_u64(movie_meta, ld32(0x060987CC));
+    quick_u64(movie_meta, uint64_t(g_cfg.clock));
+    for (unsigned i = 0; i < 0x4000; ++i) movie_meta.push_back(uint8_t(ld8(0x06000000+i)));
+    if (resumed) quick_payload(movie_state);
+    movie_recording = true; movie_message = "RECORDING INPUTS";
+    // Check the destination before allowing play; failures never silently lose a recording.
+    if (!movie_write()) { movie_recording = false; return false; }
+    sat_note("input recording: from VB %llu (%s)", (unsigned long long)movie_first, resumed ? "embedded state" : "power-on");
+    return true;
+}
+void player_movie_panel(uint64_t frame, uint16_t raw[2], uint16_t& system) {
+    if (!movie_recording && !movie_playing) return;
+    // A loaded continuation can finish the field it was saved in without repolling inputs.
+    if (frame <= movie_first) return;
+    uint64_t index = frame-movie_first-1;
+    if (movie_playing) {
+        if (index >= movie_panels.size()/6) sat_stop("input replay complete");
+        size_t at = size_t(index)*6;
+        raw[0] = uint16_t(movie_panels[at] | movie_panels[at+1]<<8);
+        raw[1] = uint16_t(movie_panels[at+2] | movie_panels[at+3]<<8);
+        system = uint16_t(movie_panels[at+4] | movie_panels[at+5]<<8);
+    } else {
+        if (index > movie_panels.size()/6 || index >= 32*1024*1024) {
+            movie_failed = true; movie_recording = false; movie_message = "Recording stopped: incompatible state jump / size limit";
+            sat_note("%s", movie_message.c_str()); return;
+        }
+        // Rewind replaces the abandoned future; repeated physical frames have one final record.
+        movie_panels.resize(size_t(index)*6);
+        for (uint16_t value : {raw[0], raw[1], system}) { movie_panels.push_back(uint8_t(value)); movie_panels.push_back(uint8_t(value>>8)); }
+    }
+}
+bool player_movie_finish() {
+    if (g_cfg.movie_record.empty()) return true;
+    bool ok = movie_write() && !movie_failed;
+    if (ok) sat_note("input recording: wrote %llu fields, %zu bytes", (unsigned long long)(movie_panels.size()/6), 64+movie_meta.size()+movie_state.size()+movie_panels.size());
+    return ok;
+}
