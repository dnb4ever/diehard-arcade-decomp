+// P4.14: presentation buffers must never replace the hardware framebuffer.
+#include "test.h"
+#include "saturn.h"
+#include "video.h"
+#include "state.h"
+#include <algorithm>
+#include <cstring>
+#include <thread>
+
+namespace {
+void word(int a, uint16_t w) { g_vdp1_vram[a] = w >> 8; g_vdp1_vram[a+1] = w; }
+void cmd(int a, int kind, int mode, int color, int x, int y, int x1, int y1) {
+    for (int i=0;i<32;i++) g_vdp1_vram[a+i]=0;
+    word(a,kind);word(a+4,mode);word(a+6,color);
+    word(a+12,x);word(a+14,y);word(a+16,x1);word(a+18,y);
+    word(a+20,x1);word(a+22,y1);word(a+24,x);word(a+26,y1);
+}
+void setup(int scale) {
+    g_cfg.internal_resolution=scale;
+    vdp1_reg_write(0,0,2);vdp1_reg_write(2,0,2);vdp1_reg_write(4,0,2);
+    vdp1_reg_write(6,0,2);vdp1_reg_write(8,0,2);vdp1_reg_write(10,(64<<9)|255,2);
+    // Erase both buffers and show a clean one.
+    for(int i=0;i<3;i++) vdp1_vblank_out();
+    cmd(0,9,0,0,0,0,511,255);
+    cmd(32,10,0,0,0,0,0,0);
+    cmd(64,4,0,0x801f,10,10,20,20);
+    word(96,0x8000);
+}
+struct Restore {
+    State saved; int scale=g_cfg.internal_resolution;
+    Restore() {vdp1_state(saved);}
+    ~Restore() {saved.loading=true;vdp1_state(saved);g_cfg.internal_resolution=scale;}
+};
+}
+
+TEST(hires_hardware_authority_and_inclusive_clipping) {
+    Restore restore;
+    std::vector<uint32_t> reference;
+    for(int scale=1;scale<=3;scale++) {
+        setup(scale);
+        // System clip through x=18, inclusive; user clip outside x=12..14.
+        word(20,18);cmd(32,8,0,0,12,0,14,255);
+        word(68,0x600);
+        vdp1_reg_write(4,1,2);
+        std::vector<uint32_t> hw;
+        for(int i=0;i<512*256;i++) hw.push_back(vdp1_fb_read(i*2,2));
+        if(scale==1) reference=hw; else CHECK_EQ(hw==reference,true);
+        vdp1_vblank_out();
+        for(int x=9*scale;x<22*scale;x++) {
+            int ox=x/scale;
+            CHECK_EQ(vdp1_present_dot(x,10*scale,false,scale),ox>=10 && ox<=18 && !(ox>=12 && ox<=14)?0x801f:0);
+        }
+    }
+}
+
+TEST(hires_cpu_writes_and_erase_mirror_both_palette_bytes) {
+    Restore restore;
+    for(int scale=2;scale<=3;scale++) {
+        setup(scale);vdp1_reg_write(0,1,2);
+        vdp1_fb_write(0,0x12345678,4);vdp1_fb_write(1,0x9a,1);
+        CHECK_EQ(vdp1_fb_read(0,4),0x129a5678);
+        vdp1_vblank_out();
+        for(int x=0;x<4*scale;x++) CHECK_EQ(vdp1_present_dot(x,0,false,scale),(0x129a5678u >> ((3-x/scale)*8))&255);
+        vdp1_reg_write(6,0xabcd,2);vdp1_vblank_out();vdp1_vblank_out();
+        CHECK_EQ(vdp1_present_dot(0,0,false,scale),0xab);
+        CHECK_EQ(vdp1_present_dot(scale,0,false,scale),0xcd);
+    }
+}
+
+TEST(hires_snapshot_restores_display_without_replaying_texture_ram) {
+    Restore restore;
+    setup(3);vdp1_reg_write(4,1,2);vdp1_vblank_out();
+    State image;vdp1_state(image);
+    std::memset(g_vdp1_vram,0xff,sizeof g_vdp1_vram);
+    g_cfg.internal_resolution=1;vdp1_present_sync();
+    image.loading=true;vdp1_state(image);
+    g_cfg.internal_resolution=3;vdp1_present_sync();
+    CHECK_EQ(vdp1_present_dot(45,45,false,3),0x801f);
+    CHECK_EQ(vdp1_present_dot(29,45,false,3),0);
+    // Switching resolution resamples saved presentation data, never the current command list.
+    g_cfg.internal_resolution=2;vdp1_present_sync();
+    CHECK_EQ(vdp1_present_dot(30,30,false,2),0x801f);
+}
+
+TEST(hires_end_codes_count_texels_instead_of_repeated_samples) {
+    Restore restore;
+    setup(3);
+    cmd(64,2,0x20,0,10,10,40,20);word(72,0x100);word(74,0x108);
+    for(int y=0;y<8;y++) for(int x=0;x<8;x++) g_vdp1_vram[0x800+y*8+x]=x==1||x==6?255:x+1;
+    vdp1_reg_write(4,1,2);vdp1_vblank_out();
+    CHECK_EQ(vdp1_present_dot(65,30,false,3)!=0,true); // past first repeated end texel
+    CHECK_EQ(vdp1_present_dot(120,30,false,3),0);       // past second end texel
+}
+
+TEST(hires_normal_sprite_mesh_and_rgb_calculation_keep_original_cells) {
+    Restore restore;
+    setup(2);
+    cmd(64,0,0x168,0,10,10,0,0); // RGB texture, SPD/ECD/mesh
+    word(72,0x100);word(74,0x108);
+    for(int i=0;i<64;i++) word(0x800+i*2,0xffff);
+    vdp1_reg_write(4,1,2);vdp1_vblank_out();
+    for(int y=20;y<24;y++) for(int x=20;x<24;x++)
+        CHECK_EQ(vdp1_present_dot(x,y,false,2),((x/2 ^ y/2)&1)?0:0xffff);
+}
+
+TEST(hires_rgb_shadow_transparency_luminance_and_gouraud) {
+    Restore restore;
+    for(int scale : {2,3}) for(int mode=0;mode<4;++mode) {
+        setup(scale);
+        cmd(96,4,mode,0xfc00,10,10,20,20);word(128,0x8000);
+        vdp1_reg_write(4,1,2);vdp1_vblank_out();
+        const uint16_t expected[]={0xfc00,0x800f,0xbc00,0xbc0f};
+        CHECK_EQ(vdp1_present_dot(15*scale,15*scale,false,scale),expected[mode]);
+    }
+    setup(3);
+    // A constant Gouraud table adds 15 red levels to black.
+    cmd(96,4,4,0x8000,10,10,20,20);word(124,0x200);word(128,0x8000);
+    for(int i=0;i<4;++i) word(0x1000+i*2,0x421f);
+    vdp1_reg_write(4,1,2);vdp1_vblank_out();
+    CHECK_EQ(vdp1_present_dot(45,45,false,3),0x800f);
+}
+
+TEST(hires_adjacent_sloping_quads_cover_shared_edges) {
+    Restore restore;
+    for(int scale : {2,3}) {
+        setup(scale);
+        // Two strips share a sloping edge and cover this entire interior rectangle.
+        cmd(64,4,0,0x801f,10,10,40,40);
+        word(84,30);word(86,40);word(88,10);word(90,40);
+        cmd(96,4,0,0x83e0,40,10,60,40);
+        word(120,30);word(122,40);word(128,0x8000);
+        vdp1_reg_write(4,1,2);vdp1_vblank_out();
+        for(int y=11*scale;y<40*scale;++y) for(int x=11*scale;x<60*scale;++x)
+            CHECK_EQ(vdp1_present_dot(x,y,false,scale)!=0,true);
+    }
+}
+
+TEST(hires_interlace_cpu_writes_preserve_the_displayed_full_height_copy) {
+    Restore restore;
+    setup(2);vdp1_reg_write(2,8,2);vdp1_reg_write(4,1,2);
+    vdp1_fb_write((15*512+15)*2,0xffff,2);
+    vdp1_vblank_out();
+    CHECK_EQ(vdp1_present_dot(30,30,true,2),0x801f);
+    // With a non-interlaced VDP2 display, authoritative compressed hardware dots win.
+    CHECK_EQ(vdp1_present_dot(30,30,false,2),vdp1_dot(15,15,false));
+}
+
+
+TEST(hires_hardware_draw_state_is_shared_across_both_cpu_threads) {
+    Restore restore;
+    for(int scale : {1,2,3}) {
+        setup(scale);
+        word(20,18); // the first draw installs a persistent system clip
