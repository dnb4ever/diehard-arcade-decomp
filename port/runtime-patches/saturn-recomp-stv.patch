+// ---- the ST-V control-panel BIOS service (real body) ----------------------------------
+// Die Hard Arcade (ST-V) has no SMPC-pad input path; it delegates its per-frame
+// coin / start / control read to an ST-V BIOS service at 0x06000660(buf). On real
+// hardware the BIOS fills `buf` (the game passes 0x060987D8) with the decoded
+// control-panel report. With no ST-V BIOS ROM the harness used to no-op the whole
+// 0x06000600 service window, so the buffer was never filled and the game could never
+// register a coin/start -> it sat in the attract/coin-wait fixed point forever (the
+// "round-start freeze"; see notes/port/spawn_diagnosis.md and stv_input_gameplay_status.md).
+//
+// Report byte layout, decoded from how the game CONSUMES the buffer (boot config
+// func_0201b92 @cart 0x0201b92 == runtime 0x06005b92, and the live coin-wait handler
+// @runtime 0x060089b8 that runs every frame during the freeze):
+//   buf[0x10] : status byte.  bit0 = no-data/invalid (set -> the game ignores the read),
+//               bit2 = 2-player control panel present.
+//   buf[0x03] : P1 action code (small enum). 2 == START/join. The handler does
+//               dispatch[buf[3]] through the RAM jump table at 0x06090304, and the
+//               boot config treats buf[3]==2 as "P1 start/present".
+//   buf[0x07] : P2 action code (buf+4 is the P2 record; +3 == buf[7]). 2 == START/join.
+// (The cooked direction/button bitmask the gameplay code reads lives separately at the
+//  0x060987BC work word; its exact bit map is not needed to deliver coin/start and is
+//  left idle here -- documented as the remaining unknown.)
+//
+// An all-zero report is a valid "no activity" read (bit0 clear), identical to the
+// zero-initialised baseline the game already tolerated; the one thing that was missing
+// was ever delivering a start. stv_input_script() drives buf[3]/buf[7]=2 as 1-VBlank
+// press pulses at scripted VBlanks.
+// kind: 1=START1 2=START2 3=COIN1 4=COIN2 5=SERVICE 6=P1 face/dir press 7=P2 face/dir press.
+// START/COIN are delivered faithfully through the game's own consumers (panel action codes /
+// coin-pending). SERVICE and the P1/P2 face/direction tokens exist so a --stvinput timeline can
+// *express* full ST-V control-panel state (the task's "carry buttons/directions"); their runtime
+// effect is bounded by what is actually decodable here -- see stv_panel_read and the notes file
+// notes/port/stv_panel_input_status.md for exactly which panel bits are verified vs unmapped.
+struct StvEvent { uint64_t vb; int kind; bool fired; };
+static std::vector<StvEvent> g_stv_events;
+
+void stv_input_script(const std::string& spec) {
+    g_stv_events.clear();
+    size_t i = 0;
+    while (i < spec.size()) {
+        size_t j = spec.find(',', i);
+        std::string item = spec.substr(i, j == std::string::npos ? std::string::npos : j - i);
+        i = (j == std::string::npos) ? spec.size() : j + 1;
+        size_t c = item.find(':');
+        if (c == std::string::npos) continue;
+        uint64_t vb = strtoull(item.c_str(), nullptr, 10);
+        std::string tok = item.substr(c + 1);
+        int kind = tok == "START1" || tok == "START" ? 1 : tok == "START2" ? 2
+                 : tok == "COIN" || tok == "COIN1"   ? 3 : tok == "COIN2"  ? 4
+                 : tok == "SERVICE" || tok == "SVC"  ? 5 : 0;
+        // P1/P2 face-button + direction tokens: "P1A".."P1C","P1UP".."P1RIGHT" (and P2*), or a bare
+        // face/dir token (defaults to P1). These are grouped to a single per-player "press" event
+        // because only the cooked "a-control-is-pressed" bit is verified decodable (see panel read).
+        if (!kind) {
+            const char* t = tok.c_str();
+            int player = 0;
+            if (tok.size() >= 2 && t[0] == 'P' && (t[1] == '1' || t[1] == '2')) { player = t[1] - '1'; t += 2; }
+            std::string b(t);
+            if (b == "A" || b == "B" || b == "C" || b == "X" || b == "Y" || b == "Z" ||
+                b == "UP" || b == "DOWN" || b == "LEFT" || b == "RIGHT")
+                kind = player == 0 ? 6 : 7;
+        }
+        if (kind) g_stv_events.push_back({vb, kind, false});
+    }
+    sat_note("ST-V input script: %zu events", g_stv_events.size());
+}
+
+// ---- the coin / credit path -----------------------------------------------------------
+// How a coin becomes a credit in this game (all traced from the game's own code):
+//   1. The ST-V BIOS coin-input service *0x06000664(player) reports a coin on a slot
+//      (r4=0 P1, r4=1 P2). The game's coin-detect fn @runtime 0x060065f0 polls it and,
+//      on a coin, raises the coin-pending flag 0x0609880C (word, =1).
+//   2. The game's credit-accrual fn @0x060045f8 (called every frame from the attract
+//      handler fn 06008868) gates on 0x0609880C==1 && 0x0609880E==1, then increments the
+//      credit byte 0x06098674, updates the BIOS coin meter via *0x06000640, and clears
+//      the pending flag. Credit display and the attract->play (START on the credit>0
+//      branch of the coin-wait handler @0x060089b8) are then the game's own logic.
+//
+// REACHABILITY NOTE (honest): in the attract sub-state the boot-shortcut harness lands in,
+// only 0x610/0x660/0x668 are polled per frame -- the coin-detect fn 0x060065f0 (and with it
+// the 0x664 read) is NOT scheduled (it belongs to the title/insert-coin state a fuller boot
+// would reach). So the 0x664 service below is implemented faithfully but is currently never
+// called. To actually deliver a coin we therefore raise the coin-pending flag 0x0609880C
+// directly (deliver_coin), i.e. we substitute ONLY the unrun hardware coin-switch -> 0x880C
+// detect step; everything downstream (accrual, meter, display, play-mode transition) is the
+// game's real code. If a future fuller boot reaches the 0x664-polling state, drop the direct
+// 0x880C raise in stv_panel_read to avoid double-crediting.
+static void deliver_coin(int player) {
+    // Faithful to the real coin-detect fn @runtime 0x060065f0 (cart 0x20faf8). That routine raises
+    // the per-slot coin-pending flag ONLY when (a) the pending flag is not already set and (b) the
+    // per-slot credit byte (0x06098674 P1 / 0x06098675 P2) is 0 or 3. The harness substitutes the
+    // unrun coin-switch -> pending-flag step, so it must apply the SAME gate. The old code latched
+    // 0x0609880C unconditionally (and, bug, used 0x0609880C for BOTH players): a 2nd coin re-raised
+    // the pending flag in a credit state the real coin-detect never would, corrupting the credit/
+    // arm bookkeeping and permanently parking the attract reel (2P-armed flag 0x06098670 held = 1).
+    // With the gate, each coin accrues one credit and the attract reel self-recovers (the game's own
+    // scene-81 reset-timeout clears 0x06098670 and the reel cascades) -- the faithful behaviour.
+    uint32_t pend   = player == 0 ? 0x0609880Cu : 0x06098810u;
+    uint32_t credit = player == 0 ? 0x06098674u : 0x06098675u;
+    uint8_t cb = (uint8_t)ld8(credit);
+    if (ld16(pend) == 0 && (cb == 0 || cb == 3)) {
+        st16(pend, 1);
+        sat_note("ST-V coin: P%d coin -> coin-pending 0x%08X=1 at VB %llu (game accrues the credit)",
+                 player + 1, pend, (unsigned long long)sat_vblanks());
+    } else {
+        sat_note("ST-V coin: P%d coin ignored by coin-detect gate (credit byte=%u, pending=%u) at VB %llu",
+                 player + 1, cb, (unsigned)ld16(pend), (unsigned long long)sat_vblanks());
+    }
+}
+
+// The ST-V BIOS coin-input read service body (0x06000664). Faithful but currently unreached
+// (see note above). Reports a scripted coin on the given slot for a short window.
+static int stv_coin_read(int player) {
+    int want = player == 0 ? 3 : 4;
+    uint64_t vb = sat_vblanks();
+    for (StvEvent& e : g_stv_events)
+        if (e.kind == want && vb >= e.vb && vb < e.vb + 2) return 1;
+    return 0;
+}
+
+// Fill the panel report at `buf` with the current control-panel state. Called from the
+// 0x06000660 service every frame. Writes a full zeroed report (so a one-frame press
+// pulse releases on the next frame -> a clean rising edge), then stamps any scripted
+// event active on this VBlank.
+// Scene-director probe driver (diagnostic, default off). Called EVERY frame from video.cpp's
+// vblank_in -- the ST-V panel service (stv_panel_read) is NOT scheduled once the game-enter
+// scenes run, so the scene walk must be driven from the always-on VBlank tick, not the panel
+// read. Purpose: LOCATE which setup scene (73-80) installs the player spawn-script. STV_SCENEJUMP
+// forces the hardcoded game scene 81 via the unk13<0 lever and SKIPS the setup scenes; these
+// knobs instead drop the scene-director onto / step it through a chosen scene index so each setup
+// scene's per-frame setup runs. The director reads the active scene from g_06098668 (index) +
+// g_0609866c (descriptor = 0x06072660 + idx*0x50) and, on each advance (director-entity->unk3c
+// bit0 set), runs the game-enter install block for idx>=76. All default-off => byte-identical.
+//   STV_SCENESEED="vb:idx"        ONCE at VB>=vb: g_06098668=idx, g_0609866c=desc(idx)
+//   STV_SCENEADV ="vb:count:intv" from VB>=vb, every intv frames, force 1 director advance, count times
+//   STV_SCENEPIN ="idx"           every frame: pin g_06098668=idx, g_0609866c=desc(idx)
+//   STV_SCENEJOIN="startvb"       from VB>=startvb: g_06098674=g_06098675=2 (scene-73 branch -> 74)
+//   STV_SCENECHAR="v"             every frame: g_0609856c=v (scene-75 branch -> 76 + (v&3))
+void stv_scene_probe_tick(uint64_t vb) {
+    static const char* e_seed = std::getenv("STV_SCENESEED");
+    static const char* e_adv  = std::getenv("STV_SCENEADV");
+    static const char* e_pin  = std::getenv("STV_SCENEPIN");
+    static const char* e_join = std::getenv("STV_SCENEJOIN");
+    static const char* e_char = std::getenv("STV_SCENECHAR");
+    static const char* e_gate = std::getenv("STV_SCENEGATE");  // from VB>=val: 0x06098798 |= 0x30 (open scene-81 START gate)
+    // STV_STARTENABLE: faithful BIOS-start-enable synthesis (default off => byte-identical).
+    // FINDING (this session): NO cart code anywhere sets bits 4/5 of the cooked control word
+    // 0x06098798 (= field +4 of struct 0x06098794). A full multi-base dataflow scan of the whole
+    // 2MB program (every pool literal in 0x06098758..0x0609879c, incl. the panel-buffer base
+    // 0x060987D8 and r0-indexed stores) found exactly ONE store to 0x06098798 in the image: a
+    // clear-to-0 at rt 0x06005580 (fn rt 0x060071c4, a boot/HW-ready routine; it writes r14, and
+    // r14==0 from the fn prologue `mov #0,r14` at cart 0x22013c6). Every other reference is a READ.
+    // So bits 4/5 (P1/P2 start-enable) are a SYSTEM/BIOS-provided status the game only consumes --
+    // there is no in-cart panel->cooked decoder for them. With no real ST-V BIOS, the harness must
+    // synthesize this signal, exactly as it already synthesizes the 0x06000660 panel service /
+    // 0x060987D8 buffer. Faithful condition: start is enabled when a credit is present
+    // (credit counter 0x06098674 > 0), mirroring real-arcade start-enable logic.
+    static const char* e_senable = std::getenv("STV_STARTENABLE");
+    // STV_SPAWNPLAYER ("vb[:type]", default off): DIAGNOSTIC round-swing experiment. Once at VB>=vb,
+    // synthesize a 24-byte spawn-descriptor (type 1 = P1 player; see notes/port/round_spawn_experiment.md)
+    // plus a minimal cfg record + context, and run it through the GAME'S OWN process_spawn_list
+    // (rt 0x0602E5D0) via sh2_call on the master, with full context save/restore. The descriptor/cfg
+    // are SYNTHESIZED; the registrar, slot pool and actor-entry func_0222a300 are the real game code.
+    static const char* e_spawn = std::getenv("STV_SPAWNPLAYER");
+    // STV_SPAWNJOIN (default off): after a successful STV_SPAWNPLAYER, FORCE the spawned actor into the
+    // player-join STATE to test the downstream chain. Sets task handler=func_022863e (player main state),
+    // entity->unk43=0x1D (table 0x06091100 index of player_join_arm), entity->unk54|=2 (ready), and
+    // g_0609978c[idx-1]=1 (commit on first cycle). These fields are FORCED (synthetic) -- the real game
+    // sets them from the credit-join trigger, which is not yet located; everything each state then runs is
+    // real game code. See notes/port/round_spawn_experiment.md.
+    static const char* e_joinforce = std::getenv("STV_SPAWNJOIN");
+    // STV_SM81DIAG (diagnostic, default off): when the active scene (g_06098668) == target (default 81),
+    // every N frames (default 30) walk the active object list (sentinel 0x06092244, linked via node->unk4)
+    // and dump each node: handler/def (node->unk0), entity (node->unk8), state byte (node->unk10), and the
+    // entity's recoil/busy fields unk3c / unk50 / unk34(s16). Pure read-only observation of the scene-81
+    // intro state machine and its spawned recoil objects. Format "STV_SM81DIAG=target[:intv]".
+    static const char* e_diag = std::getenv("STV_SM81DIAG");
+    if (e_diag) {
+        static bool dparsed = false; static uint32_t dtarget = 81, dintv = 30;
+        if (!dparsed) { dtarget = (uint32_t)std::strtoul(e_diag, nullptr, 0);
+            const char* dc = std::strchr(e_diag, ':'); if (dc) dintv = (uint32_t)std::strtoul(dc + 1, nullptr, 0);
+            if (dintv == 0) dintv = 1; dparsed = true; }
+        if (ld32(0x06098668u) == dtarget && (vb % dintv) == 0) {
+            sat_note("SM81DIAG VB %llu scene=%u ---- active object list ----", (unsigned long long)vb, dtarget);
+            uint32_t node = ld32(0x06092244u + 4u);
+            for (int i = 0; i < 48 && node && node != 0x06092244u && (node >> 24) == 0x06; ++i) {
+                uint32_t hdl = ld32(node + 0u);
+                uint32_t ent = ld32(node + 8u);
+                uint32_t st  = ld8(node + 0x10u);
+                uint32_t f3c = ent ? ld32(ent + 0x3Cu) : 0u;
+                uint32_t sp  = ent ? ld32(ent + 0x50u) : 0u;
+                int32_t  r34 = ent ? (int32_t)(int16_t)ld16(ent + 0x34u) : 0;
+                uint32_t ph  = ld8(node + 0x10u); (void)ph;
+                // The scene-81 game SM (scene81_game_sm) runs as a node here; its task fields
+                // task->unk30/34/38/3A/3C ARE the stage-setup config that scene81_stage_setup gates
+                // on (ctx->unk30 bit0). Dumping them shows whether the stage finalize body runs or
+                // early-returns: unk30 bit0 clear / unk3C null => finalize skipped => RBG0 stale.
+                uint32_t u30 = ld32(node + 0x30u), u34 = ld32(node + 0x34u), u38 = ld32(node + 0x38u);
+                int32_t  u3a = (int32_t)(int16_t)ld16(node + 0x3Au);
+                uint32_t u3c = ld32(node + 0x3Cu);
+                sat_note("  node=%08X hdl=%08X ent=%08X st=%u ent.3c=%08X ent.50=%d ent.34=%d | ctx.30=%08X .34=%08X .38=%08X .3a=%d .3c=%08X",
+                         node, hdl, ent, st, f3c, (int32_t)sp, r34, u30, u34, u38, u3a, u3c);
+                node = ld32(node + 4u);
+            }
+            // Stage-finalize evidence: scene81_stage_setup sets these when its body runs.
+            //   0x06098690/94 = "already loaded" bundle cache (layer A/B); nonzero => body ran.
+            //   0x060BACAC/B0/B4 = plane-built flags set at the end of the finalize body.
+            sat_note("  STAGE markers: loadedA=%08X loadedB=%08X builtA=%08X builtB=%08X pal=%08X",
+                     ld32(0x06098690u), ld32(0x06098694u), ld32(0x060BACACu), ld32(0x060BACB0u), ld32(0x060BACB4u));
+        }
+    }
+    if (!(e_seed || e_adv || e_pin || e_join || e_char || e_gate || e_senable || e_spawn || e_joinforce || e_diag)) return;  // default off: no effect
+    auto scn_desc = [](uint32_t idx) -> uint32_t { return 0x06072660u + idx * 0x50u; };
+    if (e_join) {
+        uint64_t jat = (uint64_t)std::strtoull(e_join, nullptr, 10);
+        if (vb >= jat) { st8(0x06098674u, 2); st8(0x06098675u, 2); }  // "1" = from boot
+    }
+    if (e_char) st32(0x0609856Cu, (uint32_t)std::strtoul(e_char, nullptr, 0));
+    if (e_gate) {
+        uint64_t gat = (uint64_t)std::strtoull(e_gate, nullptr, 10);
+        if (vb >= gat) st16(0x06098798u, (uint16_t)(ld16(0x06098798u) | 0x30u));  // bits4/5: enable panel poll + START accept (scene 81)
+    }
+    if (e_senable) {
+        // Faithful start-enable: set cooked bits 4/5 only while a credit is present. This runs every
+        // frame after the game's own clear (rt 0x06005580 / per-frame reset), so the enable persists
+        // like the real BIOS status would. Threshold VB optional ("STV_STARTENABLE=vb"; default 0).
+        uint64_t sat = (uint64_t)std::strtoull(e_senable, nullptr, 10);
+        if (vb >= sat && ld8(0x06098674u) > 0) {
+            st16(0x06098798u, (uint16_t)(ld16(0x06098798u) | 0x30u));
+        }
+    }
+    if (e_seed) {
+        static bool parsed = false, done = false;
+        static uint64_t at = 0; static uint32_t idx = 81;
+        if (!parsed) { const char* c = std::strchr(e_seed, ':');
+            at = (uint64_t)std::strtoull(e_seed, nullptr, 10);
+            if (c) idx = (uint32_t)std::strtoul(c + 1, nullptr, 10); parsed = true; }
+        if (!done && vb >= at) {
+            st32(0x06098668u, idx); st32(0x0609866Cu, scn_desc(idx)); done = true;
+            sat_note("STV_SCENESEED: g_06098668=%u g_0609866c=%08X at VB %llu",
+                     idx, scn_desc(idx), (unsigned long long)vb);
+        }
+    }
+    if (e_adv) {
+        static bool parsed = false;
+        static uint64_t at = 0, intv = 60; static uint32_t left = 1; static uint64_t next_fire = 0;
+        if (!parsed) { at = (uint64_t)std::strtoull(e_adv, nullptr, 10);
+            const char* c1 = std::strchr(e_adv, ':');
+            if (c1) { left = (uint32_t)std::strtoul(c1 + 1, nullptr, 10);
+                const char* c2 = std::strchr(c1 + 1, ':');
+                if (c2) intv = (uint64_t)std::strtoull(c2 + 1, nullptr, 10); }
+            next_fire = at; parsed = true; }
+        if (left > 0 && vb >= next_fire) {
+            uint32_t task = ld32(0x060987B8u);
+            uint32_t ent = task ? ld32(task + 0x8u) : 0;
+            if (ent) { st32(ent + 0x3Cu, ld32(ent + 0x3Cu) | 1u); left--; next_fire = vb + intv;
+                sat_note("STV_SCENEADV: forced advance (entity %08X), %u left, next VB %llu, at VB %llu",
+                         ent, left, (unsigned long long)next_fire, (unsigned long long)vb); }
+        }
+    }
+    if (e_pin) {
+        uint32_t idx = (uint32_t)std::strtoul(e_pin, nullptr, 10);
+        st32(0x06098668u, idx); st32(0x0609866Cu, scn_desc(idx));
+    }
+    if (e_spawn) {
+        static bool parsed = false, done = false, busy = false;
+        static uint64_t at = 0; static uint32_t ptype = 1; static uint32_t rcfg = 0;
+        if (busy) return;                               // re-entrancy guard
+        if (!parsed) {
+            at = (uint64_t)std::strtoull(e_spawn, nullptr, 10);
+            const char* cc = std::strchr(e_spawn, ':');
+            if (cc) { ptype = (uint32_t)std::strtoul(cc + 1, nullptr, 0);
+                const char* c2 = std::strchr(cc + 1, ':');
+                if (c2) rcfg = (uint32_t)std::strtoul(c2 + 1, nullptr, 0); }
+            parsed = true;
+        }
+        if (!done && vb >= at) {
+            done = true;
+            const uint32_t SCR = 0x060FA000u;
+            bool clean = true;
+            for (uint32_t i = 0; i < 0x100; i += 4) if (ld32(SCR + i) != 0) { clean = false; break; }
+            if (!clean) {
+                sat_note("STV_SPAWNPLAYER: scratch %08X not clean (first nonzero word %08X) -- aborting (no spawn)",
+                         SCR, ld32(SCR));
+            } else {
+                const uint32_t CTX = SCR + 0x00u, DESC = SCR + 0x40u, TERM = SCR + 0x58u, CFG = SCR + 0x80u;
+                // cfg: 8-byte anim-script record. cfg[4]=0 => no match key (func_0222a418 stays benign),
+                // cfg[6]=0xffff => func_0222a300 skips the unk26 write; cfg[2]=2 countdown; cfg[0]=0 anim id.
+                st16(CFG + 0, 0); st16(CFG + 2, 2); st16(CFG + 4, 0); st16(CFG + 6, 0xffff);
+                // 24-byte descriptor. desc[0]=type (1=P1 -> func_02227bc4 -> entity->unk34=1 -> player gate).
+                st8(DESC + 0, (uint8_t)ptype); st8(DESC + 1, 0); st8(DESC + 2, 0); st8(DESC + 3, 0);
+                st32(DESC + 4, 0);            // hi16 -> entity->unk98 (unused unless unk6d set)
+                st32(DESC + 8, 0);            // -> entity->unk8
+                st32(DESC + 12, 0);           // -> entity->unk0c
+                st32(DESC + 16, 0);           // -> entity->unk10
+                st32(DESC + 20, rcfg ? rcfg : CFG);  // -> entity->unk d0 (cfg ptr); real ROM cfg if given
+                for (uint32_t i = 0; i < 24; i += 4) st32(TERM + i, 0);   // terminator desc (next+4==0, next+20==0)
+                st32(CTX + 0x30u, DESC);      // process_spawn_list reads arg0->unk30 as the descriptor list
+                uint32_t cnt0  = ld32(0x0609958Cu);
+                uint32_t fp0   = ld32(0x060911B4u);
+                uint32_t slot0 = ld32(0x06099590u + 1u * 4u);
+                sat_note("STV_SPAWNPLAYER: type=%u cfg=%08X(%s) desc=%08X ctx=%08X slotcount=%u animfp[0]=%08X slot[1]=%08X at VB %llu",
+                         ptype, rcfg ? rcfg : CFG, rcfg ? "real" : "synth", DESC, CTX, cnt0, fp0, slot0, (unsigned long long)vb);
+                busy = true;
+                SH2Context& c = g_master;
+                SH2Context save = c;
+                c.r[4] = CTX; c.pr = kRet; c.pc = 0; c.budget = 0x40000000;
+                sh2_call(c, 0x0602E5D0u);     // the game's own process_spawn_list
+                bool ok = (c.pc == kRet);
+                uint32_t cnt1   = ld32(0x0609958Cu);
+                uint32_t slot1  = ld32(0x06099590u + 1u * 4u);
+                uint32_t task1  = ld32(0x060995B0u + 1u * 4u);
