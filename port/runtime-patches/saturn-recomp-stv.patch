+static void setup_rbg(Rbg& s) {
+    s = Rbg{};
+    uint16_t bgon = reg(0x20);
+    s.on = bgon >> 4 & 1;                        // R0ON
+    if (!s.on) return;
+    s.opaque = bgon >> 12 & 1;                   // R0TPON
+    uint16_t chb = reg(0x2A);
+    s.cell2x2 = chb >> 8 & 1;                    // R0CHSZ
+    s.bitmap  = chb >> 9 & 1;                    // R0BMEN
+    int bmsz  = chb >> 10 & 3;                   // R0BMSZ
+    s.colors  = chb >> 12 & 7;                   // R0CHCN
+    s.bm_w = bmsz & 2 ? 1024 : 512;
+    s.bm_h = bmsz & 1 ? 512 : 256;
+    uint16_t pncr = reg(0x38);
+    s.word1 = pncr >> 15 & 1;
+    s.cnsm = pncr >> 14 & 1;
+    s.supp = pncr & 0x3FF;
+    int plsz = reg(0x3A) >> 8 & 3;              // RAPLSZ
+    s.plane_w = plsz == 0 ? 1 : 2;
+    s.plane_h = plsz == 3 ? 2 : 1;
+    s.over = reg(0x3A) >> 10 & 3;              // RAOVR screen-over process
+    s.page_bytes = (s.cell2x2 ? 0x800u : 0x2000u) * (s.word1 ? 1 : 2);
+    uint32_t mpofr = reg(0x3E) & 7;            // RAMPOF
+    uint32_t mask = (uint32_t)(s.plane_w * s.plane_h - 1);
+    // the 16 plane numbers: MPABRA..MPOPRA (0x48..0x56), each word = two bytes (low byte first,
+    // as the scroll-screen map registers), A..P.
+    for (int i = 0; i < 16; ++i) {
+        uint16_t w = reg(0x48 + (i / 2) * 2);
+        uint32_t pn = w >> ((i & 1) * 8) & 0xFF;
+        uint32_t m = ((mpofr << 6) | pn) & ~mask;
+        s.plane[i] = m * s.page_bytes;
+    }
+    if (s.bitmap) s.bm_addr = mpofr * 0x20000;
+    s.caos = (uint32_t)(reg(0xE6) & 7) << 8;    // CRAOFB R0 colour RAM offset
+    s.prio = (uint8_t)(reg(0xFC) & 7);          // PRIR
+    s.ratio = (uint8_t)(reg(0x10C) & 0x1F);     // CCRR
+    s.cc = reg(0xEC) >> 4 & 1;                   // CCCTL R0CCEN
+    s.offset = reg(0x110) >> 4 & 1;
+    s.offset_b = reg(0x112) >> 4 & 1;
+
+    // RBG0 uses the rotation parameter set RPMD names (A, B, or A with per-dot/window switching).
+    int rpmd = reg(0xB0) & 3;                    // 0:A 1:B 2/3:per-coefficient/window (A used; partial)
+    read_rot_param(s, rpmd == 1 ? 0x80u : 0u, rpmd == 1 ? 4 : 0);
+
+    // DIAGNOSTIC (STV_RBG_DIAG, default off): dump the finalized RBG0 register state so the
+    // scene-81 "why is the floor black" question can be answered from the actual plane map /
+    // rotation camera / coefficient-table values the game programmed. Interval in vblanks
+    // ("STV_RBG_DIAG=1" => every 300). Observation only; byte-identical when unset.
+    if (const char* de = std::getenv("STV_RBG_DIAG")) {
+        uint32_t intv = (uint32_t)std::strtoul(de, nullptr, 0); if (intv < 2) intv = 300;
+        if ((sat_vblanks() % intv) == 0) {
+            sat_note("RBG_DIAG VB %llu BGON=%04X R0ON=%d rpmd=%d plsz=%dx%d over=%d col=%d c2x2=%d w1=%d mpof=%u",
+                     (unsigned long long)sat_vblanks(), reg(0x20), s.on, rpmd, s.plane_w, s.plane_h,
+                     s.over, s.colors, s.cell2x2, s.word1, (unsigned)(reg(0x3E) & 7));
+            sat_note("  plane[0..7]  =%06X %06X %06X %06X %06X %06X %06X %06X",
+                     s.plane[0], s.plane[1], s.plane[2], s.plane[3], s.plane[4], s.plane[5], s.plane[6], s.plane[7]);
+            sat_note("  plane[8..15] =%06X %06X %06X %06X %06X %06X %06X %06X",
+                     s.plane[8], s.plane[9], s.plane[10], s.plane[11], s.plane[12], s.plane[13], s.plane[14], s.plane[15]);
+            sat_note("  Mx=%.2f My=%.2f Xp=%.2f Yp=%.2f A=%.4f B=%.4f D=%.4f E=%.4f Xst=%.2f Yst=%.2f",
+                     s.Mx, s.My, s.Xp, s.Yp, s.A, s.B, s.D, s.E, s.Xst, s.Yst);
+            sat_note("  KTCTL=%04X kt_en=%d kt_mode=%d kt_1w=%d kt_base=%05X KAst=%.3f dKAst=%.5f dKAx=%.5f caos=%u prio=%u",
+                     reg(0xB4), s.kt_enable, s.kt_mode, s.kt_1word, s.kt_base, s.KAst, s.dKAst, s.dKAx, s.caos, s.prio);
+        }
+    }
+}
+
+// RBG1: the second rotation background. It occupies NBG0's slot -- reusing NBG0's character control
+// (CHCTLA), pattern name (PNCN0), bitmap palette (BMPNA), colour-RAM offset (CRAOFA N0), priority
+// (PRINA N0), colour-calculation (CCRNA N0, CCCTL N0CCEN) and colour-offset (N0) registers -- but it
+// is a rotation screen: it always uses rotation parameter set B, with parameter-B plane size
+// (RBPLSZ), map offset (RBMPOF) and the 16-plane map MPABRB..MPOPRB. R1ON (BGON bit5) turns it on
+// and R1TPON (bit13) makes it opaque. RBG1 and NBG0 are mutually exclusive on the hardware; when it
+// is on, NBG0 is suppressed (in vdp2_compose). The rotation maths and the cell/bitmap lookup are the
+// same as RBG0's -- rbg_pixel/rbg_coef operate on the shared Rbg struct, so they are reused as is.
+static void setup_rbg1(Rbg& s) {
+    s = Rbg{};
+    uint16_t bgon = reg(0x20);
+    s.on = bgon >> 5 & 1;                        // R1ON
+    if (!s.on) return;
+    s.opaque = bgon >> 13 & 1;                   // R1TPON
+    uint16_t cha = reg(0x28);                    // CHCTLA (NBG0 fields)
+    s.colors  = cha >> 4 & 7;                    // N0CHCN
+    s.bitmap  = cha >> 1 & 1;                    // N0BMEN
+    s.cell2x2 = cha & 1;                         // N0CHSZ
+    int bmsz  = cha >> 2 & 3;                    // N0BMSZ
+    s.bm_w = bmsz & 2 ? 1024 : 512;
+    s.bm_h = bmsz & 1 ? 512 : 256;
+    uint16_t pncn0 = reg(0x30);                  // PNCN0
+    s.word1 = pncn0 >> 15 & 1;
+    s.cnsm = pncn0 >> 14 & 1;
+    s.supp = pncn0 & 0x3FF;
+    int plsz = reg(0x3A) >> 12 & 3;             // RBPLSZ (parameter B plane size)
+    s.plane_w = plsz == 0 ? 1 : 2;
+    s.plane_h = plsz == 3 ? 2 : 1;
+    s.over = reg(0x3A) >> 14 & 3;              // RBOVR screen-over process
+    s.page_bytes = (s.cell2x2 ? 0x800u : 0x2000u) * (s.word1 ? 1 : 2);
+    uint32_t mpofr = reg(0x3E) >> 4 & 7;        // RBMPOF (parameter B map offset)
+    uint32_t mask = (uint32_t)(s.plane_w * s.plane_h - 1);
+    // parameter B's 16 plane numbers: MPABRB..MPOPRB (0x58..0x66), low byte first, A..P
+    for (int i = 0; i < 16; ++i) {
+        uint16_t w = reg(0x58 + (i / 2) * 2);
+        uint32_t pn = w >> ((i & 1) * 8) & 0xFF;
+        uint32_t m = ((mpofr << 6) | pn) & ~mask;
+        s.plane[i] = m * s.page_bytes;
+    }
+    if (s.bitmap) {
+        s.bm_addr = mpofr * 0x20000;
+        uint16_t bmpn = reg(0x2C);               // BMPNA (NBG0 fields)
+        s.bm_pal = (uint16_t)((bmpn & 7) << 4);
+        s.bm_spr = bmpn >> 5 & 1;
+        s.bm_scc = bmpn >> 4 & 1;
+    }
+    s.caos = (uint32_t)(reg(0xE4) & 7) << 8;    // CRAOFA N0 colour RAM offset
+    s.prio = (uint8_t)(reg(0xF8) & 7);          // PRINA N0
+    s.ratio = (uint8_t)(reg(0x108) & 0x1F);     // CCRNA N0
+    s.cc = reg(0xEC) & 1;                         // CCCTL N0CCEN
+    s.offset = reg(0x110) & 1;                    // CLOFEN N0
+    s.offset_b = reg(0x112) & 1;                  // CLOFSL N0
+    read_rot_param(s, 0x80u, 4);                  // RBG1 always uses parameter set B
+}
+
+// the coefficient at table-entry index k: returns false (transparent, line not drawn) when the
+// entry's top bit is set; otherwise sets kv to the Kx/Ky factor.
+static bool rbg_coef(const Rbg& s, double kaddr, double& kv) {
+    if (!s.kt_enable) { kv = 1.0; return true; }
+    uint32_t idx = (uint32_t)(int32_t)kaddr;
+    if (s.kt_1word) {
+        uint32_t a = (s.kt_base + idx * 2) & 0x7FFFE;
+        uint16_t w = vw(a);
+        if (w & 0x8000) return false;
+        int32_t v = (w & 0x4000) ? (int32_t)(w | 0xFFFF8000u) : (w & 0x7FFF);
+        kv = (double)v / 1024.0;                 // 1.6.? 1-word coefficient: 10-ish frac
+    } else {
+        uint32_t a = (s.kt_base + idx * 4) & 0x7FFFC;
+        uint32_t w = (uint32_t)vw(a) << 16 | vw(a + 2);
+        if (w & 0x80000000u) return false;
+        int32_t v = (w & 0x00800000u) ? (int32_t)(w | 0xFF000000u) : (int32_t)(w & 0x00FFFFFF);
+        kv = (double)v / 65536.0;                // 2-word coefficient: 16 frac
+    }
+    return true;
+}
+
+// RBG0's dot at display column x, line y: false if transparent / off the map.
+static bool rbg_pixel(const Rbg& s, int x, int y, Pix& p) {
+    // the screen-space pre-transform at this line, and the per-dot increments (through the matrix)
+    double Xstv = s.Xst + s.dXst * y, Ystv = s.Yst + s.dYst * y;
+    double Xsp = s.A * (Xstv - s.Px) + s.B * (Ystv - s.Py) + s.C * (s.Zst - s.Pz);
+    double Ysp = s.D * (Xstv - s.Px) + s.E * (Ystv - s.Py) + s.F * (s.Zst - s.Pz);
+    double dXd = s.A * s.dX + s.B * s.dY, dYd = s.D * s.dX + s.E * s.dY;
+    double kx = 1.0, ky = 1.0;
+    if (s.kt_enable) {
+        double kaddr = s.KAst + s.dKAst * y + s.dKAx * x;
+        double kv;
+        if (!rbg_coef(s, kaddr, kv)) return false;
+        // mode 0: Kx=Ky; 1: Kx only; 2: Ky only; 3: Kx=Ky (data may carry line colour -- partial)
+        if (s.kt_mode == 0 || s.kt_mode == 3) kx = ky = kv;
+        else if (s.kt_mode == 1) kx = kv;
+        else ky = kv;
+    }
+    double X = kx * (Xsp + dXd * x) + s.Xp;
+    double Y = ky * (Ysp + dYd * x) + s.Yp;
+
+    if (s.bitmap) {                              // bitmap-mode rotation BG: partial (repeat-wrap only)
+        int fbx = (int)std::floor(X), fby = (int)std::floor(Y);
+        if (s.over == 2) { if (fbx < 0 || fbx >= s.bm_w || fby < 0 || fby >= s.bm_h) return false; }
+        else if (s.over == 3) { if ((unsigned)fbx >= 512u || (unsigned)fby >= 512u) return false; }
+        int bx = fbx % s.bm_w, by = fby % s.bm_h;
+        if (bx < 0) bx += s.bm_w;
+        if (by < 0) by += s.bm_h;
+        p.spr = s.bm_spr; p.scc = s.bm_scc;
+        return dot(s, s.bm_addr, bx, by, s.bm_w, s.bm_pal, p);
+    }
+    int map_w = 4 * s.plane_w * 512, map_h = 4 * s.plane_h * 512;
+    int fX = (int)std::floor(X), fY = (int)std::floor(Y);
+    // screen-over process: 2 = transparent outside the map, 3 = only a 512x512 area shows (outside
+    // transparent). 0 = repeat (wrap), 1 = over-pattern (not wired; falls back to repeat). Without this
+    // a rotation BG whose coordinates leave the map wraps and samples unrelated VRAM as garbage.
+    if (s.over == 2) { if (fX < 0 || fX >= map_w || fY < 0 || fY >= map_h) return false; }
+    else if (s.over == 3) { if ((unsigned)fX >= 512u || (unsigned)fY >= 512u) return false; }
+    int ix = fX % map_w, iy = fY % map_h;
+    if (ix < 0) ix += map_w;
+    if (iy < 0) iy += map_h;
+    uint32_t plane_px = (uint32_t)s.plane_w * 512, plane_py = (uint32_t)s.plane_h * 512;
+    int slot = (iy / (int)plane_py) * 4 + ix / (int)plane_px;
+    uint32_t planebase = s.plane[slot];
+    uint32_t lx = (uint32_t)ix % plane_px, ly = (uint32_t)iy % plane_py;
+    uint32_t page = (ly / 512) * (uint32_t)s.plane_w + lx / 512;
+    int cs = s.cell2x2 ? 16 : 8;
+    uint32_t cx = (lx % 512) / (uint32_t)cs, cy = (ly % 512) / (uint32_t)cs;
+    uint32_t cpr = 512 / (uint32_t)cs;
+    uint32_t pnd_addr = planebase + page * s.page_bytes + (cy * cpr + cx) * (s.word1 ? 2 : 4);
+    uint32_t chr, pal;
+    bool hf, vf;
+    if (s.word1) {
+        uint16_t w = vw(pnd_addr);
+        p.spr = s.supp >> 9 & 1;
+        p.scc = s.supp >> 8 & 1;
+        pal = s.colors == 0 ? (uint32_t)(w >> 12 & 0xF) | (s.supp >> 1 & 0x70) : (uint32_t)(w >> 8 & 0x70);
+        if (!s.cnsm) {
+            hf = w & 0x400; vf = w & 0x800;
+            chr = s.cell2x2 ? ((w & 0x3FFu) << 2) | (s.supp & 3u) | ((s.supp & 0x1Cu) << 10)
+                            : (w & 0x3FFu) | ((s.supp & 0x1Fu) << 10);
+        } else {
+            hf = vf = false;
+            chr = s.cell2x2 ? ((w & 0xFFFu) << 2) | (s.supp & 3u) | ((s.supp & 0x10u) << 10)
+                            : (w & 0xFFFu) | ((s.supp & 0x1Cu) << 10);
+        }
+    } else {
+        uint16_t w0 = vw(pnd_addr), w1 = vw(pnd_addr + 2);
+        hf = w0 & 0x4000; vf = w0 & 0x8000;
+        p.spr = w0 >> 13 & 1;
+        p.scc = w0 >> 12 & 1;
+        pal = w0 & 0x7F;
+        chr = w1 & 0x7FFF;
+    }
+    int px = (int)(lx % (uint32_t)cs), py = (int)(ly % (uint32_t)cs);
+    if (hf) px = cs - 1 - px;
+    if (vf) py = cs - 1 - py;
+    static const uint32_t kCellBytes[] = {32, 64, 128, 128, 256};
+    uint32_t base = chr * 0x20;
+    if (s.cell2x2) base += (uint32_t)((py >> 3) * 2 + (px >> 3)) * kCellBytes[s.colors];
+    return dot(s, base, px & 7, py & 7, 8, pal, p);
+}
