+    // scene-director task (*0x060987B8) picks the active scene in scene_director_build (cart
+    // 0x02205b20); when its task->unk13 (byte at +0xd) is negative it forces g_06098668=81 and
+    // g_0609866c=0x06073fb0 (the GAME scene descriptor, table base 0x06072660 + 81*0x50) at the
+    // NEXT natural scene advance, running the scene-81 setup (off14=0x0600a876) that is supposed to
+    // install the game spawn-script (-> player actor 0x0602Dxxx -> start-flag 0x06098688 -> morph).
+    // This sets that exact field once at VB=STV_SCENEJUMP -- the real round-start lever into the
+    // scene director -- NOT a force-write of 0x06098688. Default off => byte-identical baseline.
+    static const char* scenejump = std::getenv("STV_SCENEJUMP");
+    if (scenejump) {
