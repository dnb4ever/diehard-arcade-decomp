+            else if (e.kind == 4) deliver_coin(1);         // P2 coin
+            else if (e.kind == 5)                          // SERVICE: expressible; 0x688 svc is inert here
+                sat_note("ST-V panel: SERVICE at VB %llu (expressed; BIOS 0x688 service inert)",
+                         (unsigned long long)vb);
+            else if (e.kind == 6 || e.kind == 7)
