+    s.Xst  = sfix(0x00, 0x1FFFFFC0, 28); s.Yst = sfix(0x04, 0x1FFFFFC0, 28); s.Zst = sfix(0x08, 0x1FFFFFC0, 28);
+    s.dXst = sfix(0x0C, 0x0003FFC0, 17); s.dYst = sfix(0x10, 0x0003FFC0, 17);
+    s.dX   = sfix(0x14, 0x0003FFC0, 17); s.dY   = sfix(0x18, 0x0003FFC0, 17);
+    s.A = sfix(0x1C, 0x000FFFFF, 19); s.B = sfix(0x20, 0x000FFFFF, 19); s.C = sfix(0x24, 0x000FFFFF, 19);
+    s.D = sfix(0x28, 0x000FFFFF, 19); s.E = sfix(0x2C, 0x000FFFFF, 19); s.F = sfix(0x30, 0x000FFFFF, 19);
+    s.Px = s16(0x34); s.Py = s16(0x36); s.Pz = s16(0x38);
+    s.Cx = s16(0x3C); s.Cy = s16(0x3E); s.Cz = s16(0x40);
+    s.Mx = sfix(0x44, 0x3FFFFFC0, 29); s.My = sfix(0x48, 0x3FFFFFC0, 29);
+    s.kx = sfix(0x4C, 0x00FFFFFF, 23); s.ky = sfix(0x50, 0x00FFFFFF, 23);
+    // the constant screen offset (manual's Xp/Yp)
+    s.Xp = s.A * (s.Px - s.Cx) + s.B * (s.Py - s.Cy) + s.C * (s.Pz - s.Cz) + s.Cx + s.Mx;
+    s.Yp = s.D * (s.Px - s.Cx) + s.E * (s.Py - s.Cy) + s.F * (s.Pz - s.Cz) + s.Cy + s.My;
+    // DIAGNOSTIC (STV_RBG_XOFF/YOFF, default off): forcibly offset the rotation-BG screen origin.
+    // Used ONLY to prove the RBG tile data is loaded and the renderer draws it when the camera is
+    // pointed at the populated plane -- the game's own camera (My) is stale in the not-yet-live round.
+    if (const char* yo = std::getenv("STV_RBG_YOFF")) s.Yp -= std::atof(yo);
+    if (const char* xo = std::getenv("STV_RBG_XOFF")) s.Xp -= std::atof(xo);
+    // DIAGNOSTIC (STV_RBG_MY/MX, default off): override the rotation-BG viewpoint centre My/Mx
+    // and recompute the constant screen offset. Unlike YOFF/XOFF (which hack the final Yp/Xp),
+    // this replaces the stale per-frame camera value the live-round stage-scroll driver would
+    // write, so the game's OWN finalized plane map is sampled at a chosen camera. Forced, not
+    // faithful: the real value is gameplay-driven and absent without a live round.
+    if (const char* my = std::getenv("STV_RBG_MY")) {
+        s.My = std::atof(my);
+        s.Yp = s.D * (s.Px - s.Cx) + s.E * (s.Py - s.Cy) + s.F * (s.Pz - s.Cz) + s.Cy + s.My;
+    }
+    if (const char* mx = std::getenv("STV_RBG_MX")) {
+        s.Mx = std::atof(mx);
+        s.Xp = s.A * (s.Px - s.Cx) + s.B * (s.Py - s.Cy) + s.C * (s.Pz - s.Cz) + s.Cx + s.Mx;
+    }
+    // coefficient table: KTCTL bit0 enable, bits1-2 mode, bit3 data size (0:2-word,1:1-word)
+    uint16_t ktctl = reg(0xB4);
+    s.kt_enable = ktctl >> coef_shift & 1;
+    s.kt_mode = ktctl >> (coef_shift + 1) & 3;
+    s.kt_1word = ktctl >> (coef_shift + 3) & 1;
+    // KAst 1.15.10, deltas 1.9.10 (address steps). Keep the table-entry units (1 entry = 1 coeff).
+    s.KAst  = (double)(int32_t)(raw(0x54) & 0xFFFFFFC0) / 65536.0;
+    s.dKAst = sfix(0x58, 0x03FFFFC0, 25);
+    s.dKAx  = sfix(0x5C, 0x03FFFFC0, 25);
+    // DIAGNOSTIC (STV_RBG_KAST, default off): override the coefficient-table START index. The
+    // live round's stage-camera writes a small in-table KAst each frame; without it the value is
+    // stale (observed 31872, far outside the real table) so every sampled coefficient is garbage.
+    if (const char* ka = std::getenv("STV_RBG_KAST")) s.KAst = std::atof(ka);
+    uint32_t ktaof = reg(0xB6) >> coef_shift & 7;           // coefficient table address offset
+    s.kt_base = (ktaof << 16) & 0x7FFFF;
+    if (std::getenv("STV_RBG_FLATK")) s.kt_enable = false;  // diag: force Kx=Ky=1
+}
