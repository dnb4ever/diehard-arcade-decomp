+static void stv_panel_read(uint32_t buf) {
+    if (!buf) return;
+    for (uint32_t i = 0; i < 0x20; ++i) st8(buf + i, 0);   // valid idle (bit0 of buf[0x10] clear)
+    uint64_t vb = sat_vblanks();
