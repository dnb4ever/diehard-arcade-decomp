+// A synchronous band job: video memories and the caller's lambda stay alive
+// until every worker completes. Workers sleep between fields; no guest work
+// overlaps composition. Reuse their native stacks instead of creating seven
+// threads for each picture.
+#pragma once
+#include <algorithm>
+#include <condition_variable>
+#include <exception>
+#include <functional>
+#include <mutex>
+#include <thread>
+#include <vector>
+#include <utility>
+
+class VideoBandPool {
+    std::mutex mutex_;
+    std::condition_variable start_, done_;
+    std::vector<std::thread> workers_;
+    std::function<void(int,int)> job_;
+    std::exception_ptr error_;
+    unsigned generation_ = 0;
+    int height_ = 0, pending_ = 0;
+    bool stopping_ = false;
+    void work(int band, int bands) {
+        unsigned seen = 0;
+        std::unique_lock lock(mutex_);
+        for (;;) {
+            start_.wait(lock,[&] { return stopping_ || generation_ != seen; });
+            if(stopping_) return;
+            seen=generation_;int height=height_;
+            auto job=job_; // each band owns the mutable line/back-colour state
+            lock.unlock();
+            std::exception_ptr error;
+            try { job(height*band/bands,height*(band+1)/bands); } catch(...) { error=std::current_exception(); }
+            lock.lock();
+            if(error) error_=error;
+            if(--pending_==0) done_.notify_one();
+        }
+    }
+public:
+    VideoBandPool() {
+        int bands=std::clamp((int)std::thread::hardware_concurrency(),1,8);
+        for(int band=1;band<bands;++band) workers_.emplace_back([this,band,bands] { work(band,bands); });
+    }
+    ~VideoBandPool() {
+        { std::lock_guard lock(mutex_);stopping_=true; }
+        start_.notify_all();for(auto& t:workers_) t.join();
+    }
+    template<class Fn> void run(int height, Fn&& job) {
+        int bands=(int)workers_.size()+1;
+        {
+            std::lock_guard lock(mutex_);
+            job_=std::forward<Fn>(job);height_=height;pending_=bands-1;error_=nullptr;++generation_;
+        }
+        start_.notify_all();
+        std::exception_ptr error;
+        auto caller_job=job;
+        try { caller_job(0,height/bands); } catch(...) { error=std::current_exception(); }
+        std::unique_lock lock(mutex_);done_.wait(lock,[&] { return pending_==0; });
+        job_={};if(!error) error=error_;lock.unlock();if(error) std::rethrow_exception(error);
+    }
+};
