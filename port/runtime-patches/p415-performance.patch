+// Opt-in host profiling. No counters or clocks enter serialized guest state.
+#pragma once
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstdint>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#else
+#include <time.h>
+#endif
+namespace sat_perf {
+enum Part { Master, Slave, SyncMaster, SyncSlave, Vdp1, Vdp1Worker, Vdp2, Vdp2Worker, Audio, Present, Other, Count };
+inline const bool enabled = std::getenv("SATURN_PROFILE") != nullptr;
+inline std::array<std::atomic<uint64_t>, Count> cpu{}, elapsed{}, calls{};
+inline uint64_t cpu_now() {
+#ifdef _WIN32
+    FILETIME a,b,k,u; GetThreadTimes(GetCurrentThread(), &a,&b,&k,&u);
+    ULARGE_INTEGER x{},y{}; x.LowPart=k.dwLowDateTime; x.HighPart=k.dwHighDateTime;
+    y.LowPart=u.dwLowDateTime; y.HighPart=u.dwHighDateTime; return (x.QuadPart+y.QuadPart)*100;
+#else
+    timespec t{}; clock_gettime(CLOCK_THREAD_CPUTIME_ID,&t); return uint64_t(t.tv_sec)*1000000000+t.tv_nsec;
+#endif
+}
+inline uint64_t wall_now() { return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count(); }
+inline thread_local Part current=Other;
+inline thread_local uint64_t last_cpu=0, last_wall=0;
+inline void change(Part next) {
+    if (!enabled) return;
+    auto c=cpu_now(),w=wall_now();
+    if(last_cpu) { cpu[current].fetch_add(c-last_cpu,std::memory_order_relaxed); elapsed[current].fetch_add(w-last_wall,std::memory_order_relaxed); }
+    last_cpu=c; last_wall=w; current=next;
+    calls[next].fetch_add(1,std::memory_order_relaxed);
+}
+struct Scope {
+    Part previous;
+    explicit Scope(Part next):previous(current) { change(next); }
+    ~Scope() { change(previous); }
+};
+inline void report(uint64_t fields) {
+    if (!enabled) return;
+    change(current);
+    static const char* names[]={"master","slave","sync-master","sync-slave","vdp1","vdp1-workers","vdp2","vdp2-workers","audio","present","other"};
+    for(int i=0;i<Count;++i) std::fprintf(stderr,"PERF fields=%llu part=%s cpu_ns=%llu elapsed_ns=%llu calls=%llu\n",(unsigned long long)fields,names[i],(unsigned long long)cpu[i].load(),(unsigned long long)elapsed[i].load(),(unsigned long long)calls[i].load());
+}
+}
