+// Compare batching against the guest loop's actual instruction order, up to
+// the next poll, for every possible poll phase and a wrapping guest counter.
+#include "test.h"
+#include "saturn.h"
+#include <cstring>
+
+static int empty_until_poll(SH2Context& c, bool batch) {
+    for (;;) {
+        if (batch) sh2_stv_idle_batch(c);
+        c.r[13]=ld32(c.r[12]); c.r[13]+=c.r[14]; c.r[13]=ld32(c.r[13]);
+        c.t=(c.r[13]==0);
+        if (!c.t) return -1; // not an empty command
+        c.r[4]=c.r[9];c.r[2]=ld32(c.r[11]);++c.r[2];st32(c.r[11],c.r[2]);
+        for (;;) {
+            c.r[4]-=2;c.t=(c.r[4]==0);
+            if(c.t) break;
+            if(--c.budget<0) return 71;
+        }
+        c.r[0]=0x060E0DD4u;c.r[3]=ld32(c.r[0]+c.r[14]);c.r[2]=ld32(c.r[12]);c.t=c.r[2]==c.r[3];
+        if(!c.t) { if(--c.budget<0) return 72; continue; }
+        st8(c.r[8],c.r[10]);if(--c.budget<0) return 73;
+    }
+}
+TEST(empty_slave_batch_preserves_every_poll_phase_and_guest_counter) {
+    g_cfg.trace=false;g_sh2_watch_len=0;
+    for(int budget=0;budget<=257;++budget) {
+        SH2Context seed{};seed.cpu=1;seed.budget=budget;
+        for(int i=0;i<16;++i) seed.r[i]=0x12340000u+i;
+        seed.r[8]=0x060E0DD8u;seed.r[9]=10;seed.r[10]=0xFFFFFF80u;
+        seed.r[11]=0x060987C4u;seed.r[12]=0x060E0DD0u;seed.r[14]=0x20000000u;
+        auto init=[] { st32(0x060E0DD0u,0x060E0BD0u);st32(0x060E0DD4u,0x060E0BD0u);st32(0x060E0BD0u,0);st32(0x060987C4u,0xfffffff0u);st8(0x060E0DD8u,0x12); };
+        init();auto ref=seed;int phase=empty_until_poll(ref,false);
+        uint32_t counter=ld32(0x060987C4u);uint8_t flag=ld8(0x060E0DD8u);
+        init();auto fast=seed;CHECK_EQ(empty_until_poll(fast,true),phase);
+        CHECK_EQ(std::memcmp(&ref,&fast,sizeof ref),0);
+        CHECK_EQ(ld32(0x060987C4u),counter);CHECK_EQ(ld8(0x060E0DD8u),flag);
+    }
+}
+TEST(empty_slave_batch_rejects_work_and_observable_stores) {
+    SH2Context c{};c.cpu=1;c.budget=256;c.r[8]=0x060E0DD8u;c.r[9]=10;c.r[10]=0xFFFFFF80u;c.r[11]=0x060987C4u;c.r[12]=0x060E0DD0u;c.r[14]=0x20000000u;
+    st32(0x060E0DD0u,0x060E0BD0u);st32(0x060E0DD4u,0x060E0BD0u);st32(0x060E0BD0u,1);
+    auto original=c;sh2_stv_idle_batch(c);CHECK_EQ(std::memcmp(&original,&c,sizeof c),0);
+    st32(0x060E0BD0u,0);g_sh2_watch_len=4;sh2_stv_idle_batch(c);CHECK_EQ(c.budget,256);g_sh2_watch_len=0;
+    g_cfg.trace=true;sh2_stv_idle_batch(c);CHECK_EQ(c.budget,256);g_cfg.trace=false;
+    st32(0x060E0DD4u,0x060E0BD4u);sh2_stv_idle_batch(c);CHECK_EQ(c.budget,256);
+}
