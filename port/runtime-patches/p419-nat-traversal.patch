+TEST(connection_code_round_trip_checksum_limits_and_fingerprint) {
+    Code c{0x123456789abcdef0,0x10203040,{{0xc0a80104,7845},{0xcb007109,40000},{0x7f000001,12345},{0xc0000201,65535}}};
+    auto text=encode_code(c); CHECK_EQ(text.size()<=64,true); Code decoded; std::string error;
+    CHECK_EQ(decode_code(text,decoded,error),true); CHECK_EQ(decoded.nonce,c.nonce); CHECK_EQ(decoded.build,c.build); CHECK_EQ(decoded.candidates==c.candidates,true);
+    for(size_t i=5;i<text.size();++i) { auto wrong=text; wrong[i]=wrong[i]=='A'?'B':'A'; CHECK_EQ(decode_code(wrong,decoded,error),false); }
+    CHECK_EQ(decode_code(" \n"+text+"\r\n",decoded,error),true); CHECK_EQ(decode_code(text+"A",decoded,error),false);
+    c.candidates.push_back({1,1}); CHECK_EQ(encode_code(c).empty(),true);
+}
+TEST(punch_validates_both_nonces_build_reply_and_checksum) {
+    Code a{1,123,{{0x7f000001,10001}}},b{2,123,{{0x7f000001,10002}}}; bool reply;
+    auto packet=punch_packet(a,b,false); CHECK_EQ(punch_packet_valid(packet,b,a,reply),true); CHECK_EQ(reply,false);
+    CHECK_EQ(punch_packet_valid(packet,a,b,reply),false);
+    packet=punch_packet(a,b,true); CHECK_EQ(punch_packet_valid(packet,b,a,reply),true); CHECK_EQ(reply,true);
+    for(size_t i=0;i<packet.size();++i) { auto wrong=packet; wrong[i]^=1; CHECK_EQ(punch_packet_valid(wrong,b,a,reply),false); }
+    a.build++; CHECK_EQ(punch_packet_valid(packet,b,a,reply),false);
+    b.build++; CHECK_EQ(punch_packet_valid(packet,b,a,reply),false);
+}
