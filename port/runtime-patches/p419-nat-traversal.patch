+Endpoint resolve(const std::string& name,int timeout_ms,const std::atomic<bool>* cancel) {
+    Endpoint numeric; if(parse(name,numeric)) return numeric;
+    auto colon=name.rfind(':'); if(colon==std::string::npos || colon==0) return {};
+    Endpoint port; if(!parse("127.0.0.1:"+name.substr(colon+1),port)) return {};
+    std::string host=name.substr(0,colon);
+    if(host.size()>253 || host.find_first_not_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-")!=std::string::npos) return {};
+    struct Result { std::mutex lock; bool done=false; uint32_t ip=0; };
+    auto result=std::make_shared<Result>();
+    // OS DNS can outlast the connection deadline. The detached resolver owns
+    // every byte it touches; cancellation never waits on or destroys its data.
+    std::thread([host,result] {
+#ifdef _WIN32
+        WSADATA w{}; bool initialized=WSAStartup(MAKEWORD(2,2),&w)==0;
+        if(!initialized) { std::lock_guard<std::mutex> guard(result->lock); result->done=true; return; }
+#endif
+        addrinfo hint{}; hint.ai_family=AF_INET; hint.ai_socktype=SOCK_DGRAM; addrinfo* addresses=nullptr; uint32_t ip=0;
+        if(!getaddrinfo(host.c_str(),nullptr,&hint,&addresses)) {
+            if(addresses) ip=ntohl(reinterpret_cast<sockaddr_in*>(addresses->ai_addr)->sin_addr.s_addr);
+            freeaddrinfo(addresses);
+        }
+        { std::lock_guard<std::mutex> guard(result->lock); result->ip=ip; result->done=true; }
+#ifdef _WIN32
+        WSACleanup();
+#endif
+    }).detach();
+    auto until=Clock::now()+std::chrono::milliseconds(timeout_ms);
+    while(Clock::now()<until && !cancelled(cancel)) {
+        { std::lock_guard<std::mutex> guard(result->lock); if(result->done) return {result->ip,port.port}; }
+        std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    } return {};
+}
+Bytes SocketIO::exchange(Endpoint to,const Bytes& request,int timeout_ms) {
+    if(sock==invalid || !to) return {};
+    auto until=Clock::now()+std::chrono::milliseconds(timeout_ms),next=Clock::now(); int delay=250;
+    while(Clock::now()<until && !cancelled(cancel)) {
+        if(Clock::now()>=next) { send(sock,to,request.data(),request.size()); next=Clock::now()+std::chrono::milliseconds(delay); delay*=2; }
+        uint8_t buffer[2048]; Endpoint from; int n=receive(sock,buffer,sizeof buffer,from);
+        if(n>=0 && from==to) return Bytes(buffer,buffer+n);
+        std::this_thread::sleep_for(std::chrono::milliseconds(2));
+    } return {};
+}
+std::string SocketIO::discover(const std::string& request,int timeout_ms) {
+    if(sock==invalid) return "";
+    // An explicit numeric discovery endpoint also supports local router fixtures.
+    Endpoint destination{0xeffffffa,1900};
+    if(const char* test=std::getenv("STV_NETPLAY_SSDP")) { Endpoint e; if(parse(test,e)) destination=e; }
+    send(sock,destination,reinterpret_cast<const uint8_t*>(request.data()),request.size());
+    auto until=Clock::now()+std::chrono::milliseconds(timeout_ms);
+    while(Clock::now()<until && !cancelled(cancel)) {
+        uint8_t bytes[8192]; Endpoint from; int n=receive(sock,bytes,sizeof bytes,from);
+        if(n>0 && private_ip(from.ip)) {
+            std::string response(reinterpret_cast<char*>(bytes),size_t(n));
