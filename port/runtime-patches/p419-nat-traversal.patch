+#include "net_traversal.h"
+#include "test.h"
+#include <algorithm>
+#include <cstring>
+using namespace net;
+namespace {
+Bytes hex(const char* value) {
+    Bytes b; unsigned v=0,bits=0;
+    for(const char* p=value;*p;++p) { int n=*p>='0'&&*p<='9'?*p-'0':*p>='a'&&*p<='f'?*p-'a'+10:-1; if(n<0) continue; v=v*16+unsigned(n); if(++bits==2) { b.push_back(uint8_t(v)); bits=v=0; } } return b;
+}
+Transaction id{0xb7,0xe7,0xa7,0x01,0xbc,0x34,0xd6,0x86,0xfa,0x87,0xdf,0xae};
+const std::string service="urn:schemas-upnp-org:service:WANIPConnection:1";
+struct FakeRouter:IO {
+    Mapping::Kind kind; bool removed=false; int adds=0;
+    std::vector<Bytes> requests;
+    explicit FakeRouter(Mapping::Kind k):kind(k) {}
+    Bytes exchange(Endpoint,const Bytes& b,int) override {
+        requests.push_back(b);
+        if(kind==Mapping::PCP && b.size()==60 && b[0]==2) {
+            Bytes reply=b; reply[1]=129; std::fill(reply.begin()+8,reply.begin()+24,0); reply[42]=0x9c; reply[43]=0x40;
+            reply[56]=203;reply[57]=0;reply[58]=113;reply[59]=9; if(!b[4]&&!b[5]&&!b[6]&&!b[7]) removed=true; else ++adds; return reply;
+        }
+        if(kind==Mapping::PMP && b==Bytes({0,0})) return hex("00 80 0000 0000002a cb007109");
+        if(kind==Mapping::PMP && b.size()==12 && b[0]==0 && b[1]==1) {
+            Bytes reply=hex("00 81 0000 0000002a"); reply.insert(reply.end(),b.begin()+4,b.end());
+            if(!b[8]&&!b[9]&&!b[10]&&!b[11]) { removed=true; reply[10]=reply[11]=0; } else { ++adds; reply[10]=0x9c; reply[11]=0x40; }
+            return reply;
+        } return {};
+    }
+    std::string discover(const std::string& request,int) override {
+        CHECK_EQ(request==ssdp_request(),true); return kind==Mapping::IGD?"HTTP/1.1 200 OK\r\nlOcAtIoN: http://127.0.0.1:8080/root.xml\r\n\r\n":"";
+    }
+    std::string http(const std::string&,const std::string& action,const std::string& body) override {
+        if(action.empty()) return "<root><device><serviceList><service><serviceType>"+service+"</serviceType><controlURL>/ctl</controlURL></service></serviceList></device></root>";
+        if(action==service+"#GetExternalIPAddress") return "<NewExternalIPAddress>203.0.113.9</NewExternalIPAddress>";
+        if(action==service+"#AddPortMapping") {
+            CHECK_EQ(xml_value(body,"NewProtocol")=="UDP",true); CHECK_EQ(xml_value(body,"NewLeaseDuration")=="600",true);
+            CHECK_EQ(xml_value(body,"NewInternalClient")=="192.168.1.4",true); ++adds; return "<u:AddPortMappingResponse/>";
+        }
+        if(action==service+"#DeletePortMapping") { CHECK_EQ(xml_value(body,"NewProtocol")=="UDP",true); removed=true; return "<u:DeletePortMappingResponse/>"; }
+        return "";
+    }
+};
+}
+TEST(stun_rfc5389_request_and_rfc5769_ipv4_response) {
+    CHECK_EQ(stun_request(id)==hex("0001 0000 2112a442 b7e7a701bc34d686fa87dfae"),true);
+    auto response=hex("0101 003c 2112a442 b7e7a701bc34d686fa87dfae 8022 000b 7465737420766563746f7220 0020 0008 0001 a147 e112a643 0008 0014 2b91f599fd9e90c38c7489f92af9ba53f06be7d7 8028 0004 c07d4c96");
+    Endpoint e; CHECK_EQ(stun_response(response,id,e),true); CHECK_EQ(e.ip,0xc0000201); CHECK_EQ(e.port,32853);
+    for(size_t n=0;n<response.size();++n) CHECK_EQ(stun_response(Bytes(response.begin(),response.begin()+n),id,e),false);
+    response.back()^=1; CHECK_EQ(stun_response(response,id,e),false);
+}
+TEST(stun_rejects_wrong_transaction_error_length_and_family) {
+    auto b=hex("0101 000c 2112a442 b7e7a701bc34d686fa87dfae 0020 0008 0001 a147 e112a643"); Endpoint e;
+    CHECK_EQ(stun_response(b,id,e),true); b[8]^=1; CHECK_EQ(stun_response(b,id,e),false); b[8]^=1;
+    b[1]=0x11; CHECK_EQ(stun_response(b,id,e),false); b[1]=1;
+    b[3]=13; CHECK_EQ(stun_response(b,id,e),false); b[3]=12;
+    b[25]=2; CHECK_EQ(stun_response(b,id,e),false);
+}
+TEST(natpmp_big_endian_mapping_error_and_delete_vectors) {
+    CHECK_EQ(pmp_request(7845,7845,600)==hex("0001 0000 1ea5 1ea5 00000258"),true);
+    Endpoint e{0xcb007109,0}; uint32_t lease=0;
+    auto b=hex("0081 0000 0000002a 1ea5 9c40 00000258"); CHECK_EQ(pmp_response(b,7845,e,lease),true); CHECK_EQ(e.port,40000); CHECK_EQ(lease,600);
+    CHECK_EQ(pmp_response(b,7846,e,lease),false); b[3]=2; CHECK_EQ(pmp_response(b,7845,e,lease),false);
+    CHECK_EQ(pmp_request(7845,0,0)==hex("0001 0000 1ea5 0000 00000000"),true);
+    CHECK_EQ(pmp_response(hex("0081 0000 0000002a 1ea5 0000 00000000"),7845,e,lease),true);
+}
+TEST(pcp_map_matches_rfc6887_layout_nonce_and_ipv4_mapped_address) {
+    auto request=pcp_request({0xc0a80104,7845},{0,7845},id,600);
+    CHECK_EQ(request==hex("0201 0000 00000258 00000000000000000000 ffff c0a80104 b7e7a701bc34d686fa87dfae 11000000 1ea5 1ea5 00000000000000000000 ffff 00000000"),true);
+    FakeRouter io(Mapping::PCP); auto reply=io.exchange({},request,0); Endpoint e; uint32_t lease;
+    CHECK_EQ(pcp_response(reply,7845,id,e,lease),true); CHECK_EQ(e.port,40000); CHECK_EQ(e.ip,0xcb007109);
+    reply[24]^=1; CHECK_EQ(pcp_response(reply,7845,id,e,lease),false); reply[24]^=1; reply[3]=2; CHECK_EQ(pcp_response(reply,7845,id,e,lease),false);
+}
+TEST(fake_local_pcp_and_natpmp_responders_map_renew_and_remove) {
