+        CHECK_EQ(m.kind,kind); CHECK_EQ(m.external.ip,0xcb007109); CHECK_EQ(m.external.port,40000); CHECK_EQ(m.lease,600);
+        CHECK_EQ(renew_mapping(io,m),true); CHECK_EQ(io.adds,2); CHECK_EQ(renew_mapping(io,m,true),true); CHECK_EQ(io.removed,true);
+    }
+}
