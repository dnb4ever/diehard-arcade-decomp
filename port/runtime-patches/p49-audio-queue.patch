+        g_audio_started = true;
+        SDL_ResumeAudioStreamDevice(g_audio);
+    } else if (queued + frames > kMax) {
+        // A boot burst, unpaced run or host-clock reset: keep the current sound.
+        // Repeatedly dropping NEW chunks would leave the old 250 ms backlog intact.
+        SDL_ClearAudioStream(g_audio);
+        audio_silence(kLead);
+        g_audio_level = kLead;
+        ++g_resyncs;
+    } else if (queued == 0) {
+        ++g_underruns;
+        audio_silence(kLead);
+    }
     HostCall in("SDL_PutAudioStreamData");
     SDL_PutAudioStreamData(g_audio, lr, frames * 4);
 }
 
