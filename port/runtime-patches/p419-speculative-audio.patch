+#include "net_audio.h"
+#include "test.h"
+#include <vector>
+TEST(net_audio_corrects_only_unsubmitted_samples_with_three_ms_fade) {
+    NetAudio a; std::vector<int16_t> old(800,1000), now(800,-1000), played(400);
+    a.submit(old.data(),400,400); a.consume(played.data(),100);
+    a.rollback(); a.submit(now.data(),400,400); a.recovered();
+    CHECK_EQ(a.corrections,1); CHECK_EQ(a.missed,100); CHECK_EQ(a.corrected,300);
+    a.consume(played.data(),200);
+    CHECK_EQ(played[0],984); CHECK_EQ(played[2*131],-1000);
+    CHECK_EQ(a.queued(),100); CHECK_EQ(a.seams,0);
+}
+TEST(net_audio_identical_replay_does_not_touch_playback) {
+    NetAudio a; int16_t s[]={10,20,30,40}, out[4];
+    a.submit(s,2,2); a.rollback(); a.submit(s,2,2); a.recovered(); a.consume(out,2);
+    CHECK_EQ(a.corrections,0); CHECK_EQ(out[0],10); CHECK_EQ(out[3],40);
+}
+TEST(net_audio_crossfade_spans_small_sound_polls_and_new_tail_is_once_only) {
+    NetAudio a; std::vector<int16_t> old(600,1000), now(600,0), out(600);
+    a.submit(old.data(),300,300); a.rollback();
+    for(int i=0;i<300;i+=4) a.submit(now.data()+i*2,4,i+4);
+    a.recovered(); a.consume(out.data(),300);
+    CHECK_EQ(a.corrections,1); CHECK_EQ(out[0],992); CHECK_EQ(out[264],0); CHECK_EQ(a.queued(),0);
+    a.submit(old.data(),4,304); a.consume(out.data(),4); CHECK_EQ(out[0],1000);
+}
+
+TEST(net_audio_fades_into_new_tail_when_wrong_audio_was_all_submitted) {
+    NetAudio a; std::vector<int16_t> old(400,1000), now(400,-1000), out(400);
+    a.submit(old.data(),200,200); a.consume(out.data(),200);
+    a.rollback(); a.submit(now.data(),200,200); a.recovered();
+    a.submit(now.data(),200,400); a.consume(out.data(),200);
+    CHECK_EQ(a.corrected,0); CHECK_EQ(a.missed,200); CHECK_EQ(out[0],984); CHECK_EQ(out[262],-1000);
+}
+TEST(net_audio_trims_submitted_history_and_preserves_absolute_positions) {
+    NetAudio a; std::vector<int16_t> s(2000,100), out(2000);
+    for(unsigned end=1000;end<=100000;end+=1000) { a.submit(s.data(),1000,end,1000000); a.consume(out.data(),1000,true,2000000); }
+    CHECK_EQ(a.queued(),0); CHECK_EQ(a.age_count,100000); CHECK_EQ(a.age_sum/a.age_count,1000000);
+    a.rollback(); s.assign(2000,200); a.submit(s.data(),1000,100000); a.recovered();
+    CHECK_EQ(a.missed,1000); a.submit(s.data(),1000,101000); a.consume(out.data(),1000);
+    CHECK_EQ(out[0],100); CHECK_EQ(out[264],200); CHECK_EQ(a.queued(),0);
+}
