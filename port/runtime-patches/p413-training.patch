+// Game data evidence: 0222ab18 subtracts actor+56; 02228168 seeds HP/lives;
+// 02229c00 consumes lives. Actor +4E is not a universal invulnerability gate.
+static bool credit_override;
+static uint16_t credit_before;
+static bool ram_pointer(uint32_t p, unsigned size) { return p >= 0x06004000 && p <= 0x06100000-size && !(p&1); }
+void player_start() {
+    if (g_cfg.start_scene >= 2 && g_cfg.start_scene <= 72) {
+        // 02205b20: scene descriptor +43 selects branch type, +44 the next scene.
+        // Replace scene 0's '-1 -> 2' with '0 -> N'. The game builds the descriptor,
+        // runs its loaders and task cleanup itself. No mid-scene pointer teleport.
+        st8(0x06072660+43, 0); st8(0x06072660+44, g_cfg.start_scene);
+        g_cfg.cheat_scene_used = true;
+        sat_note("training: scene-0 next selector -> scene %d", g_cfg.start_scene);
+    }
+}
+void player_training_tick() {
+    if (!g_cfg.arcade) return;
+    if (g_cfg.cheat_credits) {
+        if (!credit_override) { credit_before = uint16_t(ld16(0x06000794)); credit_override = true; }
+        // MAME Coin Assignments preset 25; existing BIOS 660/664 expose free play.
+        st16(0x06000794, 0x1901);
+    } else if (credit_override) {
+        st16(0x06000794, credit_before); credit_override = false;
+    }
+    if (!g_cfg.cheat_health && !g_cfg.cheat_lives) return;
+    for (unsigned p = 0; p < 2; ++p) {
+        if (ld8(0x06098674+p) != 2) continue; // joined player only; leave attract/enemies intact
+        uint32_t task = ld32(0x060995B0 + 4*(p+1));
+        if (!ram_pointer(task, 0x20)) continue;
+        uint32_t actor = ld32(task+8);
+        if (!ram_pointer(actor, 0x18c) || ld8(actor+0x34) != p+1) continue;
+        if (g_cfg.cheat_health) {
+            unsigned hp = ld16(0x06099794) * (ld16(0x0609979A) == 1 ? 2 : 1);
+            if (hp && hp <= 342) { st16(actor+0x56, hp); st16(0x06099788+2*p, hp); }
+        }
+        if (g_cfg.cheat_lives) st16(0x0609978C+2*p, 9);
+        static const bool trace = std::getenv("STV_PLAYER_TRACE") != nullptr;
+        static uint64_t seen[2] = {~0ull, ~0ull};
+        if (trace && seen[p] != sat_vblanks()) {
+            seen[p] = sat_vblanks();
+            sat_note("TRAIN VB=%llu p=%u actor=%08X hp=%u lives=%u inv=%u assignment=%04X scene=%u timer=%u",
+                (unsigned long long)sat_vblanks(), p+1, actor, ld16(actor+0x56), ld16(0x0609978C+2*p),
+                ld8(actor+0x4E), ld16(0x06000794), ld32(0x06098668), ld32(0x060987BC));
+        }
+    }
+}
+void player_state(State& s) { s(credit_override); s(credit_before); s(g_cfg.cheat_scene_used); }
+std::string player_cheat_label() {
+    std::string label;
+    if (g_cfg.cheat_health) label += " HP";
+    if (g_cfg.cheat_lives) label += " LIVES";
+    if (g_cfg.cheat_credits) label += " CREDITS";
+    if (g_cfg.cheat_scene_used) label += " SCENE";
+    return label.empty() ? label : "CHEATS:" + label;
+}
