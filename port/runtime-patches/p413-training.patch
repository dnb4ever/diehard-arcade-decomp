@@ -0,0 +1,35 @@
+#include "saturn.h"
+#include "player.h"
+#include "state.h"
+#include "test.h"
+TEST(training_writes_only_joined_player_actor_fields_and_restores_credit_assignment) {
+    auto old = g_cfg; g_cfg = SaturnConfig{}; g_cfg.arcade = true;
+    st8(0x06098674, 2); st8(0x06098675, 0);
+    st32(0x060995B4, 0x060F2000); st32(0x060F2008, 0x060F2100);
+    st8(0x060F2134, 1); st16(0x060F2156, 17); st8(0x060F214E, 0);
+    st16(0x06099794, 114); st16(0x0609979A, 0); st16(0x0609978C, 1); st16(0x0609978E, 3);
+    st16(0x06000794, 0x0101);
+    g_cfg.cheat_health = g_cfg.cheat_lives = g_cfg.cheat_credits = true;
+    player_training_tick();
+    CHECK_EQ(ld16(0x060F2156), 114); CHECK_EQ(ld16(0x06099788), 114);
+    CHECK_EQ(ld16(0x0609978C), 9); CHECK_EQ(ld16(0x0609978E), 3);
+    CHECK_EQ(ld8(0x060F214E), 0); CHECK_EQ(ld16(0x06000794), 0x1901);
+    CHECK_EQ(player_cheat_label().find("CHEATS:") == 0, true);
+    State saved; player_state(saved);
+    g_cfg.cheat_credits = false; player_training_tick(); CHECK_EQ(ld16(0x06000794), 0x0101);
+    g_cfg.cheat_credits = true; saved.loading = true; player_state(saved);
+    g_cfg.cheat_credits = false; player_training_tick(); CHECK_EQ(ld16(0x06000794), 0x0101);
+    // A stale slot pointing outside RAM must never be followed or patched.
+    st32(0x060F2008, 0x02200000); player_training_tick();
+    g_cfg = old; st8(0x06098674, 0);
+}
+TEST(training_scene_select_changes_branch_data_without_changing_current_scene_or_handler) {
+    auto old = g_cfg; g_cfg = SaturnConfig{};
+    st8(0x06072660+43, 255); st8(0x06072660+44, 2);
+    st32(0x06098668, 0); st32(0x0609866C, 0x06072660);
+    player_start(); CHECK_EQ(ld8(0x06072660+43), 255);
+    g_cfg.start_scene = 9; player_start();
+    CHECK_EQ(ld8(0x06072660+43), 0); CHECK_EQ(ld8(0x06072660+44), 9);
+    CHECK_EQ(ld32(0x06098668), 0); CHECK_EQ(ld32(0x0609866C), 0x06072660);
+    g_cfg = old;
+}
