--- /dev/null
+++ b/runtime/src/machine/player.cpp
@@ -0,0 +1,20 @@
+#include "saturn.h"
+#include "player.h"
+#include "settings.h"
+#include <algorithm>
+
+void player_settings(const Settings& settings) {
+    if (!g_cfg.arcade) return;
+    if (!g_cfg.rewind_seconds) g_cfg.rewind_seconds = settings.number("player", "rewind_seconds");
+    g_cfg.fast_forward = settings.flag("player", "fast_forward");
+    for (int p = 0; p < 2; ++p) for (int b = 0; b < 3; ++b) {
+        std::string key = "turbo_p" + std::to_string(p+1) + "_" + char('a'+b);
+        g_cfg.turbo_hz[p][b] = settings.number("player", key);
+    }
+}
+void player_input(uint64_t frame, uint16_t raw[2], uint16_t&) {
+    for (int p = 0; p < 2; ++p) for (int b = 0; b < 3; ++b) {
+        int rate = g_cfg.turbo_hz[p][b];
+        if (rate && (frame * unsigned(rate) % 60) >= 30) raw[p] &= uint16_t(~(1u << b));
+    }
+}
