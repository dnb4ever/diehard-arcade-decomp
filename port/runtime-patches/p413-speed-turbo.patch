+++ b/runtime/tests/player_test.cpp
@@ -0,0 +1,51 @@
+#include "saturn.h"
+#include "player.h"
+#include "settings.h"
+#include "test.h"
+
+TEST(player_defaults_leave_every_panel_bit_unchanged) {
+    auto old = g_cfg; g_cfg = SaturnConfig{}; g_cfg.arcade = true;
+    Settings set; player_settings(set);
+    CHECK_EQ(g_cfg.rewind_seconds, 0); CHECK_EQ(g_cfg.fast_forward, false);
+    for (unsigned frame = 0; frame < 120; ++frame) {
+        uint16_t raw[2] = {0x3c7, 0x347}, sys = 0x403f;
+        player_input(frame, raw, sys);
+        CHECK_EQ(raw[0], 0x3c7); CHECK_EQ(raw[1], 0x347); CHECK_EQ(sys, 0x403f);
+    }
+    g_cfg = old;
+}
+TEST(autofire_is_independent_per_player_and_does_not_invent_a_press) {
+    auto old = g_cfg; g_cfg = SaturnConfig{}; g_cfg.arcade = true;
+    Settings configured; std::vector<std::string> valid;
+    configured.read("[player]\nturbo_p1_a = 10\nturbo_p2_c = 15\n", valid);
+    CHECK_EQ(valid.size(), 0); player_settings(configured);
+    unsigned previous[2] = {}, edges[2] = {}, held[2] = {};
+    for (unsigned frame = 0; frame < 60; ++frame) {
+        uint16_t raw[2] = {0x103, 0x206}, sys = 0x30;
+        player_input(frame, raw, sys);
+        unsigned on[] = {unsigned(raw[0]&1), unsigned((raw[1]>>2)&1)};
+        for (int p = 0; p < 2; ++p) { edges[p] += on[p] && !previous[p]; held[p] += on[p]; previous[p] = on[p]; }
+        CHECK_EQ(raw[0]&0x102, 0x102); CHECK_EQ(raw[1]&0x202, 0x202); CHECK_EQ(sys, 0x30);
+    }
+    CHECK_EQ(edges[0], 10); CHECK_EQ(edges[1], 15); CHECK_EQ(held[0], 30); CHECK_EQ(held[1], 30);
+    uint16_t raw[2] = {}, sys = 0;
+    player_input(60, raw, sys); CHECK_EQ(raw[0], 0); CHECK_EQ(raw[1], 0);
+    Settings settings; std::vector<std::string> problems;
+    settings.read("[player]\nturbo_p1_a = 31\nrewind_seconds = 21\n", problems);
+    CHECK_EQ(problems.size(), 2); CHECK_EQ(settings.number("player", "turbo_p1_a"), 0);
+    g_cfg = old;
+}
+
+extern void stv_scene_probe_tick(uint64_t);
+TEST(autofire_reaches_the_headless_bios_scan_for_both_players) {
+    auto old = g_cfg; g_cfg = SaturnConfig{}; g_cfg.arcade = true;
+    g_cfg.turbo_hz[0][0] = 10; g_cfg.turbo_hz[1][2] = 15;
+    stv_input_script("100:P1A:60,100:P2C:60,100:P1RIGHT:60");
+    SH2Context c{}; c.pr = 0x06005000;
+    for (unsigned frame = 100; frame < 160; ++frame) {
+        stv_scene_probe_tick(frame); bios_call(c, 0x4010);
+        CHECK_EQ(ld16(0x06000708), 0x100 | (frame*10%60<30 ? 1 : 0));
+        CHECK_EQ(ld16(0x06000710), frame*15%60<30 ? 4 : 0);
+    }
+    stv_input_script(""); g_cfg = old;
+}
