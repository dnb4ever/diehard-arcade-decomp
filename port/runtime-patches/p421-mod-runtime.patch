+void mod_features() {
+    ImGui::SeparatorText("Mods (next session)");
+    ImGui::TextWrapped("Native mods run trusted local code. Enabled mods mark the session MODDED. Netplay requires identical files on both peers.");
+    ImGui::TextWrapped("Folder: %s",mods_directory().c_str());
+    if(ImGui::Button("Open mods folder")) {
+        // Encode a local file URI; never construct a shell command.
+        std::string uri="file://";
+        auto path=std::filesystem::absolute(std::filesystem::u8path(mods_directory())).generic_u8string();
+#ifdef _WIN32
+        uri+="/";
+#endif
+        const char* hex="0123456789ABCDEF";
+        for(unsigned char c:path) { if(c=='/' || c==':' || (c>='A'&&c<='Z') || (c>='a'&&c<='z') || (c>='0'&&c<='9') || c=='-' || c=='_' || c=='.') uri+=char(c); else {uri+='%';uri+=hex[c>>4];uri+=hex[c&15];} }
+        SDL_OpenURL(uri.c_str());
+    }
+    ImGui::TextWrapped("Drop a mod ZIP onto this launcher to install it disabled.");
+    const auto inventory=mods_list();
+    for(const auto& mod:inventory) {
+        ImGui::PushID(mod.id.c_str());bool on=mod.enabled;
