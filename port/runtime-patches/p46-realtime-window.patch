+             g_audio ? least * 1000 / 44100 : 0, g_audio ? most * 1000 / 44100 : 0, g_underruns, g_dropped);
+    since = Clock::now();
+    from = sat_vblanks();
+    skipped_from = g_skipped;
+    least = 1 << 30;
+    most = 0;
