+    // FAITHFUL correctness fix, validated against the driver-built ramp (func_02222c08 -> 0x5F200).
+    s.kt_base = (ktaof << 18) & 0x7FFFF;
+    // DIAGNOSTIC (STV_RBG_DIAG="[intv]", default off): read-only log of the live rotation-param
+    // set the game writes into the VDP2 rot-param table (VRAM base `b`). Used to see whether the
+    // live stage-camera driver feeds a valid floor anchor on a real stage scene. Byte-identical
+    // when unset. Logs every `intv` frames (default 120). Prints the director scene index too.
+    if (const char* rd = std::getenv("STV_RBG_DIAG")) {
