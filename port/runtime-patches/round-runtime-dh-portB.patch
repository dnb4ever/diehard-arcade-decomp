+            sat_note("RBG_DIAG VB %llu set=%s scene=%u table=%05X  My=%.1f Mx=%.1f Xst=%.1f Yst=%.1f Zst=%.1f "
+                     "Yp=%.1f Xp=%.1f KAst=%.1f dKAst=%.3f kt_en=%d kt_mode=%d kt_base=%05X A=%.3f E=%.3f",
+                     (unsigned long long)f, param_off ? "B" : "A", ld32(0x06098668u), b,
+                     s.My, s.Mx, s.Xst, s.Yst, s.Zst, s.Yp, s.Xp, s.KAst, s.dKAst,
+                     (int)s.kt_enable, s.kt_mode, s.kt_base, s.A, s.E);
+        }
+    }
+    if (std::getenv("STV_RBG_FLATK")) s.kt_enable = false;  // diag: force Kx=Ky=1
+}
