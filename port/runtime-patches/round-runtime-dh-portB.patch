+// RBG0's dot at display column x, line y: false if transparent / off the map.
+static bool rbg_pixel(const Rbg& s, int x, int y, Pix& p) {
+    // the screen-space pre-transform at this line, and the per-dot increments (through the matrix)
+    double Xstv = s.Xst + s.dXst * y, Ystv = s.Yst + s.dYst * y;
