+// Reads one rotation parameter set into s: the matrix, viewpoint/centre, the screen start and its
+// deltas, the constant screen offset, and the coefficient-table controls. param_off is 0 for set A
+// or 0x80 for set B (the table holds both sets back to back); coef_shift is 0 for set A's KTCTL/KTAOF
+// fields or 4 for set B's. Shared by RBG0 (picks the set via RPMD) and RBG1 (always uses set B).
+static void read_rot_param(Rbg& s, uint32_t param_off, int coef_shift) {
+    uint32_t rpt = ((((uint32_t)(reg(0xBC) & 7) << 16) | reg(0xBE)) & ~0x41u) * 2;
+    uint32_t b = (rpt + param_off) & 0x7FFFF;
+    auto raw = [&](uint32_t o) { return (uint32_t)((uint32_t)vw(b + o) << 16 | vw(b + o + 2)); };
+    // signed fixed-point: mask the field, sign-extend above it, /65536 (the low bits the chip
+    // ignores read back as 0, so this recovers the real value).
+    auto sfix = [&](uint32_t o, uint32_t m, int signbit) -> double {
+        uint32_t v = raw(o) & m;
+        if (v & (1u << signbit)) v |= ~m;
+        return (double)(int32_t)v / 65536.0;
+    };
+    auto s16 = [&](uint32_t o) -> double { return (double)(int16_t)vw(b + o); };
+    s.Xst  = sfix(0x00, 0x1FFFFFC0, 28); s.Yst = sfix(0x04, 0x1FFFFFC0, 28); s.Zst = sfix(0x08, 0x1FFFFFC0, 28);
+    s.dXst = sfix(0x0C, 0x0003FFC0, 17); s.dYst = sfix(0x10, 0x0003FFC0, 17);
+    s.dX   = sfix(0x14, 0x0003FFC0, 17); s.dY   = sfix(0x18, 0x0003FFC0, 17);
+    s.A = sfix(0x1C, 0x000FFFFF, 19); s.B = sfix(0x20, 0x000FFFFF, 19); s.C = sfix(0x24, 0x000FFFFF, 19);
+    s.D = sfix(0x28, 0x000FFFFF, 19); s.E = sfix(0x2C, 0x000FFFFF, 19); s.F = sfix(0x30, 0x000FFFFF, 19);
+    s.Px = s16(0x34); s.Py = s16(0x36); s.Pz = s16(0x38);
+    s.Cx = s16(0x3C); s.Cy = s16(0x3E); s.Cz = s16(0x40);
+    s.Mx = sfix(0x44, 0x3FFFFFC0, 29); s.My = sfix(0x48, 0x3FFFFFC0, 29);
