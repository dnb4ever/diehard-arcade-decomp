+// ======================================================================================
+// FAITHFUL ST-V SYSTEM-BIOS LAYER (the JAMMA control panel + coin/credit state the real
+// ST-V BIOS publishes into system work RAM every frame). Implemented because, with no ST-V
+// BIOS ROM, these system words were all left zero and the game sat in the attract/coin-wait
+// fixed point (the prior sessions' diagnostic knobs STV_STARTENABLE/STV_SCENEGATE/STV_CFG798
+// stood them in). This replaces those stand-ins with the real BIOS behavior, driven from the
+// always-on VBlank tick (the real BIOS maintains them from its per-frame SMPC/JAMMA scan).
+//
+// The system words and what the game reads them for (all decompiled, see project/src_functional):
+//   0x06000798  machine DIP / config word. bit5(0x20)=test/service mode (clear=normal),
+//               bit6(0x40)=sound-enable. Read by func_0201b92 (sound gate), func_02201590,
+//               func_022016ac, func_022058a8 (test/service branch). Faithful value for a
+//               normal 2P cabinet with sound: 0x60.
+//   0x06000654  BIOS panel/credit status word. bit9(0x200)=2-player control panel present,
+//               bit8(0x100)=auto-start/free-play dip, bits12/13(0x1000/0x2000)=force-coin
+//               P1/P2 dips, low 7 bits = insert-coin countdown timer (0x7F = idle). Read by
+//               func_022058a8 (scene bootstrap) + func_0220600e (credit/join scene). Faithful
+//               idle value for a 2P cabinet, coins-required, no force: 0x27F.
+//   0x06098798  cooked system control word (field +4 of struct 0x06098794). bit2(0x04)=panel
+//               poll-enable, bit4(0x10)=P1 control/start enable, bit5(0x20)=P2 control/start
+//               enable. A full image scan (prior session) found NO cart code sets bits 4/5 --
+//               they are BIOS/system-provided, cleared once by the game at boot (rt 0x06005580)
+//               then only READ: the scene-81 START gate (func_02206876), the credit-scene join
+//               (func_0220600e), and the per-frame controller SM (func_0220f9d4 coin latch) all
+//               gate on bits 0x30. The real BIOS re-publishes this from its SMPC panel scan each
+//               frame, so we re-assert it each frame AFTER the game's boot clear. For a connected
+//               2-player panel the value is 0x04|0x10|0x20 = 0x34.
+//               [FAITHFUL VALUE; the exact BIOS write-back address is fixed by this game's SDK
+//                link and is reproduced here directly -- the one piece whose hardware mechanism
+//                (how the BIOS learns the game's buffer address) is not pinned this session.]
+//
+// Coin path: the real BIOS coin service (0x06000664) consumes one coin-credit from a BIOS bank
+// the coin mechanism fills; 0x06000640 is a free-running frame timer. We maintain both so the
+// game's own credit code (func_0220600e credit scene, func_0220f9d4 controller SM) works if the
+// director reaches a frame-paced scene. During attract the game polls only 0x06000660 (the
+// coin-detect fn 0x060065f0 is not scheduled there), so deliver_coin still raises the coin-
+// pending flag 0x0609880C directly (the faithful substitute for the unrun hardware coin-switch),
+// and ALSO banks a credit here so both consumers agree. STV_NOSYSBIOS disables this whole layer
+// for A/B regression (restores the pre-change behavior). (g_stv_credits / g_stv_frametimer are
+// declared earlier so deliver_coin can bank a credit.)
+static const uint16_t kStvPanelCtrl = 0x0034u;  // 0x06098798: bit2 poll | bit4 P1 en | bit5 P2 en
+static bool stv_sysbios_on() {
+    static bool v = (std::getenv("STV_NOSYSBIOS") == nullptr);
+    return v;
+}
+
+// Called every frame (from stv_scene_probe_tick, which video.cpp's vblank_in runs every frame).
+// Re-publishes the BIOS-maintained system control word, exactly as the real BIOS's per-frame
+// SMPC panel scan would, so the game's START gates / coin latches see a connected 2-player panel.
+static void stv_system_bios_tick() {
+    if (!stv_sysbios_on()) return;
+    g_stv_frametimer++;
+    // Re-assert the cooked system control word (start-enable + panel-poll). The game clears it at
+    // boot and never sets bits 4/5; the BIOS owns them. Faithful for a 2-player panel.
+    uint16_t cw = (uint16_t)ld16(0x06098798u);
+    if ((cw & kStvPanelCtrl) != kStvPanelCtrl)
+        st16(0x06098798u, (uint16_t)(cw | kStvPanelCtrl));
+
+    // FAITHFUL SUB-FIX #1 (default, not a knob): the BIOS insert-coin / attract countdown timer.
+    // 0x06000654 low 7 bits are the BIOS coin/attract countdown; the real ST-V BIOS decrements this
+    // field every frame while attract is running. main_stv seeds the word as 0x037F (2P panel |
+    // credit-required | low7=0x7F). The credit-wait scene (func_0220600e scene_credit_join_sm, scene
+    // index 1) reads `timer = (u16)0x06000654 & 0x7F`: it displays the countdown digit while
+    // timer != 0x7F, and COMMITS the scene (-> attract_handler -> the attract demo reel) once
+    // timer == 0 (with entity+0x40 == 0). With the field left STATIC at 0x7F the credit-wait scene
+    // never commits and the attract reel never starts (scene 1 FREEZES). Decrementing the low 7 bits
+    // to 0 each frame is the real BIOS behaviour: scene 1 auto-advances into the attract demo reel
+    // (scene 1 -> 2 (demo) -> 3 (fade) -> ...). We hold at 0 once reached; the attract reel loops
+    // 2->..->73->..->2 (scene 0 selector -1 -> 2) and never re-enters scene 1, so no reload is needed.
+    // A coin is still genuinely required to ENTER PLAY (the credit-join path); only the attract reel
+    // now runs without one, exactly as a real cabinet. Preserves the high bits (0x100 credit-required,
+    // 0x200 2P panel) that scene_bootstrap / credit-wait also read. STV_NOSYSBIOS disables the whole
+    // layer (restores the static-idle behaviour for A/B).
+    static const bool countdown_en = (std::getenv("STV_ATTRACT_COUNTDOWN") != nullptr);
+    if (countdown_en) {
+        uint16_t pc = (uint16_t)ld16(0x06000654u);
+        uint16_t low7 = pc & 0x7Fu;
+        if (low7 != 0)
+            st16(0x06000654u, (uint16_t)((pc & 0xFF80u) | (low7 - 1)));
+    }
+}
+
+// Fill the panel report at `buf` with the current control-panel state. Called from the
+// 0x06000660 service every frame. Writes a full zeroed report (so a one-frame press
+// pulse releases on the next frame -> a clean rising edge), then stamps any scripted
+// event active on this VBlank.
+// Scene-director probe driver (diagnostic, default off). Called EVERY frame from video.cpp's
+// vblank_in -- the ST-V panel service (stv_panel_read) is NOT scheduled once the game-enter
+// scenes run, so the scene walk must be driven from the always-on VBlank tick, not the panel
+// read. Purpose: LOCATE which setup scene (73-80) installs the player spawn-script. STV_SCENEJUMP
+// forces the hardcoded game scene 81 via the unk13<0 lever and SKIPS the setup scenes; these
+// knobs instead drop the scene-director onto / step it through a chosen scene index so each setup
+// scene's per-frame setup runs. The director reads the active scene from g_06098668 (index) +
+// g_0609866c (descriptor = 0x06072660 + idx*0x50) and, on each advance (director-entity->unk3c
+// bit0 set), runs the game-enter install block for idx>=76. All default-off => byte-identical.
+//   STV_SCENESEED="vb:idx"        ONCE at VB>=vb: g_06098668=idx, g_0609866c=desc(idx)
+//   STV_SCENEADV ="vb:count:intv" from VB>=vb, every intv frames, force 1 director advance, count times
+//   STV_SCENEPIN ="idx"           every frame: pin g_06098668=idx, g_0609866c=desc(idx)
+//   STV_SCENEJOIN="startvb"       from VB>=startvb: g_06098674=g_06098675=2 (scene-73 branch -> 74)
+//   STV_SCENECHAR="v"             every frame: g_0609856c=v (scene-75 branch -> 76 + (v&3))
+static bool s_playroute_fired = false;   // set once STV_PLAYROUTE seeds the director; read by STV_JOINHOLD
+void stv_scene_probe_tick(uint64_t vb) {
+    stv_system_bios_tick();            // FAITHFUL: re-publish the BIOS system control word every frame
+    // STV_DESCDUMP="vb" (diagnostic, default off; byte-identical when unset): one-shot dump of the
+    // scene descriptor table (base 0x06072660, stride 0x50) for scenes 0..89. For each scene prints
+    // desc+0x10 (the play-definition pointer scene_obj_handler case-0 dereferences) and, when that
+    // points into data RAM, the def's unk0 (step callback), unk4/unk8 (args), unkC (substate seed),
+    // unkE (countdown). Lets us find which scenes carry a genuine play-definition layout vs attract
+    // scene 3 (desc+0x10 = cart code 0x0600F1C0). Read-only.
+    if (const char* e_dd = std::getenv("STV_DESCDUMP")) {
+        static bool dd_done = false;
+        uint64_t dd_at = (uint64_t)std::strtoull(e_dd, nullptr, 0);
+        if (!dd_done && vb >= dd_at) {
+            dd_done = true;
+            sat_note("STV_DESCDUMP at VB %llu (desc base 0x06072660 stride 0x50)", (unsigned long long)vb);
+            for (uint32_t idx = 0; idx <= 89; idx++) {
+                uint32_t desc = 0x06072660u + idx * 0x50u;
+                uint32_t p10  = ld32(desc + 0x10u);    // play-def pointer
+                uint32_t p14  = ld32(desc + 0x14u);    // func_0220fece tail arg
+                uint32_t p1c  = ld32(desc + 0x1Cu);    // spawn-list ptr
+                uint8_t  s2b  = ld8(desc + 0x2Bu);     // selector cur[43]
+                bool pdata = (p10 >> 24) == 0x06 && (p10 & 0xF00000u) >= 0x900000u; // 0x0609xxxx/0x060Axxxx/...
+                // treat anything pointing above 0x06090000 as data RAM; below is code/const
+                bool isdata = p10 >= 0x06004000u && p10 < 0x06092000u;
+                uint32_t u0=0,u4=0,u8=0,u10v=0; uint16_t uC=0,uE=0;
+                if (isdata) { u0=ld32(p10+0u); u4=ld32(p10+4u); u8=ld32(p10+8u);
+                              uC=(uint16_t)ld16(p10+0xCu); uE=(uint16_t)ld16(p10+0xEu); u10v=ld32(p10+0x10u); }
+                bool u0_code = (u0 >= 0x06004000u && u0 < 0x0604A000u); // plausible cart-code step callback
+                (void)u10v;
+                // stage-config fields that scene81_stage_setup (func_02206e2e) reads from a node:
+                uint32_t s30 = ld32(desc + 0x30u);   // flags (bit0 = DMA gate)
+                uint32_t s34 = ld32(desc + 0x34u);   // 2nd-layer flags
+                uint32_t s38 = ld32(desc + 0x38u);   // layer select / tile base
+                uint16_t s3a = (uint16_t)ld16(desc + 0x3Au); // cell-column count
+                uint32_t s3c = ld32(desc + 0x3Cu);   // stage-asset bundle ptr
+                sat_note("  sc%2u +14=%08X +1C=%08X sel=%d +10=%08X def{u0=%08X%s} STG{30=%08X 34=%08X 38=%08X 3A=%04X 3C=%08X}",
+                         idx, p14, p1c, (int)(int8_t)s2b, p10,
+                         u0, u0_code?"*CODE":"     ", s30, s34, s38, s3a, s3c);
+                (void)pdata; (void)u4; (void)u8; (void)uC; (void)uE;
+            }
+            // Also dump the SPECIAL scene-81 descriptor (0x06073fb0, NOT in the stride-0x50 table)
+            // the director's timeout-jump installs; it carries the real first-stage config.
+            for (uint32_t d = 0x06073fb0u, k = 0; k < 2; d += 0x50u, k++) {
+                sat_note("  SPECIAL %08X +10=%08X +14=%08X STG{30=%08X 34=%08X 38=%08X 3A=%04X 3C=%08X}",
+                         d, ld32(d+0x10u), ld32(d+0x14u), ld32(d+0x30u), ld32(d+0x34u),
+                         ld32(d+0x38u), (uint16_t)ld16(d+0x3Au), ld32(d+0x3Cu));
+            }
+        }
+    }
+    // STV_SYNTHDEF="dst[:src]" (LABELED default-off bridge; byte-identical when unset): route-(b)
+    // SYNTHESIS of a play-definition layout. Overwrites scene `dst`'s descriptor +0x10 (the def
+    // pointer scene_obj_handler case-0 dereferences and whose unk0 it CALLS) with scene `src`'s
+    // def pointer (src defaults to 2, a real stage scene). Attract scenes (3,5,7,9,15,...) carry
+    // a def at 0x0600F1C0/F6B2/FC20 whose unk0 = 0x2FE62FD6 (raw instruction data, NOT a function
+    // pointer) -> scene_run -> func_02218038 -> scene_obj_handler case-0 FATALs "call to 0FE62FD6".
+    // A real stage scene's def (scene 2 @0x06063F40) has unk0 = 0x060125BC (cart func_0220e5bc, the
+    // real play scene-object step callback) + valid unk4/unk8 data-block args + substate seed. Writing
+    // it onto the held attract scene's +0x10 converts the FATAL into a clean scene_obj_handler step.
+    // Applied every frame (idempotent). Read scene 2's +0x10 each frame in case the table relocates.
+    if (const char* e_sd = std::getenv("STV_SYNTHDEF")) {
+        uint32_t dst = (uint32_t)std::strtoul(e_sd, nullptr, 0);
+        uint32_t src = 2; uint64_t sd_start = 0;
+        if (const char* c = std::strchr(e_sd, ':')) { src = (uint32_t)std::strtoul(c + 1, nullptr, 0);
+            if (const char* c2 = std::strchr(c + 1, ':')) sd_start = (uint64_t)std::strtoull(c2 + 1, nullptr, 0); }
+        if (vb < sd_start) { /* wait: attract scenes use desc+0x10 as a DIRECT code ptr; only patch after the morph */ } else {
+        uint32_t ddesc = 0x06072660u + dst * 0x50u;
+        uint32_t sdesc = 0x06072660u + src * 0x50u;
+        uint32_t sdef  = ld32(sdesc + 0x10u);
+        if (sdef && ld32(ddesc + 0x10u) != sdef) {
+            st32(ddesc + 0x10u, sdef);
+            static bool noted = false;
+            if (!noted) { noted = true;
+                sat_note("STV_SYNTHDEF: scene %u desc+0x10 <- scene %u def %08X (unk0=%08X) at VB %llu [route-b synthesis]",
+                         dst, src, sdef, ld32(sdef + 0u), (unsigned long long)vb); }
+        }
+        }
+    }
+    // STV_STAGEDMA="vb[:src[:intv]]" (LABELED default-off bridge; byte-identical when unset): the FLOOR
+    // fix for route-b. On route-b the director is HELD on attract scene 3 whose VDP2 background is the
+    // night-skyline (scene 3's stage bundle 0x0607238C, DMA'd at its bootstrap). scene_run installs
+    // scene_obj_handler (func_0220f6f6), which steps the SYNTHDEF'd play content but NEVER re-DMAs a
