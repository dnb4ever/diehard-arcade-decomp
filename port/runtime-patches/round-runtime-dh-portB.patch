+static void setup_rbg(Rbg& s) {
+    s = Rbg{};
+    uint16_t bgon = reg(0x20);
+    s.on = bgon >> 4 & 1;                        // R0ON
+    if (!s.on) return;
+    s.opaque = bgon >> 12 & 1;                   // R0TPON
+    uint16_t chb = reg(0x2A);
+    s.cell2x2 = chb >> 8 & 1;                    // R0CHSZ
+    s.bitmap  = chb >> 9 & 1;                    // R0BMEN
+    int bmsz  = chb >> 10 & 3;                   // R0BMSZ
+    s.colors  = chb >> 12 & 7;                   // R0CHCN
+    s.bm_w = bmsz & 2 ? 1024 : 512;
+    s.bm_h = bmsz & 1 ? 512 : 256;
+    uint16_t pncr = reg(0x38);
+    s.word1 = pncr >> 15 & 1;
+    s.cnsm = pncr >> 14 & 1;
+    s.supp = pncr & 0x3FF;
+    int plsz = reg(0x3A) >> 8 & 3;              // RAPLSZ
+    s.plane_w = plsz == 0 ? 1 : 2;
+    s.plane_h = plsz == 3 ? 2 : 1;
+    s.over = reg(0x3A) >> 10 & 3;              // RAOVR screen-over process
+    s.page_bytes = (s.cell2x2 ? 0x800u : 0x2000u) * (s.word1 ? 1 : 2);
+    uint32_t mpofr = reg(0x3E) & 7;            // RAMPOF
+    uint32_t mask = (uint32_t)(s.plane_w * s.plane_h - 1);
+    // the 16 plane numbers: MPABRA..MPOPRA (0x48..0x56), each word = two bytes (low byte first,
+    // as the scroll-screen map registers), A..P.
+    for (int i = 0; i < 16; ++i) {
+        uint16_t w = reg(0x48 + (i / 2) * 2);
+        uint32_t pn = w >> ((i & 1) * 8) & 0xFF;
+        uint32_t m = ((mpofr << 6) | pn) & ~mask;
+        s.plane[i] = m * s.page_bytes;
+    }
+    if (s.bitmap) s.bm_addr = mpofr * 0x20000;
+    s.caos = (uint32_t)(reg(0xE6) & 7) << 8;    // CRAOFB R0 colour RAM offset
+    s.prio = (uint8_t)(reg(0xFC) & 7);          // PRIR
+    s.ratio = (uint8_t)(reg(0x10C) & 0x1F);     // CCRR
+    s.cc = reg(0xEC) >> 4 & 1;                   // CCCTL R0CCEN
+    s.offset = reg(0x110) >> 4 & 1;
+    s.offset_b = reg(0x112) >> 4 & 1;
+
+    // DIAGNOSTIC/FORCED (STV_RBG_PLANE="hex", default off): override every RBG0 plane-map entry to a
+    // single VRAM page. On the credit-route scene 3 the stage-floor upload only partially populates the
+    // RBG0 floor planes (plane 0x38 @0x070000 ~65%; plane 0x2E @0x05C000 empty) and the live camera My
+    // (~1991) samples the empty far planes -> black floor. Forcing all 16 planes at the populated floor
+    // page (e.g. STV_RBG_PLANE=070000) lets the whole rotation screen sample the loaded floor tiles for a
+    // labelled FORCED floor demo (pairs with STV_RBG_MY + STV_RBG_FLATK). Byte-identical when unset. This
+    // is a FORCED render aid, NOT a faithful fix (the real fix is the full stage-setup floor upload +
+    // coefficient table + camera anchor, which the credit route does not run).
+    if (const char* pf = std::getenv("STV_RBG_PLANE")) {
+        uint32_t pa = (uint32_t)std::strtoul(pf, nullptr, 16) & 0x7FFFFu;
+        for (int i = 0; i < 16; ++i) s.plane[i] = pa;
+    }
+
+    // RBG0 uses the rotation parameter set RPMD names (A, B, or A with per-dot/window switching).
+    int rpmd = reg(0xB0) & 3;                    // 0:A 1:B 2/3:per-coefficient/window (A used; partial)
+    read_rot_param(s, rpmd == 1 ? 0x80u : 0u, rpmd == 1 ? 4 : 0);
+}
