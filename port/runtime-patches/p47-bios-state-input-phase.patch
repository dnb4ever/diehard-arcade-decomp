--- a/runtime/tests/stv_bios_test.cpp
+++ b/runtime/tests/stv_bios_test.cpp
@@ -0,0 +1,58 @@
+#include "saturn.h"
+#include "test.h"
+
+extern void stv_scene_probe_tick(uint64_t vb);
+
+TEST(stv_bios_scans_physical_panel_when_guest_calls_frame_service) {
+    stv_input_script("1:P1RIGHT:2,1:START1:2");
+    for (uint32_t a = 0x06000700; a < 0x06000780; a += 4) st32(a, 0);
+    SH2Context c{};
+    c.pr = 0x06005000;
+    stv_scene_probe_tick(1);
+    CHECK_EQ(ld16(0x06000708), 0);
+    CHECK_EQ(ld16(0x06000728), 0);
+    CHECK_EQ(bios_call(c, 0x4010), true);
+    CHECK_EQ(c.pc, c.pr);
+    CHECK_EQ(ld16(0x06000708), 0x200);
+    CHECK_EQ(ld16(0x0600070C), 0x200);
+    CHECK_EQ(ld16(0x06000728), 0x10);
+    CHECK_EQ(ld16(0x0600072C), 0x10);
+    stv_scene_probe_tick(2);
+    CHECK_EQ(ld16(0x0600072A), 0);
+    bios_call(c, 0x4010);
+    CHECK_EQ(ld16(0x0600072A), 0x10);
+    CHECK_EQ(ld16(0x0600072C), 0);
+    stv_scene_probe_tick(3);
+    bios_call(c, 0x4010);
+    CHECK_EQ(ld16(0x06000708), 0);
+    CHECK_EQ(ld16(0x0600070E), 0x200);
+    CHECK_EQ(ld16(0x06000728), 0);
+    CHECK_EQ(ld16(0x0600072E), 0x10);
+    stv_input_script("");
+}
+
+TEST(stv_bios_settings_copies_eight_bytes_for_selected_slot_only) {
+    SH2Context c{};
+    c.r[4] = 0x060F1004;
+    st8(0x06000650, 1);
+    st32(0x060F1000, 0x12345678);
+    st32(0x060F100C, 0x87654321);
+    for (unsigned i = 0; i < 8; ++i) st8(0x060007A8 + i, 0x30+i);
+    CHECK_EQ(bios_call(c, 0x4034), true);
+    CHECK_EQ(ld32(0x060F1000), 0x12345678);
+    CHECK_EQ(ld32(0x060F1004), 0x30313233);
+    CHECK_EQ(ld32(0x060F1008), 0x34353637);
+    CHECK_EQ(ld32(0x060F100C), 0x87654321);
+    st8(0x06000650, 0);
+}
+
+TEST(stv_bios_backup_area_is_selected_by_slot) {
+    SH2Context c{};
+    for (unsigned slot = 0; slot < 4; ++slot) {
+        st8(0x06000650, slot);
+        c.r[4] = 3; // ROM 0x372C ignores the caller's argument.
+        CHECK_EQ(bios_call(c, 0x403C), true);
+        CHECK_EQ(c.r[0], 0x20180100 + 0xF00*slot);
+    }
+    st8(0x06000650, 0);
+}
