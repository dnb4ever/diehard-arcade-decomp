+
+TEST(arcade_player_layouts_survive_save_with_distinct_buttons_and_defaults) {
+    Settings s;
+    std::vector<std::string> problems;
+    s.read("[gamepad]\na = y\n", problems);
+    // P1 explicitly chooses factory A, P2 chooses a different button. Even the
+    // factory-valued P1 section must survive so it overrides the shared Y.
+    s.set("gamepad p1", "a", "x");
+    s.set("gamepad p2", "a", "rightshoulder");
+    s.set("gamepad p2", "coin", "leftstick");
+    Settings back;
+    back.read(s.write_over("; owner\n[gamepad]\na = y\n"), problems);
+    CHECK_EQ(problems.size(), 0);
+    CHECK_EQ(back.has_section("gamepad p1"), true);
+    CHECK_EQ(back.get("gamepad p1", "a") == "x", true);
+    CHECK_EQ(back.get("gamepad p2", "a") == "rightshoulder", true);
+    CHECK_EQ(back.get("gamepad p2", "coin") == "leftstick", true);
+    CHECK_EQ(back.get("gamepad", "a") == "y", true);
+}
