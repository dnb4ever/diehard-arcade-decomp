+TEST(hires_rbg_fractional_transform_and_window_keep_hardware_coordinates) {
+    red_screen(); two_plane_rbg0((511u << 16) | 0x8000, 0);
+    reg(0xC4, 2); reg(0xC6, 223); reg(0xD4, 2 << 8); // sprite only; RBG remains visible
+    for (int scale : {2, 3}) {
+        g_cfg.internal_resolution=scale;
+        Frame f;vdp2_compose(f);
+        CHECK_EQ(at(f,0,0),8u << 16);
+        CHECK_EQ(at(f,scale-1,0),16u << 16);
