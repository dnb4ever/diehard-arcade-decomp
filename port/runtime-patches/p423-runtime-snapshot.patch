+// RBG0 over two planes: rotation x 0..511 is plane slot 0 (red 8), 512..1023 slot 1 (red 16).
+// Both parameter sets get dYst = dX = A = E = 1 and the same plane map; mx_a / mx_b are Mx.
+void two_plane_rbg0(uint32_t mx_a, uint32_t mx_b) {
+    reg(0x20, 0x10);                             // BGON: RBG0
+    reg(0x38, 0x8000);                           // PNCR: one-word, 8x8, 16-colour names
+    reg(0xFC, 1);                                // PRIR: RBG0 priority 1
+    reg(0xBE, 0x4000);                           // rotation table at byte 0x8000
+    for (int set = 0; set < 2; ++set) {
+        uint32_t param = 0x8000 + set * 0x80;
+        auto fixed = [&](uint32_t off, uint32_t value) {
+            vram16(param + off, value >> 16);
+            vram16(param + off + 2, value);
+        };
+        fixed(0x10, 0x10000);                    // dYst
+        fixed(0x14, 0x10000);                    // dX
+        fixed(0x1C, 0x10000);                    // A
+        fixed(0x2C, 0x10000);                    // E
+        fixed(0x44, set ? mx_b : mx_a);          // Mx
+        fixed(0x58, 0x10000);                    // dKAst: one coefficient entry a line
+        for (int pair = 0; pair < 8; ++pair) reg(0x50 + set * 0x10 + pair * 2, 16 | 17 << 8);
+    }
+    for (int slot = 0; slot < 2; ++slot) {
+        uint32_t chr = 0x200 + slot;
+        std::memset(g_vdp2_vram + chr * 32, 0x11, 32);
+        for (uint32_t cell = 0; cell < 64; ++cell)    // the first cell row of the page
+            vram16(0x20000 + slot * 0x2000 + cell * 2, (slot << 12) | chr);
+        cram16(slot * 16 + 1, slot + 1);
+    }
+}
