+// P4.19: host-only mutable stereo timeline. Caller serializes producer/consumer.
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <deque>
+
+class NetAudio {
+    struct Sample { std::array<int16_t,2> source{}, output{}; uint64_t made=0; };
+    std::deque<Sample> data;
+    uint64_t base=0, read=0, end=0;
+    bool changed=false;
+    std::array<int16_t,2> tail{};
+    unsigned fade=132; // 3 ms at 44.1 kHz, shared by both channels
+public:
+    uint64_t age_sum=0, age_count=0, age_max=0;
+    uint64_t corrections=0, corrected=0, missed=0, seams=0, underruns=0;
+    int max_step=0;
+    std::array<int16_t,2> previous{};
+    bool have_previous=false;
+    void rollback() { changed=false; fade=132; if(!data.empty()) tail=data.back().output; }
+    void recovered() {}
+    uint64_t queued() const { return end>read ? end-read : 0; }
+    void submit(const int16_t* pcm, int frames, uint64_t last, uint64_t now_ns=0) {
+        uint64_t first=last-uint64_t(frames);
+        for(int i=0;i<frames;++i) {
+            uint64_t pos=first+uint64_t(i);
+            std::array<int16_t,2> now{pcm[i*2],pcm[i*2+1]};
+            if(pos<base) continue;
+            if(pos>=end) {
+                while(end<pos) { data.push_back({}); ++end; }
+                auto output=now;
+                if(changed && fade<132) {
+                    ++fade;
+                    for(int ch=0;ch<2;++ch) output[ch]=int16_t((int(tail[ch])*(132-int(fade))+int(now[ch])*int(fade))/132);
+                }
+                data.push_back({now,output,now_ns}); ++end;
+            } else {
+                auto& s=data[size_t(pos-base)];
+                if(s.source!=now) {
+                    if(!changed) { ++corrections; changed=true; fade=0; }
+                    if(pos<read) ++missed; else ++corrected;
+                }
+                if(pos>=read) {
+                    if(changed && fade<132) {
+                        ++fade;
+                        for(int ch=0;ch<2;++ch) s.output[ch]=int16_t((int(s.output[ch])*(132-int(fade))+int(now[ch])*int(fade))/132);
+                    } else s.output=now;
+                }
+                s.source=now;
+            }
+        }
+        // Retain already-submitted PCM only for comparing subsequent rollbacks.
+        while(read>base+44100 && !data.empty()) { data.pop_front(); ++base; }
+    }
+    void consume(int16_t* pcm, int frames, bool count_empty=true, uint64_t now_ns=0) {
+        bool empty=false;
+        for(int i=0;i<frames;++i) {
+            std::array<int16_t,2> s{};
+            if(read<end) {
+                auto& sample=data[size_t(read++-base)]; s=sample.output;
+                if(count_empty && sample.made && now_ns>=sample.made) {
+                    uint64_t age=now_ns-sample.made; age_sum+=age; ++age_count; age_max=std::max(age_max,age);
+                }
+            }
+            else empty=true; // silence does not advance the guest sample cursor
+            for(int ch=0;ch<2;++ch) {
+                pcm[2*i+ch]=s[ch];
+                if(have_previous) max_step=std::max(max_step,std::abs(int(s[ch])-int(previous[ch])));
+            }
+            // A conservative signal discontinuity counter, not a listening test.
+            if(have_previous && std::max(std::abs(int(s[0])-int(previous[0])),std::abs(int(s[1])-int(previous[1])))>16384) ++seams;
+            previous=s; have_previous=true;
+        }
+        if(empty && count_empty) ++underruns;
+    }
+};
