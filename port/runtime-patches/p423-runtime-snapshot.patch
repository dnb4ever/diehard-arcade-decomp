+// Called every frame (from stv_scene_probe_tick, which video.cpp's vblank_in runs every frame).
+// Advances the BIOS frame timer, as the real BIOS per-frame service does.
+static void stv_system_bios_tick() {
+    if (!stv_sysbios_on()) return;
+    g_stv_frametimer++;
+
+    // FAITHFUL SUB-FIX #1 (default, not a knob): the BIOS insert-coin / attract countdown timer.
+    // 0x06000654 low 7 bits are the BIOS coin/attract countdown; the real ST-V BIOS decrements this
+    // field every frame while attract is running. main_stv seeds the word as 0x037F (2P panel |
+    // credit-required | low7=0x7F). The credit-wait scene (func_0220600e scene_credit_join_sm, scene
+    // index 1) reads `timer = (u16)0x06000654 & 0x7F`: it displays the countdown digit while
+    // timer != 0x7F, and COMMITS the scene (-> attract_handler -> the attract demo reel) once
+    // timer == 0 (with entity+0x40 == 0). With the field left STATIC at 0x7F the credit-wait scene
+    // never commits and the attract reel never starts (scene 1 FREEZES). Decrementing the low 7 bits
+    // to 0 each frame is the real BIOS behaviour: scene 1 auto-advances into the attract demo reel
+    // (scene 1 -> 2 (demo) -> 3 (fade) -> ...). We hold at 0 once reached; the attract reel loops
+    // 2->..->73->..->2 (scene 0 selector -1 -> 2) and never re-enters scene 1, so no reload is needed.
+    // A coin is still genuinely required to ENTER PLAY (the credit-join path); only the attract reel
+    // now runs without one, exactly as a real cabinet. Preserves the high bits (0x100 credit-required,
+    // 0x200 2P panel) that scene_bootstrap / credit-wait also read. STV_NOSYSBIOS disables the whole
+    // layer (restores the static-idle behaviour for A/B).
+    static const bool countdown_en = (std::getenv("STV_ATTRACT_COUNTDOWN") != nullptr);
+    if (countdown_en) {
+        uint16_t pc = (uint16_t)ld16(0x06000654u);
+        uint16_t low7 = pc & 0x7Fu;
+        if (low7 != 0)
+            st16(0x06000654u, (uint16_t)((pc & 0xFF80u) | (low7 - 1)));
+    }
+}
+
+// STV_AUTOPLAY=VB (test harness, default off): from VBlank VB a scripted "player" drives the P1
+// panel whenever the --stvinput timeline holds no P1 control. It only READS game memory (the actor
+// slots the P41 trace prints) to choose physical inputs, exactly as a person watching the screen
+// would: walk toward the nearest live enemy, face it, alternate A/B; with no enemy, keep tapping
+// A/B (QTE prompts, cut-scene skips). When P1 has no game (P1 credit state byte 0x06098674 == 0,
+// the attract) or the CONTINUE? countdown is up (== 3) it inserts a coin and presses START, as a
+// player starting or continuing would. Nothing is written except BIOS input words and the
+// same COIN/START events the timeline uses.
+static uint64_t g_stv_last_continue;
+static void stv_autoplay(uint64_t vb, uint16_t& p1raw) {
+    static const char* env = std::getenv("STV_AUTOPLAY");
+    if (!env || vb < std::strtoull(env, nullptr, 10)) return;
+
+    uint32_t task = ld32(0x060995B4u), me = task ? ld32(task + 8) : 0;
+    uint16_t hp = me ? ld16(me + 0x56) : 0;
+    uint8_t p1state = (uint8_t)ld8(0x06098674u);
+    if ((p1state == 0 || p1state == 3) && vb - g_stv_last_continue > 600) {   // no game / CONTINUE?
+        g_stv_last_continue = vb;
+        g_stv_events.push_back({vb + 1, 3, false});      // COIN
+        g_stv_events.push_back({vb + 30, 1, false});     // START1
+        sat_note("AUTOPLAY VB %llu: %s, coin + START", (unsigned long long)vb,
+                 p1state ? "CONTINUE? shown" : "no game");
+    }
+    if (p1raw) return;                                   // the timeline has P1 this frame
+    if (!me || hp == 0) {                                // no live player: A to advance prompts
+        if (vb % 12 < 2) p1raw = 0x001;
+        return;
+    }
+    int32_t mx = (int32_t)ld32(me + 8), mz = (int32_t)ld32(me + 0x10);
+    int32_t bx = 0, bz = 0;
+    int64_t best = INT64_MAX;
+    for (unsigned slot = 3; slot <= 6; ++slot) {
+        uint32_t t = ld32(0x060995B0u + slot * 4), e = t ? ld32(t + 8) : 0;
+        if (!e || !ld16(e + 0x56)) continue;
+        int32_t dx = (int32_t)ld32(e + 8) - mx, dz = (int32_t)ld32(e + 0x10) - mz;
+        int64_t d = std::llabs((int64_t)dx) + std::llabs((int64_t)dz) * 2;
+        if (d < best) { best = d; bx = dx; bz = dz; }
+    }
+    unsigned phase = (unsigned)(vb % 24);
+    if (vb % 30 == 0)
+        sat_note("AUTOPLAY VB %llu: P1 %d,%d hp %u target %+d,%+d", (unsigned long long)vb,
+                 mx >> 12, mz >> 12, hp, best == INT64_MAX ? 0 : bx >> 12, best == INT64_MAX ? 0 : bz >> 12);
+    if (best == INT64_MAX) {                             // nothing to fight: tap A / B
+        p1raw = phase < 2 ? 0x001 : (phase >= 12 && phase < 14) ? 0x002 : 0;
+        return;
+    }
+    const int32_t px = 1 << 12;                           // world units: pixels << 12 (spawn X 160 = 0xA0000)
+    uint16_t toward_x = bx < 0 ? 0x200 : 0x100;          // LEFT walks -X, RIGHT walks +X
+    uint16_t toward_z = bz < 0 ? 0x040 : 0x080;          // DOWN walks -Z, UP walks +Z
+    bool far_x = std::abs(bx) > 34 * px, near_x = std::abs(bx) < 10 * px, off_z = std::abs(bz) > 6 * px;
+    if (far_x || off_z || near_x) {
+        if (far_x) p1raw |= toward_x;
+        else if (near_x) p1raw |= toward_x ^ 0x300;      // step back to striking distance
+        if (off_z) p1raw |= toward_z;
+        return;
+    }
+    if (phase < 2 || (phase >= 12 && phase < 14)) p1raw = toward_x;          // face it
+    else if (phase >= 4 && phase < 6) p1raw = 0x001;                          // A
+    else if (phase >= 16 && phase < 18) p1raw = 0x002;                        // B
+}
+
+// Fill the panel report at `buf` with the current control-panel state. Called from the
+// 0x06000660 service every frame. Writes a full zeroed report (so a one-frame press
+// pulse releases on the next frame -> a clean rising edge), then stamps any scripted
+// event active on this VBlank.
+// Scene-director probe driver (diagnostic, default off). Called EVERY frame from video.cpp's
+// vblank_in -- the ST-V panel service (stv_panel_read) is NOT scheduled once the game-enter
+// scenes run, so the scene walk must be driven from the always-on VBlank tick, not the panel
+// read. Purpose: LOCATE which setup scene (73-80) installs the player spawn-script. STV_SCENEJUMP
+// forces the hardcoded game scene 81 via the unk13<0 lever and SKIPS the setup scenes; these
+// knobs instead drop the scene-director onto / step it through a chosen scene index so each setup
+// scene's per-frame setup runs. The director reads the active scene from g_06098668 (index) +
+// g_0609866c (descriptor = 0x06072660 + idx*0x50) and, on each advance (director-entity->unk3c
+// bit0 set), runs the game-enter install block for idx>=76. All default-off => byte-identical.
+//   STV_SCENESEED="vb:idx"        ONCE at VB>=vb: g_06098668=idx, g_0609866c=desc(idx)
+//   STV_SCENEADV ="vb:count:intv" from VB>=vb, every intv frames, force 1 director advance, count times
+//   STV_SCENEPIN ="idx"           every frame: pin g_06098668=idx, g_0609866c=desc(idx)
+//   STV_SCENEJOIN="startvb"       from VB>=startvb: g_06098674=g_06098675=2 (scene-73 branch -> 74)
+//   STV_SCENECHAR="v"             every frame: g_0609856c=v (scene-75 branch -> 76 + (v&3))
+// Physical panel pins are scheduled at the host/raster boundary. The BIOS scans
+// them only when the guest calls service 0x610 (ROM 0x30114 -> 0x31498).
+static uint16_t g_stv_physical_raw[2], g_stv_physical_sys;
+static void stv_scan_inputs() {
+    for (unsigned p = 0; p < 2; ++p) {
+        uint32_t a = 0x06000708u + 8*p;
+        uint16_t prev = (uint16_t)ld16(a), now = g_stv_physical_raw[p];
+        st16(a, now); st16(a+2, prev);
+        st16(a+4, (uint16_t)(now & ~prev)); st16(a+6, (uint16_t)(prev & ~now));
+    }
+    uint16_t prev = (uint16_t)ld16(0x06000728u), now = g_stv_physical_sys;
+    st16(0x06000728u, now); st16(0x0600072Au, prev);
+    st16(0x0600072Cu, (uint16_t)(now & ~prev));
+    st16(0x0600072Eu, (uint16_t)(prev & ~now));
+    if (now & ~prev & 1) deliver_coin(0);
+    if (now & ~prev & 2) deliver_coin(1);
+}
+static bool s_playroute_fired = false;   // set once STV_PLAYROUTE seeds the director; read by STV_JOINHOLD
+void stv_scene_probe_tick(uint64_t vb) {
+    // Publish physical controls once per VBlank even if no panel service is called.
+    // Only BIOS raw input words are written; game actor/state globals are untouched.
+    uint16_t raw_controls[2] = {0, 0};
+    for (const StvEvent& event : g_stv_events)
+        if ((event.kind == 6 || event.kind == 7) && vb >= event.vb &&
+            vb - event.vb < event.duration)
+            raw_controls[event.kind - 6] |= event.raw;
+    // A player at the window (g_cfg.arcade): the host's panel, read at the last present, joins the
+    // timeline's presses; STV_AUTOPLAY then plays P1 only while the player leaves P1's controls alone.
+    uint16_t live_raw[2], live_sys;
+    host_stv_panel(live_raw, live_sys);
+    if (netplay_active() && !g_cfg.netplay_join.empty()) {
+        raw_controls[1] |= live_raw[0];
+        live_sys = uint16_t((live_sys & 0x11) << 1);
+    } else {
+        raw_controls[0] |= live_raw[0]; raw_controls[1] |= live_raw[1];
+    }
+    if (!netplay_active() && !player_movie_playing()) stv_autoplay(vb, raw_controls[0]);
+
+
+    // The BIOS system-switch record at 0x06000728 (fifth raw input record). The real BIOS
+    // (ROM 0x31764) packs ~PORTC every frame as COIN1 0x01, COIN2 0x02, TEST 0x04,
+    // SERVICE 0x08, START1 0x10, START2 0x20 (PAUSE 0x4000), with the previous value at +2,
+    // press edges at +4 and release edges at +6. func_0220f9d4 turns +0 into the cooked
+    // edge word 0x06098798 that the START, continue and TEST gates read.
+    uint16_t sys = 0;
+    for (StvEvent& event : g_stv_events) {
+        if (vb < event.vb || vb - event.vb >= event.duration) continue;
+        static const uint16_t kSysBit[] = {0, 0x10, 0x20, 0x01, 0x02, 0x08};
+        if (event.kind >= 1 && event.kind <= 5) sys |= kSysBit[event.kind];
+        if (event.kind == 9) sys |= 0x4000; // Cabinet pause switch.
+        if (event.kind == 8) sys |= 0x04; // Physical TEST switch (still exits to unimplemented BIOS menus).
+    }
+    sys |= live_sys;
+    if (netplay_active()) netplay_panel(vb, raw_controls, sys);
+    else player_input(vb, raw_controls, sys);
+    g_stv_physical_raw[0] = raw_controls[0];
+    g_stv_physical_raw[1] = raw_controls[1];
+    g_stv_physical_sys = sys;
+
+    // Read-only P4.1 diagnostics; print each VBlank, including empty player slots.
+    static const bool p41trace = std::getenv("STV_P41TRACE") != nullptr;
+    if (p41trace) {
+        sat_note("P41 VB=%llu scene=%u mode=%u arm=%u progress=%u join=%u/%u cw=%04X",
+                 (unsigned long long)vb, ld32(0x06098668u), ld16(0x0609979Au),
+                 ld32(0x06098670u), ld32(0x06098830u), ld8(0x06098674u),
+                 ld8(0x06098675u), ld16(0x06098798u));
+        uint32_t exec = ld32(0x06098678u), node = ld32(0x0609882Cu);
+        uint32_t ent = node ? ld32(node + 8) : 0;
+        sat_note("P41G VB=%llu gate=%u channels=%u exec=%08X node=%08X handler=%08X state=%u flags=%08X ae=%u timeline=%08X col=%u width=%u limit=%u",
+                 (unsigned long long)vb, ld8(0x0609868Eu), ld32(0x06098564u),
+                 exec ? ld32(exec) : 0, node, node ? ld32(node) : 0,
+                 node ? ld8(node + 0x10) : 0, ent ? ld32(ent + 0x3C) : 0,
+                 ent ? ld16(ent + 0xAE) : 0, ld32(0x060973F0u),
+                 ld32(0x060973E0u), ld32(0x060973E4u), ld32(0x060973E8u));
+        for (unsigned slot = 1; slot <= 6; ++slot) {
+            uint32_t task = ld32(0x060995B0u + slot * 4);
+            uint32_t ent = task ? ld32(task + 8) : 0;
+            sat_note("P41S VB=%llu slot=%u task=%08X ent=%08X id=%u hp=%u xyz=%08X/%08X/%08X",
+                     (unsigned long long)vb, slot, task, ent, ent ? ld8(ent + 0x34) : 0,
+                     ent ? ld16(ent + 0x56) : 0, ent ? ld32(ent + 8) : 0,
+                     ent ? ld32(ent + 0xC) : 0, ent ? ld32(ent + 0x10) : 0);
+        }
+    }
+
+    stv_system_bios_tick();            // FAITHFUL: re-publish the BIOS system control word every frame
+    // STV_DESCDUMP="vb" (diagnostic, default off; byte-identical when unset): one-shot dump of the
+    // scene descriptor table (base 0x06072660, stride 0x50) for scenes 0..89. For each scene prints
+    // desc+0x10 (the play-definition pointer scene_obj_handler case-0 dereferences) and, when that
+    // points into data RAM, the def's unk0 (step callback), unk4/unk8 (args), unkC (substate seed),
+    // unkE (countdown). Lets us find which scenes carry a genuine play-definition layout vs attract
+    // scene 3 (desc+0x10 = cart code 0x0600F1C0). Read-only.
+    if (const char* e_dd = std::getenv("STV_DESCDUMP")) {
+        static bool dd_done = false;
+        uint64_t dd_at = (uint64_t)std::strtoull(e_dd, nullptr, 0);
+        if (!dd_done && vb >= dd_at) {
+            dd_done = true;
+            sat_note("STV_DESCDUMP at VB %llu (desc base 0x06072660 stride 0x50)", (unsigned long long)vb);
+            for (uint32_t idx = 0; idx <= 89; idx++) {
+                uint32_t desc = 0x06072660u + idx * 0x50u;
+                uint32_t p10  = ld32(desc + 0x10u);    // play-def pointer
+                uint32_t p14  = ld32(desc + 0x14u);    // func_0220fece tail arg
+                uint32_t p1c  = ld32(desc + 0x1Cu);    // spawn-list ptr
+                uint8_t  s2b  = ld8(desc + 0x2Bu);     // selector cur[43]
+                bool pdata = (p10 >> 24) == 0x06 && (p10 & 0xF00000u) >= 0x900000u; // 0x0609xxxx/0x060Axxxx/...
+                // treat anything pointing above 0x06090000 as data RAM; below is code/const
+                bool isdata = p10 >= 0x06004000u && p10 < 0x06092000u;
+                uint32_t u0=0,u4=0,u8=0,u10v=0; uint16_t uC=0,uE=0;
+                if (isdata) { u0=ld32(p10+0u); u4=ld32(p10+4u); u8=ld32(p10+8u);
+                              uC=(uint16_t)ld16(p10+0xCu); uE=(uint16_t)ld16(p10+0xEu); u10v=ld32(p10+0x10u); }
+                bool u0_code = (u0 >= 0x06004000u && u0 < 0x0604A000u); // plausible cart-code step callback
+                (void)u10v;
+                // stage-config fields that scene81_stage_setup (func_02206e2e) reads from a node:
+                uint32_t s30 = ld32(desc + 0x30u);   // flags (bit0 = DMA gate)
+                uint32_t s34 = ld32(desc + 0x34u);   // 2nd-layer flags
+                uint32_t s38 = ld32(desc + 0x38u);   // layer select / tile base
+                uint16_t s3a = (uint16_t)ld16(desc + 0x3Au); // cell-column count
+                uint32_t s3c = ld32(desc + 0x3Cu);   // stage-asset bundle ptr
+                sat_note("  sc%2u +14=%08X +1C=%08X sel=%d +10=%08X def{u0=%08X%s} STG{30=%08X 34=%08X 38=%08X 3A=%04X 3C=%08X}",
+                         idx, p14, p1c, (int)(int8_t)s2b, p10,
+                         u0, u0_code?"*CODE":"     ", s30, s34, s38, s3a, s3c);
+                (void)pdata; (void)u4; (void)u8; (void)uC; (void)uE;
+            }
+            // Also dump the SPECIAL scene-81 descriptor (0x06073fb0, NOT in the stride-0x50 table)
+            // the director's timeout-jump installs; it carries the real first-stage config.
+            for (uint32_t d = 0x06073fb0u, k = 0; k < 2; d += 0x50u, k++) {
+                sat_note("  SPECIAL %08X +10=%08X +14=%08X STG{30=%08X 34=%08X 38=%08X 3A=%04X 3C=%08X}",
+                         d, ld32(d+0x10u), ld32(d+0x14u), ld32(d+0x30u), ld32(d+0x34u),
+                         ld32(d+0x38u), (uint16_t)ld16(d+0x3Au), ld32(d+0x3Cu));
+            }
+        }
+    }
+    // STV_MTXPEEK="startvb[:intv]" (diagnostic, default off; byte-identical when unset): dump the
+    // 3D model/view matrix state at vblank_in. Persistent slots (survive to end of frame): the
+    // default/view matrix template @0x0604ec64 (what load_matrix_default copies), the fwd/inv caches
+    // @0x06098aec/0x06098abc (mtx_build_fwd_inv output; mtx_load_abc loads the inv into actor draws),
+    // the active matrix-stack ptr @0x06098878 + the matrix it points at, the stack base @0x0609887c,
+    // the camera translation @0x06098b9c, the projection scratch @0x06098b1c, and the reversed
+    // model->screen matrix @0x060da040 (matrix_copy_reverse output, last model this frame). Read-only.
+    if (const char* e_mtx = std::getenv("STV_MTXPEEK")) {
+        static uint64_t mstart = 0; static uint64_t mintv = 100; static bool mp = false;
+        if (!mp) { mstart = strtoull(e_mtx,nullptr,0); const char* c = std::strchr(e_mtx,':');
+                   if (c) { mintv = strtoull(c+1,nullptr,0); if(!mintv) mintv=1; } mp = true; }
+        if (vb >= mstart && (vb % mintv) == 0) {
+            auto dmat = [&](const char* nm, uint32_t a, int n){
+                char line[256]; int o = std::snprintf(line,sizeof line,"  %s @%08X:",nm,a);
+                for (int i=0;i<n;i++) o += std::snprintf(line+o,sizeof(line)-o," %08X",(uint32_t)ld32(a+i*4));
+                sat_note("%s", line);
+            };
+            uint32_t sp = (uint32_t)ld32(0x06098878u);
+            sat_note("MTXPEEK VB %llu stackptr(0x6098878)=%08X scene=%u",
+                     (unsigned long long)vb, sp, (unsigned)ld32(0x06098668u));
+            dmat("default/view @ec64", 0x0604ec64u, 12);
+            dmat("fwd cache   aec",    0x06098aecu, 12);
+            dmat("inv cache   abc",    0x06098abcu, 12);
+            if (sp && (sp>>24)==0x06) dmat("active top  *sp", sp, 12);
+            dmat("stackbase   887c",   0x0609887cu, 12);
+            dmat("cam-trans   b9c",    0x06098b9cu, 3);
+            dmat("proj-scratch b1c",   0x06098b1cu, 3);
+            dmat("rev-out     da040",  0x060da040u, 15);
+        }
+    }
+    // STV_SCENETRACE (diagnostic, default off): log the director scene index 0x06098668, the 2P-arm
+    // flag 0x06098670, the credit byte 0x06098674 and the cooked ctrl word 0x06098798 whenever any of
+    // them changes. Read-only; used to watch the coin->director routing walk (scene 1 -> 2). No effect
+    // when unset (byte-identical).
+    if (std::getenv("STV_SCENETRACE")) {
+        static uint32_t p_scene = 0xFFFFFFFFu, p_arm = 0xFFFFFFFFu; static uint8_t p_cr = 0xFF; static uint16_t p_cw = 0xFFFF;
+        static uint8_t p_gate = 0xFF; static uint16_t p_cp = 0xFFFF, p_cready = 0xFFFF;
+        uint32_t scene = ld32(0x06098668u), arm = ld32(0x06098670u);
+        uint8_t  cr = (uint8_t)ld8(0x06098674u); uint16_t cw = (uint16_t)ld16(0x06098798u);
+        uint8_t  gate = (uint8_t)ld8(0x0609868Eu);          // join-spawn gate = scene desc[+42]
+        uint16_t cp = (uint16_t)ld16(0x0609880Cu);          // P1 coin-pending
+        uint16_t cready = (uint16_t)ld16(0x0609880Eu);      // P1 coin-ready (fade-armed companion)
+        if (scene != p_scene || arm != p_arm || cr != p_cr || cw != p_cw ||
+            gate != p_gate || cp != p_cp || cready != p_cready) {
+            sat_note("SCENETRACE VB %llu scene=%u arm(0x670)=%u credit(0x674)=%u ctrl(0x798)=%04X gate(0x86e)=%u cpend(0x80c)=%u cready(0x80e)=%u",
+                     (unsigned long long)vb, scene, arm, cr, cw, gate, cp, cready);
+            p_scene = scene; p_arm = arm; p_cr = cr; p_cw = cw; p_gate = gate; p_cp = cp; p_cready = cready;
+        }
+    }
+    // STV_JOINTEST ("vb", default off): LABELED test that reproduces the exact FAITHFUL condition
+    // for the credit-join COORDINATOR to spawn -- a fresh coin accepted while the scene director is
+    // on a gate=1 (attract fade) scene. TRACED FACT: player_join_spawn (cart 0x02228168) is called
+    // by attract_credit_join_service (cart 0x022045f8) ONLY when join byte 0x06098674==1 AND the
+    // per-scene gate g_0609868E (= current scene descriptor byte +42) == 1; +42==1 only on the
+    // attract fade scenes 3/5/7/9 (off14 0x02232610). On every boot path the credit byte is consumed
+    // to 2 on a gate=0 scene (credit-wait scene 1 / demo stage scene 2 / demo auto-credit @VB200)
+    // BEFORE any fade scene is reached, so the coordinator never spawns. This one-shot, ONCE at
+    // VB>=vb when gate(0x86E)==1, clears the (demo-)join byte back to 0 and delivers a coin via the
+    // real coin-detect substitute (deliver_coin) so the game\'s OWN f_22045f8 accepts it on the fade
+    // scene -> byte 0->1 with gate==1 -> player_join_spawn -> func_02229c00 raises 0x06098688 via
+    // REAL cart code (NO STV_STARTFLAG). FORCED only in the INPUT (byte reset + synthetic coin on a
+    // fade scene = what a real coin would produce if timed to a fade); the downstream chain is real.
+    // Default off => byte-identical.
+    static const char* e_jointest = std::getenv("STV_JOINTEST");
+    if (e_jointest) {
+        static bool jt_done = false;
+        uint64_t jt_vb = (uint64_t)std::strtoull(e_jointest, nullptr, 10);
+        if (!jt_done && vb >= jt_vb) {
