+// Sample each of A..P independently for both rotation parameter sets. The normal
+// screen map registers deliberately contain different addresses: they must not
+// leak into the rotation maps.
+TEST(rotation_maps_use_the_complete_parameter_a_and_b_register_banks) {
+    for (int bank = 0; bank < 2; ++bank) {
+        red_screen();
+        reg(0x20, bank ? 0x20 : 0x10);
+        reg(bank ? 0x30 : 0x38, 0x8000); // one-word, 8x8, 16-colour names
+        reg(bank ? 0xF8 : 0xFC, 1);
+        reg(0xBE, 0x4000);             // rotation table at byte 0x8000
+        uint32_t param = 0x8000 + bank * 0x80;
+        auto fixed = [&](uint32_t off, uint32_t value) {
+            vram16(param + off, value >> 16);
+            vram16(param + off + 2, value);
+        };
+        fixed(0x10, 0x10000);          // dYst
+        fixed(0x14, 0x10000);          // dX
+        fixed(0x1C, 0x10000);          // A
+        fixed(0x2C, 0x10000);          // E
+        for (int slot = 0; slot < 16; ++slot) {
+            uint32_t plane = 0x20000 + slot * 0x2000;
+            uint32_t chr = 0x200 + slot;
+            std::memset(g_vdp2_vram + chr * 32, 0x11, 32);
+            // Palette is selected in the pattern name, making every slot unique.
+            vram16(plane, ((slot & 15) << 12) | (chr & 0x3FF));
+            cram16(slot * 16 + 1, slot + 1);
+        }
+        for (int pair = 0; pair < 8; ++pair)
+            reg((bank ? 0x60 : 0x50) + pair * 2,
+                (16 + pair * 2) | ((17 + pair * 2) << 8));
+        for (int slot = 0; slot < 16; ++slot) {
+            fixed(0x44, (slot % 4) * 512u * 65536u); // Mx
+            fixed(0x48, (slot / 4) * 512u * 65536u); // My
+            Frame f;
+            vdp2_compose(f);
+            CHECK_EQ(at(f, 0, 0), (((slot + 1) << 3) | ((slot + 1) >> 2)) << 16);
+        }
+    }
+}
