+TEST(rgb555_palette_and_direct_bitmap_use_the_same_full_range) {
+    red_screen();
+    green_bitmap_nbg0();
+    reg(0x20, 0x0101);
+    for (unsigned x = 0; x < 32; ++x) {
+        g_vdp2_vram[x] = x;
+        cram16(x, x | x << 5 | x << 10);
+    }
+    Frame f;
+    vdp2_compose(f);
+    for (unsigned x = 0; x < 32; ++x) {
+        unsigned c = (x << 3) | (x >> 2);
+        CHECK_EQ(at(f, x, 0), c * 0x010101);
+    }
+    reg(0x28, 0x0032);
+    for (unsigned x = 0; x < 32; ++x) vram16(x * 2, 0x8000 | x | x << 5 | x << 10);
+    vdp2_compose(f);
+    for (unsigned x = 0; x < 32; ++x) {
+        unsigned c = (x << 3) | (x >> 2);
+        CHECK_EQ(at(f, x, 0), c * 0x010101);
+    }
+}
