+                uint32_t off; std::memcpy(&off, d.bytes.data()+at, 4); at += 4;
+                size_t n = std::min(size_t(256), g_rewind_image.size()-off);
+                for (size_t k = 0; k < n; ++k) g_rewind_image[off+k] ^= d.bytes[at+k];
+                at += n;
+            }
