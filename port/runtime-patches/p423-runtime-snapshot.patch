+// --stats: every g_cfg.stats seconds of the host's time, how fast the run went and how full the audio
+// stream was, sampled at each present.
+static void stats_tick() {
+    static Clock::time_point since = Clock::now();
+    static uint64_t from = sat_vblanks();
+    static int least = 1 << 30, most = 0, skipped_from = 0;
+    static unsigned generation;
+    if (generation != g_stats_generation) {
+        generation = g_stats_generation; since = Clock::now(); from = sat_vblanks();
+        least = 1 << 30; most = 0; skipped_from = g_skipped;
+    }
+    if (g_audio) {
+        int queued = SDL_GetAudioStreamQueued(g_audio) / 4;
+        least = std::min(least, queued);
+        most = std::max(most, queued);
+    }
+    double s = std::chrono::duration<double>(Clock::now() - since).count();
+    if (s < g_cfg.stats) return;
+    sat_note("host: %.2f VBlanks/s over %.1f s (VB %llu), %d pictures left out; audio queued %d..%d ms, %d times empty, %d chunks dropped, %d resyncs",
+             (double)(sat_vblanks() - from) / s, s, (unsigned long long)sat_vblanks(), g_skipped - skipped_from,
+             g_audio ? least * 1000 / 44100 : 0, g_audio ? most * 1000 / 44100 : 0, g_underruns, g_dropped, g_resyncs);
+    if (g_cfg.internal_resolution > 1)
+        sat_note("video: %llu exact enhanced fields reused, %llu composed",
+            (unsigned long long)vdp2_cache_hits(),(unsigned long long)vdp2_cache_misses());
+    since = Clock::now();
+    from = sat_vblanks();
+    skipped_from = g_skipped;
+    least = 1 << 30;
+    most = 0;
+}
