+void netplay_restored() { restoring=false; load_ms+=std::chrono::duration<double,std::milli>(Clock::now()-load_start).count(); }
+bool netplay_audio(const int16_t* samples, int frames, uint64_t end) {
+    if(!running) return false;
+    if(!g_cfg.netplay_glitch_free) host_net_audio(samples,frames,end);
