+// SDLRenderer3 clips in logical units when SDL supplies the framebuffer scale.
+// Apply that same scale to geometry, then preserve the caller's renderer state.
+#pragma once
+#include <SDL3/SDL.h>
+#include "imgui.h"
+#include "imgui_impl_sdlrenderer3.h"
+
+inline void render_imgui_scaled(ImDrawData* data, SDL_Renderer* renderer) {
+    float old_x = 1.0f, old_y = 1.0f;
+    SDL_GetRenderScale(renderer, &old_x, &old_y);
+    const bool change = old_x != data->FramebufferScale.x || old_y != data->FramebufferScale.y;
+    if (change) SDL_SetRenderScale(renderer, data->FramebufferScale.x, data->FramebufferScale.y);
+    ImGui_ImplSDLRenderer3_RenderDrawData(data, renderer);
+    if (change) SDL_SetRenderScale(renderer, old_x, old_y);
+}
