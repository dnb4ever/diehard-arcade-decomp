+TEST(hires_fractional_nbg_sampling_does_not_accumulate_thirds) {
+    line_bitmap(0);
+    reg(0x78, 3); // three source dots per hardware dot
+    for (int scale : {2, 3}) {
+        g_cfg.internal_resolution = scale;
+        Frame f; vdp2_compose(f);
+        CHECK_EQ(f.w, 320 * scale); CHECK_EQ(f.h, 224 * scale);
+        for (int x=0;x<300*scale;x++) {
+            unsigned cell = ((x * 3 / scale) % 512) / 8;
+            unsigned c = cell % 31 + 1; c = (c << 3) | (c >> 2);
+            CHECK_EQ(at(f,x,0),c * 0x010101);
+        }
+    }
+    g_cfg.internal_resolution=1;
+}
