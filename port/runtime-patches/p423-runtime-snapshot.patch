+            for (size_t k = 0; k < len; ++k) d.bytes[start+4+k] = bytes[off+k] ^ g_rewind_image[off+k];
+        }
+        g_rewind_bytes += d.bytes.capacity(); g_rewind.push_back(std::move(d));
