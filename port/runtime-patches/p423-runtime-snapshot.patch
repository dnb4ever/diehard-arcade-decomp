+        g_rewind_tested = true; g_rewind_steps = (g_cfg.rewind_frames+1)/2;
+    }
+    if (sat_vblanks() != g_rewind_seen && sat_vblanks()%2 == 0) {
+    auto start = std::chrono::steady_clock::now();
+    static std::vector<uint8_t> bytes;
+    quick_payload(bytes);
