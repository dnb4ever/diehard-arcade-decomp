+    vdp1_fb_write(0,0x83e0,2);vdp1_vblank_out();vdp2_compose(f);
+    CHECK_EQ(at(f,0,0),kGreen);CHECK_EQ(vdp2_cache_misses(),misses+1);
+    State saved;vdp1_state(saved);
+    vdp1_reg_write(0,1,2);vdp2_compose(f);
+    CHECK_EQ(vdp2_cache_misses(),misses+2);
+    saved.loading=true;vdp1_state(saved);vdp2_compose(f);
+    CHECK_EQ(at(f,0,0),kGreen);CHECK_EQ(vdp2_cache_misses(),misses+3);
+    // Disable interpolation caching even when the same hardware state is retained.
+    g_cfg.interp=true;auto hits=vdp2_cache_hits();vdp2_compose(f);vdp2_compose(f);
+    CHECK_EQ(vdp2_cache_hits(),hits);g_cfg.interp=false;
