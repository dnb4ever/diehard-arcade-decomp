+static void stv_panel_read(uint32_t buf) {
+    if (!buf) return;
+    // The BIOS copies its 20-byte panel report (0x06000740, built by ROM 0x308FE) into the
+    // caller's buffer. Layout for a 2-player cabinet with a common coin chute (factory
+    // default): [0] credits, [1] coins toward the next credit, [2] credits per start (1),
+    // [3]/[7] P1/P2 start code (2 = enough credit to start, 1 = more coins needed,
+    // 0 = none), [0x10] cabinet flags (2 players, coin play), [0x11] 0x11.
+    for (uint32_t i = 0; i < 0x14; ++i) st8(buf + i, 0);
+    uint8_t start_code = stv_free_play() || g_stv_credits > 0 ? 2 : 0;
+    st8(buf + 0x00, (uint8_t)g_stv_credits);
+    st8(buf + 0x02, 1);
+    st8(buf + 0x03, start_code);
+    st8(buf + 0x07, start_code);
+    st8(buf + 0x10, stv_free_play() ? 0x09 : 0x08);
+    st8(buf + 0x11, 0x11);
+    uint64_t vb = sat_vblanks();
+
+    // STV_SCENEJUMP (diagnostic, default off): the FAITHFUL scene-director game trigger. The boot/
+    // scene-director task (*0x060987B8) picks the active scene in scene_director_build (cart
+    // 0x02205b20); when its task->unk13 (byte at +0xd) is negative it forces g_06098668=81 and
+    // g_0609866c=0x06073fb0 (the GAME scene descriptor, table base 0x06072660 + 81*0x50) at the
+    // NEXT natural scene advance, running the scene-81 setup (off14=0x0600a876) that is supposed to
+    // install the game spawn-script (-> player actor 0x0602Dxxx -> start-flag 0x06098688 -> morph).
+    // This sets that exact field once at VB=STV_SCENEJUMP -- the real round-start lever into the
+    // scene director -- NOT a force-write of 0x06098688. Default off => byte-identical baseline.
+    static const char* scenejump = std::getenv("STV_SCENEJUMP");
+    if (scenejump) {
+        static bool sj_done = false;
+        static uint64_t sj_at = (uint64_t)std::strtoull(scenejump, nullptr, 10);
+        if (!sj_done && vb >= sj_at) {
+            uint32_t task = ld32(0x060987B8u);
+            if (task) {
+                uint8_t cur = (uint8_t)(ld16(task + 0x0Cu) & 0xFF); // byte at task+0xd (BE low half)
+                st8(task + 0x0Du, (uint8_t)(cur | 0x80u));
+                sj_done = true;
+                sat_note("STV_SCENEJUMP: scene-director task(*060987B8=%08X)->unk13 |= 0x80 at VB %llu",
+                         task, (unsigned long long)vb);
+            }
+        }
+    }
+
+    // STV_ATTRACTARM (diagnostic, default off): root-cause test for the attract-reel PARK at scene 3.
+    // The attract fade/transition scenes (off14 0x06036610 = f_232610, scenes 3,5,7,9,15,...) advance
+    // only when their content task reaches its completion state, which requires the transition-timeline
+    // interpreter f_2463c8 (cart 0x243628, rt 0x0604a3c8) to run to end-of-script and set the content
+    // entity unk3c bit3. That interpreter early-returns (switch on 0x06098564: case 0) unless
+    // 0x06098564 != 0, which f_22a8d8 (cart 0x22a8d8) only sets when the "2 players armed" flag
+    // 0x06098670 == 0 (pure attract, both channels). Under the harness 0x06098670 is left = 1 (set
+    // once at VB201 by f_201cae, guarded by 0x06000798 bit5 / 0x0609880c==1), so the timeline never
+    // advances and the reel stalls at scene 3. Semantically 0x06098670 should be 0 during attract
+    // (no players). This holds it 0 so the real completion path runs. NOT a force of the completion
+    // bit (director unk3c bit0) -- it only restores the attract arm-flag the real path reads.
+    // SUPERSEDED (2026-10-20, coin_arm_and_reel.md): the coin-path permanent park is now fixed
+    // faithfully in deliver_coin (the real coin-detect credit-byte gate), so this force is no
+    // longer needed for the coin path. Kept default-off for the completion-mechanism diagnostic.
+    static const char* attractarm = std::getenv("STV_ATTRACTARM");
+    if (attractarm) {
+        st32(0x06098670u, 0);
+    }
+
+    // STV_STARTFLAG (diagnostic, default off): the old pre-coin behaviour -- raise the player
+    // start-present flag 0x06098688/89 directly, which drives the game out of the attract freeze
+    // into the start/continue sequence WITHOUT a credit (reaches the demo continue flow, not a
+    // paid round). Kept for comparison; see notes/port/stv_input_gameplay_status.md. The faithful
+    // path leaves this off: START is a panel action and only begins a game when a credit exists.
+    static const char* startflag = std::getenv("STV_STARTFLAG");
+    // STV_PANELBTN (experimental, default off): inject face/direction tokens as the ONE cooked
+    // input bit that is verified decodable here -- bit0 of the cooked "a-control-is-pressed" word
+    // 0x0609879A (= MU16(g_06098794,6)), read as "&3 => pressed" by e.g. func_0201f20 state 1 and
+    // the scene-skip handlers. This lets a --stvinput timeline satisfy "press to continue/skip"
+    // gates. It writes the cooked word directly (bypassing the game's panel decoder) because the
+    // full panel-buffer direction/button bit map is NOT resolved -- see the notes file. Default off
+    // so the baseline is byte-identical. The per-button/direction identity is intentionally NOT
+    // faked: every face/dir token collapses to the same verified "pressed" bit.
+    static const char* panelbtn = std::getenv("STV_PANELBTN");
+    // START events are delivered as the real control-panel action code (buf[3]/buf[7]=2). The
+    // coin-wait handler @0x060089b8 latches buf[3] into 0x0609868C and dispatches 0x06090304[buf3].
+    // Each press is held for a 2-VBlank window so exactly one alternate-frame handler read sees a
+    // clean edge. NOTE (traced this session): the start-present flag 0x06098688 is NOT set by any
+    // panel consumer -- it is set by a player-character actor FSM (cart 0x2229cac / runtime
+    // 0x0602DCAC: 0x06098688[entity[0x34]-1]=1), which only runs once a player actor is spawned. So
+    // a panel START cannot raise it without the round's actor-spawn path (the STV_STARTFLAG diag
+    // forces it directly as a stand-in). See notes/port/stv_panel_input_status.md.
+    for (StvEvent& e : g_stv_events) {
+        bool held = vb >= e.vb && vb < e.vb + 2;
+        if (held) {
+            if (panelbtn && (e.kind == 6 || e.kind == 7))
+                st16(0x0609879Au, (uint16_t)(ld16(0x0609879Au) | 1));  // verified cooked "pressed" bit
+        }
+        if (held && !e.fired) {
+            e.fired = true;
+            if (e.kind == 5)                          // SERVICE: expressible; 0x688 svc is inert here
+                sat_note("ST-V panel: SERVICE at VB %llu (expressed; BIOS 0x688 service inert)",
+                         (unsigned long long)vb);
+            else if (e.kind == 6 || e.kind == 7)
+                sat_note("ST-V panel: P%d raw control %04X at VB %llu for %llu VBlanks", e.kind - 5,
+                         e.raw, (unsigned long long)vb, (unsigned long long)e.duration);
+            else if (startflag) {
+                if (e.kind == 1) st8(0x06098688u, 1);      // DIAG: P1 start-present flag (no-credit path)
+                else if (e.kind == 2) st8(0x06098689u, 1); // DIAG: P2 start-present flag
+                sat_note("ST-V panel: START kind %d via start-present flag (diag) at VB %llu",
+                         e.kind, (unsigned long long)vb);
+            } else {
+                sat_note("ST-V panel: START kind %d (system switch START%d) at VB %llu",
+                         e.kind, e.kind, (unsigned long long)vb);
+            }
+        }
+    }
+}
