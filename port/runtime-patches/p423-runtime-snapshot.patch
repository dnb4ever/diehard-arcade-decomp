+TEST(rotation_mode_2_draws_parameter_b_where_the_coefficient_msb_is_set) {
+    red_screen();
+    two_plane_rbg0(0, 512u << 16);
+    reg(0xB0, 2);                                // RPMD: A, switching to B by coefficient MSB
+    reg(0xB4, 0x0001);                           // KTCTL: parameter A table, 2-word, mode 0
+    reg(0xB6, 0x0001);                           // KTAOF: table at 0x40000
+    vram16(0x40000, 0x8000);                     // line 0: MSB set -> parameter B
+    vram16(0x40004, 0x0001);                     // line 1: coefficient 1.0 -> parameter A
+    vram16(0x40006, 0x0000);
+    Frame f;
+    vdp2_compose(f);
+    CHECK_EQ(at(f, 0, 0), 16u << 16);
+    CHECK_EQ(at(f, 0, 1), 8u << 16);
+}
