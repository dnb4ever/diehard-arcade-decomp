+// Presentation-only RGB aperture mask and short horizontal beam footprint.
+// Double the texture's lines so a scanline has a dark lower half even at 1x.
+// The original composed frame remains untouched (headless/reference shots, F12).
+static std::vector<uint32_t> g_crt_pixels;
+static void crt_pixels(const Frame& f) {
+    int resolution = std::clamp(g_cfg.internal_resolution, 1, 3);
+    g_crt_pixels.resize((size_t)f.w * f.h * 2);
+    for (int y = 0; y < f.h; ++y) for (int x = 0; x < f.w; ++x) {
+        uint32_t left = f.px[(size_t)y*f.w + std::max(0, x-resolution)];
+        uint32_t centre = f.px[(size_t)y*f.w + x];
+        uint32_t right = f.px[(size_t)y*f.w + std::min(f.w-1, x+resolution)];
+        uint32_t bright = 0, dark = 0;
+        for (int channel = 0; channel < 3; ++channel) {
+            int shift = channel * 8;
+            unsigned value = (((left >> shift) & 255) + 6*((centre >> shift) & 255) + ((right >> shift) & 255)) / 8;
+            // 12% attenuation of the other two phosphors, RGB repeating.
+            if (2-channel != (x/resolution)%3) value = value * 225 / 256;
+            bright |= value << shift;
+            dark |= (value * 184 / 256) << shift;
+        }
+        g_crt_pixels[(size_t)(2*y)*f.w + x] = ((2*y/resolution)&1) ? dark : bright;
+        g_crt_pixels[(size_t)(2*y+1)*f.w + x] = (((2*y+1)/resolution)&1) ? dark : bright;
+    }
