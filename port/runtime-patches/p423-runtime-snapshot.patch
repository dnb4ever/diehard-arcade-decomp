+TEST(hires_exact_frame_cache_tracks_memory_cpu_writes_and_restore) {
+    g_cfg.internal_resolution=1;
+    vdp1_reg_write(0,0,2);vdp1_reg_write(2,0,2);vdp1_reg_write(4,0,2);
+    red_screen();show_sprites();green_bitmap_nbg0();
+    g_cfg.internal_resolution=2;
+    Frame first;vdp2_compose(first);
+    uint64_t hits=vdp2_cache_hits(),misses=vdp2_cache_misses();
+    first.px[0]=0; // callers may edit their output; the cache owns a separate image
+    Frame second;vdp2_compose(second);
+    CHECK_EQ(vdp2_cache_hits(),hits+1);CHECK_EQ(at(second,0,0),kGreen);
+    // Raster counters do not participate in composition, so changing them is safe.
+    reg(0x04,0xffff);reg(0x08,123);reg(0x0a,234);vdp2_compose(second);
+    CHECK_EQ(vdp2_cache_hits(),hits+2);
+    cram16(1,0x7c00);vdp2_compose(second);CHECK_EQ(at(second,0,0),kBlue);
+    CHECK_EQ(vdp2_cache_misses(),misses+1);
+    g_vdp2_vram[5]=0;vdp2_compose(second);CHECK_EQ(at(second,10,0),kRed);
+    reg(0xc4,38);reg(0xc6,223);reg(0xd0,2);vdp2_compose(second);
+    CHECK_EQ(at(second,20,0),kRed);CHECK_EQ(at(second,40,0),kBlue);
+    reg(0xe0,0x20);reg(0xf0,7);
+    State saved;vdp1_state(saved);
+    vdp1_fb_write(30*2,0x83e0,2);vdp1_vblank_out();vdp2_compose(second);
+    CHECK_EQ(at(second,60,0),kGreen);
+    saved.loading=true;vdp1_state(saved);vdp2_compose(second);
+    CHECK_EQ(at(second,60,0),kBlue);
+    g_cfg.internal_resolution=1;
+    hits=vdp2_cache_hits();vdp2_compose(first);vdp2_compose(second);
+    CHECK_EQ(vdp2_cache_hits(),hits+1); // exact reuse also applies at original resolution
+}
