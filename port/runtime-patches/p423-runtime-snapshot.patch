+void word(int a, uint16_t w) { g_vdp1_vram[a] = w >> 8; g_vdp1_vram[a+1] = w; }
+void cmd(int a, int kind, int mode, int color, int x, int y, int x1, int y1) {
+    for (int i=0;i<32;i++) g_vdp1_vram[a+i]=0;
+    word(a,kind);word(a+4,mode);word(a+6,color);
+    word(a+12,x);word(a+14,y);word(a+16,x1);word(a+18,y);
