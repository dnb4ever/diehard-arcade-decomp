+TEST(hires_composition_keeps_priorities_windows_calculation_and_shadow_meanings) {
+    for(int fixture=0;fixture<8;++fixture) {
+        g_cfg.internal_resolution=1;
+        switch(fixture) {
+        case 0:red_screen();green_bitmap_nbg0();reg(0xC4,38);reg(0xC6,223);reg(0xD0,2);break;
+        case 1:line_colour_over_green();reg(0xE8,1);break;
+        case 2:green_over_blue_then_black();reg(0xEC,2);break;
+        case 3:sprites_over_green();reg(0xE2,1);show_sprites(0x7fe,10,19);break;
+        case 4:sprites_over_green();cram16(2,0x7c00);show_sprites(0x8002,10,19);break;
+        case 5:red_screen();two_plane_rbg0(508u<<16,0);reg(0x00,0x8003);break;
+        case 6:line_colour_over_green();reg(0xEA,1);reg(0xEE,1);break;
+        case 7:green_over_blue_then_black();reg(0xEC,0xa002);break;
+        }
+        Frame original;vdp2_compose(original);
+        for(int scale : {2,3}) {
+            g_cfg.internal_resolution=scale;
+            Frame enhanced;vdp2_compose(enhanced);
+            for(int y=0;y<original.h;y+=17) for(int x=0;x<original.w;++x)
+                CHECK_EQ(at(enhanced,x*scale,y*scale),at(original,x,y));
+        }
+    }
+    g_cfg.internal_resolution=1;
+}
