+// MAME 0.285 fixtures: full-range RGB555 and compact horizontal/vertical/zoom records.
+TEST(rgb555_back_screen_expands_all_32_levels) {
+    red_screen();
+    reg(0xAC, 0x8002);
+    for (unsigned y = 0; y < 32; ++y) vram16(0x40000 + y * 2, y | y << 5 | y << 10);
+    Frame f;
+    vdp2_compose(f);
+    for (unsigned y = 0; y < 32; ++y) {
+        unsigned c = (y << 3) | (y >> 2);
+        CHECK_EQ(at(f, 0, y), c * 0x010101);
+    }
+}
