+TEST(rotation_screen_steps_half_a_dot_in_high_resolution) {
+    red_screen();
+    reg(0x00, 0x8003);                           // TVMD: display on, 704 dots
+    two_plane_rbg0(508u << 16, 0);               // rotation dot 4 is the first of slot 1
+    Frame f;
+    vdp2_compose(f);
+    CHECK_EQ(f.w, 704);
+    CHECK_EQ(at(f, 7, 0), 8u << 16);
+    CHECK_EQ(at(f, 8, 0), 16u << 16);
+}
