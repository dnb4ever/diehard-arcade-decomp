+static void deliver_coin(int player) {
+    if (stv_free_play()) return;
+    g_stv_credits++;
+    sat_note("ST-V coin: COIN%d -> BIOS credits=%d at VB %llu", player + 1, g_stv_credits,
+             (unsigned long long)sat_vblanks());
