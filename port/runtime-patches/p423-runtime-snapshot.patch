+                    : b == "UP" ? 0x80 : b == "DOWN" ? 0x40
+                    : b == "LEFT" ? 0x200 : b == "RIGHT" ? 0x100 : 0;
+            }
+        }
+        if (kind) g_stv_events.push_back({vb, kind, false, raw, duration});
